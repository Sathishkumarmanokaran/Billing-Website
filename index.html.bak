<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Vyaparify Pro - Business Management & POS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-light: #eef2ff;
      --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --slate-900: #0f172a;
      --emerald: #10b981;
      --emerald-hover: #059669;
      --emerald-light: #ecfdf5;
      --emerald-gradient: linear-gradient(135deg, #059669 0%, #10b981 100%);
      --amber: #f59e0b;
      --amber-light: #fffbeb;
      --red: #ef4444;
      --red-light: #fef2f2;
      --card-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
      --card-shadow-hover: 0 12px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.04);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #f1f5f9;
      color: var(--slate-900);
      min-height: 100vh;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    
    h1, h2, h3, h4, .brand-title, .stat-val {
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      letter-spacing: -0.02em;
    }

    /* Custom Smooth Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--slate-300); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--slate-400); }

    .app-container { display: flex; min-height: 100vh; position: relative; }
    
    /* Modern Sidebar */
    aside {
      width: 260px;
      background: linear-gradient(180deg, #0f172a 0%, #090d16 100%);
      color: var(--slate-300);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 100;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    }
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      width: 100%;
      background: #f8fafc;
    }

    .brand-box {
      padding: 18px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .brand-info { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-logo {
      background: var(--primary-gradient);
      color: #fff;
      font-weight: 800;
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 14px;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
    }
    .brand-title {
      font-weight: 800;
      color: #fff;
      font-size: 16px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .mobile-menu-toggle {
      display: none;
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      padding: 6px;
      border-radius: 8px;
    }

    nav { padding: 14px 10px; display: flex; flex-direction: column; gap: 4px; flex: 1; overflow-y: auto; }
    .nav-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      border: none;
      background: none;
      color: var(--slate-400);
      padding: 11px 14px;
      border-radius: var(--radius-md);
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
    }
    .nav-btn:hover { background-color: rgba(255, 255, 255, 0.06); color: #fff; transform: translateX(2px); }
    .nav-btn.active {
      background: var(--primary-gradient);
      color: #fff;
      box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3);
    }

    /* Polished Header */
    header {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      height: 64px;
      border-bottom: 1px solid var(--slate-200);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 40;
    }
    main {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
    }

    /* Elevated Modern Cards */
    .card {
      background: #ffffff;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--card-shadow);
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .card:hover {
      box-shadow: var(--card-shadow-hover);
    }

    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }

    .stat-label { font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--slate-500); letter-spacing: 0.04em; display: block; line-height: 1.35; }
    .stat-val { font-size: 26px; font-weight: 800; margin-top: 4px; line-height: 1.1; word-break: break-all; }
    .show-on-mobile { display: none !important; }

    /* Button System with Micro-interactions */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: var(--radius-md);
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.18s ease;
      text-decoration: none;
      white-space: nowrap;
      user-select: none;
    }
    .btn:active { transform: scale(0.98); }
    .btn-primary {
      background: var(--primary-gradient);
      color: #fff;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }
    .btn-primary:hover {
      box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);
      filter: brightness(1.05);
    }
    .btn-emerald {
      background: var(--emerald-gradient);
      color: #fff;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }
    .btn-emerald:hover { filter: brightness(1.05); }
    .btn-light {
      background: var(--slate-100);
      color: var(--slate-700);
      border-color: var(--slate-200);
    }
    .btn-light:hover { background: var(--slate-200); color: var(--slate-900); }
    .btn-danger {
      background: var(--red-light);
      color: var(--red);
      border-color: #fecaca;
    }
    .btn-danger:hover { background: #fee2e2; }

    /* Polished Table System */
    .table-container {
      width: 100%;
      overflow-x: auto;
      background: #ffffff;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      box-shadow: var(--card-shadow);
      -webkit-overflow-scrolling: touch;
    }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; min-width: 650px; }
    th {
      background: var(--slate-50);
      padding: 14px 16px;
      border-bottom: 1px solid var(--slate-200);
      color: var(--slate-600);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 0.05em;
    }
    th.sortable { cursor: pointer; user-select: none; }
    th.sortable:hover { color: var(--primary); background: var(--slate-100); }
    td { padding: 14px 16px; border-bottom: 1px solid var(--slate-100); vertical-align: middle; }
    tr:hover td { background-color: rgba(248, 250, 252, 0.8); }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
    }
    .badge-paid { background: var(--emerald-light); color: var(--emerald); }
    .badge-due { background: var(--amber-light); color: var(--amber); }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .input-control, .select-control, textarea.input-control {
      padding: 9px 14px;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      font-size: 13.5px;
      background: var(--slate-50);
      outline: none;
      width: 100%;
      max-width: 100%;
      font-family: inherit;
      transition: all 0.2s ease;
    }
    .input-control:focus, .select-control:focus, textarea.input-control:focus {
      border-color: var(--primary);
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    /* Glassmorphism Modals */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 16px;
      overflow-y: auto;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop.active { display: flex; animation: modalFadeIn 0.2s ease; }
    @keyframes modalFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .modal-card {
      background: #ffffff;
      border-radius: var(--radius-xl);
      max-width: 540px;
      width: 100%;
      padding: 24px;
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.25);
      max-height: 90vh;
      overflow-y: auto;
      border: 1px solid rgba(255, 255, 255, 0.8);
      animation: modalScaleIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes modalScaleIn {
      from { transform: scale(0.95) translateY(12px); opacity: 0; }
      to { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* POS Billing Layout */
    .cart-grid { display: grid; grid-template-columns: 1fr 420px; gap: 20px; }
    .product-tile {
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 14px;
      background: #ffffff;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      min-height: 110px;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }
    .product-tile:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(79, 70, 229, 0.1);
    }
    .product-tile:active { transform: scale(0.98); }

    .cust-select-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 14px;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: 0.18s;
      gap: 12px;
    }
    .cust-select-item:hover { border-color: var(--primary); background: var(--primary-light); }

    .receipt-preview {
      background: #ffffff;
      border: 1px dashed var(--slate-300);
      border-radius: var(--radius-md);
      padding: 18px;
      font-size: 12.5px;
      line-height: 1.6;
    }

    .time-chip {
      padding: 6px 14px;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-full);
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      background: var(--slate-50);
      color: var(--slate-700);
      transition: all 0.18s;
    }
    .time-chip:hover { background: var(--slate-200); }
    .time-chip.active { background: var(--primary-gradient); color: #fff; border-color: transparent; }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 95;
    }
    .sidebar-overlay.active { display: block; }

    /* Security PIN Keypad Styles */
    .pin-dots { display: flex; justify-content: center; gap: 14px; }
    .pin-dot {
      width: 15px;
      height: 15px;
      border-radius: 50%;
      border: 2px solid var(--slate-300);
      background: #fff;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .pin-dot.filled {
      background: var(--primary-gradient);
      border-color: var(--primary);
      transform: scale(1.15);
      box-shadow: 0 0 12px rgba(79, 70, 229, 0.45);
    }
    .keypad-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      max-width: 290px;
      margin: 0 auto;
    }
    .keypad-btn {
      height: 58px;
      font-size: 22px;
      font-weight: 700;
      font-family: 'Outfit', sans-serif;
      border-radius: 16px;
      border: 1px solid var(--slate-200);
      background: var(--slate-50);
      color: var(--slate-800);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
      user-select: none;
    }
    .keypad-btn:hover { background: var(--slate-100); border-color: var(--slate-300); }
    .keypad-btn:active { transform: scale(0.92); background: var(--primary-light); color: var(--primary); }
    .keypad-btn.keypad-fn { font-size: 14px; font-weight: 600; color: var(--slate-600); background: var(--slate-100); }

    /* Mobile Bottom Navigation Bar */
    .mobile-bottom-nav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--slate-200);
      z-index: 90;
      justify-content: space-around;
      align-items: center;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .mob-nav-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      color: var(--slate-500);
      font-size: 10px;
      font-weight: 600;
      gap: 3px;
      cursor: pointer;
      padding: 6px 12px;
      transition: all 0.18s;
      flex: 1;
    }
    .mob-nav-btn.active { color: var(--primary); font-weight: 800; }
    .mob-nav-btn .mob-icon { font-size: 18px; }

    /* Mobile Floating Cart Bar */
    .mobile-cart-bar {
      display: none;
      position: fixed;
      bottom: 68px;
      left: 12px;
      right: 12px;
      background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
      color: #ffffff;
      padding: 12px 18px;
      border-radius: var(--radius-lg);
      box-shadow: 0 10px 30px rgba(67, 56, 202, 0.4);
      z-index: 85;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      animation: slideUpMob 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes slideUpMob {
      from { transform: translateY(30px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* Modern Compact Toast System */
    #appToast {
      position: fixed !important;
      bottom: 24px !important;
      right: 24px !important;
      top: auto !important;
      left: auto !important;
      z-index: 9999999 !important;
      padding: 12px 16px !important;
      border-radius: 12px !important;
      font-size: 13.5px !important;
      font-weight: 600 !important;
      color: #fff !important;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28), 0 2px 6px rgba(0, 0, 0, 0.16) !important;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease !important;
      transform: translateY(100px) !important;
      opacity: 0 !important;
      pointer-events: none !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 12px !important;
      width: auto !important;
      max-width: min(420px, 92vw) !important;
      height: auto !important;
      min-height: unset !important;
      max-height: unset !important;
      box-sizing: border-box !important;
      backdrop-filter: blur(10px) !important;
      -webkit-backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(255, 255, 255, 0.22) !important;
      line-height: 1.4 !important;
    }
    #appToast.toast-visible {
      transform: translateY(0) !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    #appToast .toast-content {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      word-break: break-word;
    }
    #appToast .toast-close-btn {
      background: rgba(255, 255, 255, 0.22);
      border: none;
      color: #ffffff;
      cursor: pointer;
      width: 24px;
      height: 24px;
      min-width: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      line-height: 1;
      padding: 0;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    #appToast .toast-close-btn:hover {
      background: rgba(255, 255, 255, 0.4);
      transform: scale(1.1);
    }

    @media screen {
      .print-section { display: none !important; }
    }

    @media print {
      /* Reset page canvas completely so no ghost height or extra blank pages exist */
      html, body {
        height: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #000000 !important;
        overflow: visible !important;
      }

      /* Hide all on-screen application UI elements completely from print flow */
      .app-container,
      aside,
      header,
      main,
      .mobile-bottom-nav,
      .mobile-cart-bar,
      .modal-backdrop,
      #appToast {
        display: none !important;
        height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
      }

      /* Default hide all print sections */
      .print-section {
        display: none !important;
      }

      /* Show only the active print section in normal flow */
      body.print-inv #printable-invoice,
      body.print-stmt #printable-statement,
      body.print-rpt #printable-report {
        display: block !important;
        position: relative !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 4mm !important;
        box-sizing: border-box !important;
        background: #ffffff !important;
        color: #000000 !important;
      }

      table {
        width: 100% !important;
        border-collapse: collapse !important;
        page-break-inside: auto;
      }

      tr {
        page-break-inside: avoid !important;
        page-break-after: auto;
      }

      thead {
        display: table-header-group;
      }

      tfoot {
        display: table-footer-group;
      }

      @page {
        size: auto;
        margin: 6mm 8mm;
      }
    }

    /* Tablet & Responsive Breakpoints */
    @media (max-width: 1100px) {
      .cart-grid { grid-template-columns: 1fr 360px; gap: 14px; }
    }

    @media (max-width: 900px) {
      .cart-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      body { padding-bottom: 74px; }
      .app-container { flex-direction: column; }
      aside {
        position: fixed;
        top: 0;
        bottom: 0;
        left: -280px;
        width: 280px;
        transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      aside.mobile-open { left: 0; }
      .mobile-menu-toggle { display: flex; align-items: center; justify-content: center; }
      .mobile-bottom-nav { display: flex; }
      .hide-on-mobile { display: none !important; }
      .show-on-mobile { display: inline !important; }
      header { padding: 0 10px; height: 56px; gap: 6px; justify-content: space-between; }
      #cloudSyncHeaderBadge { max-width: 135px; padding: 4px 8px; font-size: 10.5px; }
      #cloudSyncHeaderText { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100px; display: inline-block; }
      main { padding: 12px; gap: 12px; }
      .grid-4 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .card { padding: 14px; border-radius: var(--radius-md); }
      .stat-label { font-size: 10.5px; line-height: 1.35; display: block; word-break: break-word; }
      .stat-val { font-size: 20px; line-height: 1.2; word-break: break-all; margin-top: 3px; }
      #appToast { bottom: 80px !important; right: 12px !important; left: 12px !important; top: auto !important; max-width: calc(100vw - 24px) !important; }
      .modal-backdrop { align-items: flex-end; padding: 0; }
      .modal-card {
        border-radius: 20px 20px 0 0;
        max-width: 100%;
        max-height: 85vh;
        padding-bottom: 84px;
        animation: slideUpSheet 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes slideUpSheet {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
      }
      .input-control, .select-control, textarea.input-control { font-size: 16px !important; }
      th, td { padding: 10px 12px; }
      td button.btn { padding: 4px 7px; font-size: 11px; }
    }

    @media (max-width: 480px) {
      #currentTabHeading { display: none; }
      header { padding: 0 8px; }
      #cloudSyncHeaderBadge { max-width: 110px; padding: 4px 6px; }
      #cloudSyncHeaderText { max-width: 80px; }
      .grid-4 { grid-template-columns: 1fr; }
      .filter-bar { flex-direction: column; align-items: stretch; gap: 8px; }
      .filter-bar input, .filter-bar select, .filter-bar button { width: 100% !important; }
      .modal-card { padding: 14px; padding-bottom: 86px; }
    }
  </style>
</head>
<body>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="app.toggleMobileMenu()"></div>

  <div class="app-container">
    <aside id="appSidebar">
      <div class="brand-box">
        <div class="brand-info">
          <div class="brand-logo">VP</div>
          <div class="brand-title" id="sideBrandName">Vyaparify Pro</div>
        </div>
        <button class="mobile-menu-toggle" onclick="app.toggleMobileMenu()">✕</button>
      </div>
      <div style="padding: 6px 16px 0 16px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 10px; color: var(--emerald); font-weight: 700;" id="storageModeBadge">📁 Directory Mode</span>
        <button class="btn btn-light" style="font-size: 9px; padding: 2px 6px;" onclick="app.connectDataDirectory()">Change Dir</button>
      </div>
      <nav>
        <button class="nav-btn active" onclick="app.switchTab('dashboard', this)">📊 Dashboard</button>
        <button class="nav-btn" onclick="app.switchTab('billing', this)">🛒 POS Billing</button>
        <button class="nav-btn" onclick="app.switchTab('inventory', this)">📦 Inventory</button>
        <button class="nav-btn" onclick="app.switchTab('invoices', this)">📄 Invoices</button>
        <button class="nav-btn" onclick="app.switchTab('ledger', this)">📒 Khata Book</button>
        <button class="nav-btn" onclick="app.switchTab('customers', this)">👥 Customers</button>
        <button class="nav-btn" onclick="app.switchTab('reports', this)">📈 Reports</button>
        <button class="nav-btn" onclick="app.switchTab('shop', this)">🏪 Shop Details</button>
        <button class="nav-btn" onclick="app.switchTab('backup', this)">🛡️ Cloud & Security</button>
      </nav>
      <div style="padding: 12px 14px; border-top: 1px solid rgba(255,255,255,0.08); margin-top: auto;">
        <button class="btn btn-light" style="width: 100%; justify-content: flex-start; gap: 8px; background: rgba(255,255,255,0.06); color: #cbd5e1; border: 1px solid rgba(255,255,255,0.1); font-size: 12.5px; border-radius: var(--radius-md);" onclick="app.lockApp()">
          <span>🔒</span> Lock App Screen
        </button>
      </div>
    </aside>

    <div class="main-content">
      <header>
        <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
          <button class="mobile-menu-toggle" style="color: var(--slate-800); font-size: 22px;" onclick="app.toggleMobileMenu()">☰</button>
          <span id="currentTabHeading" style="font-weight: 800; text-transform: uppercase; font-size: 13px; color: var(--slate-700); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Dashboard</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
          <!-- Quick Screen Lock Button -->
          <button class="btn btn-light" id="headerLockBtn" style="padding: 6px 10px; font-size: 12px; gap: 4px;" onclick="app.lockApp()" title="Lock Screen (Security PIN)">
            <span id="headerLockIcon">🔒</span> <span class="hide-on-mobile">Lock Screen</span>
          </button>

          <div id="cloudSyncHeaderBadge" style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; padding: 6px 10px; border-radius: 20px; background: var(--slate-100); border: 1px solid var(--slate-200); color: var(--slate-600); cursor: pointer; transition: all 0.2s;" onclick="app.switchTab('backup')" title="Google Drive Cloud Sync Status">
            <span id="cloudSyncStatusDot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--slate-400); display: inline-block; flex-shrink: 0;"></span>
            <span id="cloudSyncHeaderText">Drive: Offline</span>
          </div>
          <button class="btn btn-primary" style="padding: 6px 12px;" onclick="app.startNewSale()"><span class="hide-on-mobile">+ Quick Bill (F2)</span><span class="show-on-mobile">+ Bill</span></button>
        </div>
      </header>

      <main>
        <div id="backupIndicator" class="card" style="padding: 10px 16px; font-size: 12px; display: flex; justify-content: space-between; align-items: center; background: var(--slate-50); flex-wrap: wrap; gap: 6px;">
          <span id="autoBackupText">🛡️ Directory Data Synchronized: Ready</span>
          <span style="color: var(--slate-500);" id="lastSavedLabel">Saved locally in /data folder</span>
        </div>

        <section id="tab-dashboard">
          <div class="grid-4">
            <div class="card">
              <span class="stat-label">Today Sales</span>
              <div class="stat-val" id="dashTodaySales">₹0</div>
            </div>
            <div class="card">
              <span class="stat-label">Total Receivables (Khata Due)</span>
              <div class="stat-val" style="color: var(--amber);" id="dashTotalDue">₹0</div>
            </div>
            <div class="card">
              <span class="stat-label">Low Stock Items</span>
              <div class="stat-val" style="color: var(--red);" id="dashLowStock">0</div>
            </div>
            <div class="card">
              <span class="stat-label">Total Invoices</span>
              <div class="stat-val" id="dashTotalInvoices">0</div>
            </div>
          </div>
        </section>

        <section id="tab-billing" style="display: none;">
          <div class="cart-grid">
            <div class="card">
              <div class="filter-bar">
                <input type="text" class="input-control" style="flex: 1;" placeholder="Search products..." oninput="app.searchProductsPos(this.value)">
                <button class="btn btn-light" onclick="app.openCustomerSelectionModal()">Customer: <strong id="posCustomerLabel" style="margin-left: 4px; color: var(--primary);">Walk-in</strong> ▾</button>
              </div>
              <div class="grid-4" id="posProductGrid" style="max-height: 520px; overflow-y: auto;"></div>
            </div>

            <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; background: #fff; border: 2px solid var(--slate-200);">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 2px solid var(--slate-100); padding-bottom: 8px;">
                  <h3 style="font-size: 16px; font-weight: 800; color: var(--slate-800);">🛒 Active Cart</h3>
                  <button class="btn btn-danger" style="font-size: 10px; padding: 4px 8px;" onclick="app.clearCart()">Clear Cart</button>
                </div>
                <div id="cartItemsList" style="max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 4px;"></div>
              </div>
              
              <div style="margin-top: 20px; display: flex; flex-direction: column; gap: 12px; border-top: 2px solid var(--slate-100); padding-top: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-weight: bold;">
                  <span style="font-size: 13px; color: var(--slate-600);">Payment Mode:</span>
                  <select id="posPaymentMode" class="select-control" style="font-weight: 700; width: 160px;">
                    <option value="Cash">Cash</option>
                    <option value="Online">Online / UPI</option>
                    <option value="Credit">Khata / Credit</option>
                  </select>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 20px; font-weight: 800; background: var(--primary-light); padding: 12px; border-radius: 10px;">
                  <span>Grand Total:</span>
                  <span id="posTotalLabel" style="color: var(--primary);">₹0.00</span>
                </div>
                <button class="btn btn-emerald" style="padding: 14px; font-size: 14px; font-weight: bold;" onclick="app.completeSale()">Complete Sale & Preview</button>
              </div>
            </div>
          </div>
        </section>

        <section id="tab-inventory" style="display: none;">
          <div class="card">
            <div class="filter-bar">
              <input type="text" class="input-control" placeholder="Search inventory..." style="width: 250px;" oninput="app.filterInventory(this.value)">
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <select class="select-control" style="width: auto;" onchange="app.filterInventoryStock(this.value)">
                  <option value="all">All Stock Levels</option>
                  <option value="low">Low Stock (≤ 5)</option>
                  <option value="out">Out of Stock</option>
                </select>
                <button class="btn btn-primary" onclick="app.openProductModal()">+ Add Product</button>
              </div>
            </div>
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th class="sortable" onclick="app.sortData('products', 'name')">Name ↕</th>
                    <th class="sortable" onclick="app.sortData('products', 'price')">Price ↕</th>
                    <th class="sortable" onclick="app.sortData('products', 'stock')">Stock ↕</th>
                    <th class="sortable" onclick="app.sortData('products', 'updatedAt')">Last Updated ↕</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="inventoryTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="tab-invoices" style="display: none;">
          <div class="card">
            <div class="filter-bar">
              <input type="text" class="input-control" placeholder="Search invoice or customer..." oninput="app.filterInvoices(this.value)">
              <select class="select-control" style="width: auto;" onchange="app.filterInvoicesMode(this.value)">
                <option value="all">All Modes</option>
                <option value="Cash">Cash</option>
                <option value="Online">Online / UPI</option>
                <option value="Credit">Khata / Credit</option>
              </select>
            </div>
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th class="sortable" onclick="app.sortData('invoices', 'id')">Bill ID ↕</th>
                    <th class="sortable" onclick="app.sortData('invoices', 'date')">Date & Time ↕</th>
                    <th>Customer</th>
                    <th>Mode</th>
                    <th class="sortable" onclick="app.sortData('invoices', 'total')">Amount ↕</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="invoicesTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="tab-ledger" style="display: none;">
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
              <div>
                <h4 style="margin: 0;">Khata Book / Credit Accounts</h4>
                <p style="font-size: 12px; color: var(--slate-500); margin: 2px 0 0 0;">Tracks outstanding balances, advance payments, and manual entries.</p>
              </div>
              <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                <button class="btn btn-primary" onclick="app.openManualKhataModal()">+ Manual Khata Entry</button>
                <div class="badge badge-due" style="font-size: 13px; padding: 6px 12px;" id="khataTotalBadge">Total Due: ₹0.00</div>
              </div>
            </div>
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th>Customer Name</th>
                    <th>Phone, Email & Address</th>
                    <th class="sortable" onclick="app.sortData('customers', 'balance')">Current Due ↕</th>
                    <th>Last Active</th>
                    <th style="text-align: right;">Actions</th>
                  </tr>
                </thead>
                <tbody id="ledgerTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="tab-customers" style="display: none;">
          <div class="card">
            <div class="filter-bar">
              <input type="text" class="input-control" placeholder="Search customer records..." oninput="app.filterCustomers(this.value)">
              <button class="btn btn-primary" onclick="app.openCustomerModal()">+ Add Customer</button>
            </div>
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th class="sortable" onclick="app.sortData('customers', 'name')">Name ↕</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>GST/PAN</th>
                    <th class="sortable" onclick="app.sortData('customers', 'createdAt')">Created Date ↕</th>
                    <th style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="customersTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="tab-reports" style="display: none;">
          <div class="card" style="margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
              <div>
                <h3 style="margin: 0;">Business Reports & Time-Based Analytics</h3>
                <p style="font-size: 12px; color: var(--slate-500); margin-top: 2px;">Filter, sort, and export comprehensive audit reports by date, payment type, or stock status.</p>
              </div>
              <div style="display: flex; gap: 8px;">
                <button class="btn btn-emerald" onclick="app.exportReportCSV()">📥 Export CSV</button>
                <button class="btn btn-primary" onclick="app.printReport()">🖨️ Print Report</button>
              </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; align-items: center;">
              <span class="stat-label" style="margin-right: 4px;">Time Presets:</span>
              <button class="time-chip active" id="chip-today" onclick="app.setReportPreset('today')">Today</button>
              <button class="time-chip" id="chip-yesterday" onclick="app.setReportPreset('yesterday')">Yesterday</button>
              <button class="time-chip" id="chip-week" onclick="app.setReportPreset('week')">Last 7 Days</button>
              <button class="time-chip" id="chip-month" onclick="app.setReportPreset('month')">This Month</button>
              <button class="time-chip" id="chip-all" onclick="app.setReportPreset('all')">All Time</button>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; background: var(--slate-50); padding: 14px; border-radius: 10px; border: 1px solid var(--slate-200);">
              <div>
                <label class="stat-label">Report Type</label>
                <select id="rptTypeSelect" class="select-control" style="width: 100%; margin-top: 4px;" onchange="app.renderReport()">
                  <option value="sales">Sales & Revenue Report</option>
                  <option value="khata">Khata & Credit Ledger Report</option>
                  <option value="inventory">Inventory Valuation Report</option>
                  <option value="customers">Customers Directory Report</option>
                </select>
              </div>

              <div>
                <label class="stat-label">From Date</label>
                <input type="date" id="rptStartDate" class="input-control" style="width: 100%; margin-top: 4px;" onchange="app.clearPresetChips(); app.renderReport();">
              </div>

              <div>
                <label class="stat-label">To Date</label>
                <input type="date" id="rptEndDate" class="input-control" style="width: 100%; margin-top: 4px;" onchange="app.clearPresetChips(); app.renderReport();">
              </div>

              <div>
                <label class="stat-label">Payment Mode</label>
                <select id="rptModeSelect" class="select-control" style="width: 100%; margin-top: 4px;" onchange="app.renderReport()">
                  <option value="all">All Modes</option>
                  <option value="Cash">Cash Only</option>
                  <option value="Online">Online / UPI Only</option>
                  <option value="Credit">Khata / Credit Only</option>
                </select>
              </div>

              <div>
                <label class="stat-label">Sort Order</label>
                <select id="rptSortSelect" class="select-control" style="width: 100%; margin-top: 4px;" onchange="app.renderReport()">
                  <option value="date-desc">Date (Newest First)</option>
                  <option value="date-asc">Date (Oldest First)</option>
                  <option value="amount-desc">Amount (High to Low)</option>
                  <option value="amount-asc">Amount (Low to High)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="grid-4" id="rptKpiContainer" style="margin-bottom: 16px;">
            <div class="card">
              <span class="stat-label">Filtered Revenue</span>
              <div class="stat-val" id="rptKpiRevenue" style="color: var(--primary);">₹0.00</div>
            </div>
            <div class="card">
              <span class="stat-label">Transactions Count</span>
              <div class="stat-val" id="rptKpiCount">0</div>
            </div>
            <div class="card">
              <span class="stat-label">Cash / UPI Inflow</span>
              <div class="stat-val" id="rptKpiCashUpi" style="color: var(--emerald);">₹0.00</div>
            </div>
            <div class="card">
              <span class="stat-label">Credit Extended</span>
              <div class="stat-val" id="rptKpiCredit" style="color: var(--amber);">₹0.00</div>
            </div>
          </div>

          <div class="table-container">
            <table>
              <thead id="rptTableHead"></thead>
              <tbody id="rptTableBody"></tbody>
            </table>
          </div>
        </section>

        <section id="tab-shop" style="display: none;">
          <div class="card" style="max-width: 700px; margin: 0 auto;">
            <h4 style="margin-bottom: 4px;">Shop & Business Profile</h4>
            <p style="font-size: 12px; color: var(--slate-500); margin-bottom: 16px;">This information will automatically appear on invoices, print receipts, and report headers.</p>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
              <div style="grid-column: 1 / -1;">
                <label class="stat-label">Shop / Business Name</label>
                <input type="text" id="shopNameInput" class="input-control" style="width: 100%;">
              </div>
              <div>
                <label class="stat-label">Contact Phone Number</label>
                <input type="text" id="shopPhoneInput" class="input-control" style="width: 100%;">
              </div>
              <div>
                <label class="stat-label">Shop Email Address</label>
                <input type="email" id="shopEmailInput" class="input-control" style="width: 100%;" placeholder="e.g. store@example.com">
              </div>
              <div>
                <label class="stat-label">GST / PAN Number</label>
                <input type="text" id="shopGstInput" class="input-control" style="width: 100%;">
              </div>
              <div>
                <label class="stat-label">FSSAI / License Number</label>
                <input type="text" id="shopFssaiInput" class="input-control" style="width: 100%;">
              </div>
              <div style="grid-column: 1 / -1;">
                <label class="stat-label">Tagline / Slogan</label>
                <input type="text" id="shopTaglineInput" class="input-control" style="width: 100%;">
              </div>
              <div style="grid-column: 1 / -1;">
                <label class="stat-label">Full Shop Address</label>
                <textarea id="shopAddressInput" class="input-control" rows="3" style="width: 100%;"></textarea>
              </div>
            </div>

            <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
              <button class="btn btn-primary" onclick="app.saveShopSettings()">💾 Save Shop Profile</button>
            </div>
          </div>
        </section>

        <section id="tab-backup" style="display: none;">
          <div class="grid-2">
            <!-- Counter Security & Master PIN Lock Card -->
            <div class="card" style="grid-column: 1 / -1; background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); border: 2px solid var(--slate-300); box-shadow: var(--card-shadow);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 22px;">🛡️</span>
                    <h3 style="color: var(--slate-900); margin: 0; font-size: 17px;">Counter Security & Master PIN Lock</h3>
                    <span id="securityStatusBadge" class="badge" style="background: var(--slate-200); color: var(--slate-700); font-size: 11px;">Not Configured</span>
                  </div>
                  <p style="font-size: 12px; color: var(--slate-600); margin-top: 4px;">
                    Protect cash registers, bill deletions, ledger records, customer directories, and database exports with cryptographic Master PIN authentication.
                  </p>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button class="btn btn-light" onclick="app.lockApp()">🔒 Lock Screen Now</button>
                  <button class="btn btn-primary" onclick="app.openMasterPinSetupModal()">⚙️ Security Settings</button>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; background: #ffffff; border: 1px solid var(--slate-200); border-radius: 12px; padding: 14px;">
                <div>
                  <span class="stat-label">Protection Mode</span>
                  <div id="secStatusText" style="font-size: 13px; font-weight: 700; color: var(--slate-800); margin-top: 2px;">Master PIN Lock</div>
                </div>
                <div>
                  <span class="stat-label">Auto-Lock Inactivity</span>
                  <div id="secAutoLockText" style="font-size: 13px; font-weight: 600; color: var(--slate-600); margin-top: 2px;">5 Minutes Timeout</div>
                </div>
                <div>
                  <span class="stat-label">Brute-Force Guard</span>
                  <div style="font-size: 13px; font-weight: 600; color: var(--emerald); margin-top: 2px;">Active (5 Attempts Limit)</div>
                </div>
                <div>
                  <span class="stat-label">Sensitive Actions</span>
                  <div style="font-size: 13px; font-weight: 600; color: var(--primary); margin-top: 2px;">Protected (PIN Required)</div>
                </div>
              </div>
            </div>

            <!-- Google Drive Cloud Multi-Device Sync Card -->
            <div class="card" style="grid-column: 1 / -1; background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%); border: 2px solid #bfdbfe; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 22px;">☁️</span>
                    <h3 style="color: #1e40af; margin: 0; font-size: 17px;">Google Drive Multi-Device Cloud Sync</h3>
                    <span id="gdriveStatusBadge" class="badge" style="background: #dbeafe; color: #1d4ed8; font-size: 11px;">Not Connected</span>
                  </div>
                  <p style="font-size: 12px; color: var(--slate-600); margin-top: 4px;">
                    Auto-backup & auto-sync across all your computers, laptops, and mobile devices using the same Google Account.
                  </p>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button class="btn btn-primary" onclick="app.pushToGoogleDrive(true)" id="gdrivePushBtn" title="Upload local changes to Google Drive">☁️ Push to Drive</button>
                  <button class="btn btn-emerald" onclick="app.pullFromGoogleDrive(true)" id="gdrivePullBtn" title="Pull latest changes from other devices">📥 Pull from Drive</button>
                </div>
              </div>

              <!-- Connection Status & Device Info Bar -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; background: #ffffff; border: 1px solid #dbeafe; border-radius: 10px; padding: 12px; margin-bottom: 14px;">
                <div>
                  <span class="stat-label">Google Account</span>
                  <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                    <div id="gdriveEmailLabel" style="font-size: 13px; font-weight: 700; color: #1e3a8a; word-break: break-all;">Not Signed In</div>
                    <button type="button" class="btn btn-danger" id="gdriveTopDisconnectBtn" style="display: none; padding: 2px 7px; font-size: 10.5px; border-radius: 4px;" onclick="app.disconnectGoogleAccount()" title="Disconnect Account">Disconnect</button>
                  </div>
                </div>
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="stat-label">This Device Name</span>
                    <button type="button" class="btn" style="background: none; border: none; color: var(--primary); font-size: 11px; padding: 0; cursor: pointer; text-decoration: underline;" onclick="app.promptEditDeviceName()">✏️ Edit</button>
                  </div>
                  <div style="display: flex; gap: 6px; margin-top: 3px;">
                    <input type="text" id="gdriveDeviceNameInput" class="input-control" style="padding: 5px 8px; font-size: 12px; font-weight: 600; flex: 1;" placeholder="e.g. Counter 1 (PC)" onchange="app.saveDeviceName()" onkeydown="if(event.key==='Enter'){event.preventDefault(); app.saveDeviceName();}">
                    <button type="button" class="btn btn-primary" style="padding: 5px 10px; font-size: 11px; font-weight: 700; white-space: nowrap;" onclick="app.saveDeviceName()">Save</button>
                  </div>
                </div>
                <div>
                  <span class="stat-label">Last Cloud Sync</span>
                  <div id="gdriveLastSyncLabel" style="font-size: 12px; font-weight: 600; color: var(--slate-600); margin-top: 2px;">Never</div>
                </div>
                <div>
                  <span class="stat-label">Sync Automation</span>
                  <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 4px; font-size: 11px; font-weight: 600;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                      <input type="checkbox" id="gdriveAutoSyncCheck" checked onchange="app.saveGdriveSettings()">
                      <span>Auto-push on transaction</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                      <input type="checkbox" id="gdriveAutoPullCheck" checked onchange="app.saveGdriveSettings()">
                      <span>Auto-pull from devices (45s)</span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Connection Settings & Configuration Modes -->
              <div style="background: rgba(255,255,255,0.7); border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                  <strong style="font-size: 12px; color: var(--slate-700); text-transform: uppercase;">Google Drive Configuration Methods</strong>
                  <div style="display: flex; gap: 6px;">
                    <button class="btn btn-light" style="font-size: 11px; padding: 4px 10px;" id="btnModeOauth" onclick="app.switchGdriveMode('oauth')">Method A: Google Sign-In (OAuth)</button>
                    <button class="btn btn-light" style="font-size: 11px; padding: 4px 10px;" id="btnModeWebhook" onclick="app.switchGdriveMode('webhook')">Method B: Apps Script Webhook</button>
                  </div>
                </div>

                <!-- Method A: Official Google OAuth -->
                <div id="gdriveOauthSection" style="display: block;">
                  <p style="font-size: 12px; color: var(--slate-600); margin-bottom: 8px;">
                    Uses official Google Identity Services to securely store <code style="background: #f1f5f9; padding: 2px 4px; border-radius: 4px;">vyaparify_cloud_database.json</code> in your personal Google Drive.
                  </p>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end;">
                    <div style="flex: 1; min-width: 260px;">
                      <label class="stat-label">Google OAuth 2.0 Client ID</label>
                      <div style="display: flex; gap: 4px; margin-top: 4px;">
                        <input type="password" id="gdriveClientIdInput" class="input-control" placeholder="e.g. 1234567890-abcdef.apps.googleusercontent.com">
                        <button type="button" class="btn btn-light" style="padding: 4px 10px;" onclick="app.toggleInputMask('gdriveClientIdInput', this)" title="Show/Hide">👁️</button>
                      </div>
                    </div>
                    <button class="btn btn-light" onclick="app.saveGdriveSettings()">Save Client ID</button>
                    <button class="btn" style="background: #4285F4; color: #fff; font-weight: bold;" onclick="app.initGoogleAuth()">
                      <span style="margin-right: 4px;">🔐</span> Sign In with Google
                    </button>
                    <button class="btn btn-danger" onclick="app.disconnectGoogleAccount()">Disconnect</button>
                  </div>
                  <details style="margin-top: 8px; font-size: 11px; color: var(--slate-600);">
                    <summary style="cursor: pointer; font-weight: 600;">How to get a Google Client ID in 2 minutes (Click to expand)</summary>
                    <ol style="margin: 6px 0 0 16px; line-height: 1.6;">
                      <li>Visit <a href="https://console.cloud.google.com/apis/credentials" target="_blank" style="color: var(--primary);">Google Cloud Console</a>.</li>
                      <li>Create a free project & enable <strong>Google Drive API</strong>.</li>
                      <li>Go to <strong>Credentials</strong> &rarr; <strong>Create Credentials</strong> &rarr; <strong>OAuth Client ID</strong> &rarr; Application Type: <strong>Web Application</strong>.</li>
                      <li>Add your authorized JavaScript origins (e.g. <code>http://localhost:5500</code>, <code>http://127.0.0.1:5500</code>, or your web domain).</li>
                      <li>Paste the generated Client ID above and click "Sign In with Google"!</li>
                    </ol>
                  </details>
                </div>

                <!-- Method B: Google Apps Script Webhook (Zero OAuth Setup!) -->
                <div id="gdriveWebhookSection" style="display: none;">
                  <p style="font-size: 12px; color: var(--slate-600); margin-bottom: 8px;">
                    <strong>Zero-Config Alternative:</strong> Paste a free 10-line Google Apps Script Web App URL from your Google account. Works on any device, phone, or local file without configuring Google Cloud Console!
                  </p>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end;">
                    <div style="flex: 1; min-width: 260px;">
                      <label class="stat-label">Google Apps Script Web App URL</label>
                      <div style="display: flex; gap: 4px; margin-top: 4px;">
                        <input type="password" id="gdriveScriptUrlInput" class="input-control" placeholder="https://script.google.com/macros/s/.../exec">
                        <button type="button" class="btn btn-light" style="padding: 4px 10px;" onclick="app.toggleInputMask('gdriveScriptUrlInput', this)" title="Show/Hide">👁️</button>
                      </div>
                    </div>
                    <button class="btn btn-primary" onclick="app.saveAndTestWebhook()">🔗 Connect Webhook</button>
                    <button class="btn btn-danger" onclick="app.disconnectGoogleAccount()">🔌 Disconnect</button>
                    <button class="btn btn-light" onclick="app.copyAppsScriptTemplate()">📋 Copy Script Code</button>
                  </div>
                  <details style="margin-top: 8px; font-size: 11px; color: var(--slate-600);">
                    <summary style="cursor: pointer; font-weight: 600;">Instructions for 1-minute Google Apps Script setup</summary>
                    <ol style="margin: 6px 0 0 16px; line-height: 1.6;">
                      <li>Click "Copy Script Code" above.</li>
                      <li>Open <a href="https://script.google.com" target="_blank" style="color: var(--primary);">script.google.com</a> and click "New Project".</li>
                      <li>Paste the code, click <strong>Deploy</strong> &rarr; <strong>New Deployment</strong> &rarr; Select type: <strong>Web App</strong>.</li>
                      <li>Set "Execute as: <strong>Me</strong>" and "Who has access: <strong>Anyone</strong>". Click Deploy.</li>
                      <li>Copy the Web App URL and paste it above!</li>
                    </ol>
                  </details>
                </div>
              </div>
            </div>

            <!-- Manual & File-based Backups -->
            <div class="card">
              <h4>💾 Manual Backup & Full Restore</h4>
              <p style="font-size: 12px; color: var(--slate-500); margin: 6px 0 14px;">
                Download complete offline JSON backups or restore data from any previous backup file.
              </p>
              <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-primary" onclick="app.downloadBackup()">📥 Download JSON Backup File</button>
                <input type="file" id="importBackupFileInput" accept=".json" style="display: none;" onchange="app.handleBackupFileUpload(event)">
                <button class="btn btn-emerald" onclick="document.getElementById('importBackupFileInput').click()">📤 Restore / Upload JSON Backup</button>
              </div>
            </div>

            <!-- Local / Directory Storage Binding -->
            <div class="card">
              <h4>📁 Local / Directory Storage Binding</h4>
              <p style="font-size: 12px; color: var(--slate-500); margin: 6px 0 14px;">
                Connect your local <code>/data</code> folder directly via File System Access API so files auto-sync in your local directory.
              </p>
              <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-light" onclick="app.connectDataDirectory()">📁 Link Local /data Folder</button>
              </div>
            </div>

            <!-- Cloud Email Backup (EmailJS Integration) -->
            <div class="card" style="background: #faf5ff; border-color: #e9d5ff;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; flex-wrap: wrap; gap: 10px;">
                <div>
                  <h4 style="color: #6b21a8;">📧 Cloud Email Backup (EmailJS)</h4>
                  <p style="font-size: 12px; color: var(--slate-600); margin-top: 2px;">Dispatch complete database snapshots directly to your email inbox.</p>
                </div>
                <button class="btn" style="background: #9333ea; color: #fff;" onclick="app.sendEmailBackup()">📤 Send Email Backup</button>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; margin-top: 8px;">
                <div>
                  <label class="stat-label">Target Email</label>
                  <input type="email" id="emailjsTo" class="input-control" placeholder="e.g. store@gmail.com">
                </div>
                <div>
                  <label class="stat-label">Public Key</label>
                  <input type="text" id="emailjsKey" class="input-control" placeholder="user_xxx">
                </div>
                <div>
                  <label class="stat-label">Service ID</label>
                  <input type="text" id="emailjsService" class="input-control" placeholder="service_xxx">
                </div>
                <div>
                  <label class="stat-label">Template ID</label>
                  <input type="text" id="emailjsTemplate" class="input-control" placeholder="template_xxx">
                </div>
              </div>
              <div style="margin-top: 8px; display: flex; justify-content: flex-end;">
                <button class="btn btn-light" style="font-size: 11px;" onclick="app.saveEmailSettings()">Save Email Config</button>
              </div>
            </div>

            <!-- Snapshots & Auto-Backups List -->
            <div class="card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <h4 style="margin: 0;">🕒 Snapshots & Auto-Backups</h4>
                <button class="btn btn-light" style="font-size: 11px; padding: 2px 8px;" onclick="app.takeManualSnapshotNow()">+ Take Snapshot Now</button>
              </div>
              <p style="font-size: 12px; color: var(--slate-500); margin-bottom: 10px;">Automated snapshots stored locally and in cloud storage with 1-click restore.</p>
              <div id="autoBackupList" style="display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow-y: auto;"></div>
            </div>

            <!-- Danger Zone -->
            <div class="card" style="grid-column: 1 / -1; border: 1px solid var(--red-light); background: var(--red-light);">
              <h4 style="color: var(--red);">⚠️ Danger Zone: Complete Factory Reset</h4>
              <p style="font-size: 12px; color: var(--slate-700); margin: 6px 0 12px;">This will permanently wipe all products, invoices, customers, and ledger statements. Requires security verification.</p>
              <button class="btn btn-danger" style="border: 1px solid var(--red);" onclick="app.triggerClearDataFlow()">🗑️ Initiate Full Factory Reset</button>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <div class="modal-backdrop" id="selectCustomerModal">
    <div class="modal-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3>Select Customer</h3>
        <button class="btn btn-primary" style="font-size: 11px; padding: 4px 8px;" onclick="app.openCustomerModal(true)">+ Add New Customer</button>
      </div>

      <input type="text" id="custModalSearch" class="input-control" style="width: 100%; margin-bottom: 12px;" placeholder="Search name, phone, email, or address..." oninput="app.renderCustomerSelectList(this.value)">

      <div style="display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto;" id="customerSelectListContainer"></div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; border-top: 1px solid var(--slate-200); padding-top: 10px;">
        <button class="btn btn-light" onclick="app.closeModals()">Close</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="manualKhataModal">
    <div class="modal-card">
      <h3 style="margin-bottom: 12px;">Manual Khata Entry (Without Bill)</h3>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div>
          <label class="stat-label">Select Customer</label>
          <select id="manualKhataCustSelect" class="select-control" style="width: 100%; margin-top: 4px;"></select>
        </div>
        <div>
          <label class="stat-label">Entry Type</label>
          <select id="manualKhataType" class="select-control" style="width: 100%; margin-top: 4px;">
            <option value="debit">You Gave / Udhar (Debit Due)</option>
            <option value="repay">You Got / Advance Payment (Credit Paid)</option>
          </select>
        </div>
        <div>
          <label class="stat-label">Amount (₹)</label>
          <input type="number" step="0.01" id="manualKhataAmount" class="input-control" style="width: 100%; margin-top: 4px;" placeholder="0.00">
        </div>
        <div>
          <label class="stat-label">Description / Note</label>
          <input type="text" id="manualKhataNote" class="input-control" style="width: 100%; margin-top: 4px;" placeholder="e.g. Manual adjustment, advance deposit">
        </div>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <button class="btn btn-light" onclick="app.closeModals()">Cancel</button>
        <button class="btn btn-primary" onclick="app.saveManualKhataEntry()">Save Entry</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="statementModal">
    <div class="modal-card" style="max-width: 650px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3>Khata Account Statement</h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>
      
      <div id="statementContent"></div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; border-top: 1px solid var(--slate-200); padding-top: 12px; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn btn-emerald" id="statementRepayBtn">+ Record Payment</button>
          <button class="btn btn-light" id="statementAdvanceBtn">+ Add Advance</button>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn" style="background: #25D366; color: #fff; font-weight: bold;" onclick="app.shareCustomerKhataWhatsApp(app.currentStatementCustomer ? app.currentStatementCustomer.id : null)">📱 WhatsApp Statement</button>
          <button class="btn btn-primary" onclick="app.printCurrentStatement()">🖨️ Print Statement</button>
          <button class="btn btn-light" onclick="app.closeModals()">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="invoiceActionModal">
    <div class="modal-card" style="max-width: 550px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3>Invoice Preview</h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>
      
      <div id="invoiceActionPreview" class="receipt-preview" style="margin-bottom: 16px;"></div>

      <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; border-top: 1px solid var(--slate-200); padding-top: 12px; flex-wrap: wrap;">
        <div style="display: flex; gap: 6px;">
          <button class="btn btn-light" onclick="app.editCurrentInvoiceFromPreview()">✏️ Edit Bill</button>
          <button class="btn btn-danger" onclick="app.deleteInvoice(app.activePreviewInvoice ? app.activePreviewInvoice.id : null)">🗑️ Delete</button>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn" style="background: #25D366; color: #fff; font-weight: bold;" onclick="app.shareInvoiceWhatsApp(app.activePreviewInvoice)">📱 Send on WhatsApp</button>
          <button class="btn btn-primary" onclick="app.triggerDirectPrint()">🖨️ Print / Save PDF</button>
          <button class="btn btn-emerald" onclick="app.closeModals()">💾 Done (Save)</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="whatsappPromptModal">
    <div class="modal-card" style="max-width: 420px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3 id="waPromptModalTitle" style="display: flex; align-items: center; gap: 8px; margin: 0;">
          <span style="color: #25D366;">📱</span> WhatsApp Sharing
        </h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>
      <p id="waPromptModalDesc" style="font-size: 13px; color: var(--slate-600); margin-bottom: 14px;">Enter customer WhatsApp number:</p>
      
      <div style="margin-bottom: 16px;">
        <label class="stat-label">Mobile Number</label>
        <div style="display: flex; gap: 6px; margin-top: 4px;">
          <span style="display: flex; align-items: center; padding: 0 10px; background: var(--slate-100); border: 1px solid var(--slate-200); border-radius: 8px; font-weight: 700; font-size: 13px; color: var(--slate-600);">+91</span>
          <input type="tel" id="waPromptInputPhone" class="input-control" placeholder="10-digit mobile number" maxlength="15" style="flex: 1;">
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px;">
        <button class="btn" style="background: #25D366; color: #fff; font-weight: bold; padding: 10px;" onclick="app.submitWhatsAppPrompt(true)">📱 Send Directly to This Number</button>
        <button class="btn btn-light" style="font-size: 12px; padding: 8px;" onclick="app.submitWhatsAppPrompt(false)">Open WhatsApp (Choose Contact in App)</button>
        <button class="btn btn-light" style="font-size: 12px; padding: 6px;" onclick="app.closeModals()">Cancel</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="editInvoiceModal">
    <div class="modal-card" style="max-width: 600px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3 id="editModalHeading" style="margin: 0;">Edit Invoice</h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div>
            <label class="stat-label">Payment Mode</label>
            <select id="editInvModeSelect" class="select-control" style="width: 100%; margin-top: 4px;">
              <option value="Cash">Cash</option>
              <option value="Online">Online / UPI</option>
              <option value="Credit">Khata / Credit</option>
            </select>
          </div>
          <div>
            <label class="stat-label">Bill Date & Time</label>
            <input type="datetime-local" id="editInvDateInput" class="input-control" style="width: 100%; margin-top: 4px;">
          </div>
        </div>

        <div>
          <label class="stat-label">Customer</label>
          <select id="editInvCustomerSelect" class="select-control" style="width: 100%; margin-top: 4px;"></select>
        </div>

        <div>
          <label class="stat-label">Add Item to Bill</label>
          <div style="display: flex; gap: 6px; margin-top: 4px;">
            <select id="editInvAddProductSelect" class="select-control" style="flex: 1;"></select>
            <button class="btn btn-light" onclick="app.addItemToEditInvoice()">+ Add</button>
          </div>
        </div>

        <label class="stat-label" style="margin-top: 4px;">Items in Bill (Adjust Qty, Price, or Remove)</label>
        <div id="editInvItemsList" style="max-height: 220px; overflow-y: auto; border: 1px solid var(--slate-200); border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 6px;"></div>
        
        <div style="display: flex; justify-content: space-between; align-items: center; font-weight: bold; padding: 8px 0; border-top: 1px solid var(--slate-200);">
          <span>Updated Grand Total:</span>
          <span id="editInvTotalLabel" style="color: var(--primary); font-size: 16px;">₹0.00</span>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 16px; border-top: 1px solid var(--slate-200); padding-top: 12px;">
        <button class="btn btn-danger" onclick="app.deleteInvoiceFromEditModal()">🗑️ Delete Invoice</button>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-light" onclick="app.closeModals()">Cancel</button>
          <button class="btn btn-primary" onclick="app.saveEditedInvoice()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="editKhataEntryModal">
    <div class="modal-card" style="max-width: 460px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3 style="margin: 0;">Edit Khata Transaction</h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>
      <input type="hidden" id="editKhataId">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div>
          <label class="stat-label">Customer</label>
          <input type="text" id="editKhataCustName" class="input-control" disabled style="background: var(--slate-100); margin-top: 4px; font-weight: bold;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div>
            <label class="stat-label">Entry Type</label>
            <select id="editKhataType" class="select-control" style="width: 100%; margin-top: 4px;">
              <option value="debit">You Gave / Udhar (Debit Due)</option>
              <option value="repay">Payment Received (Credit Paid)</option>
            </select>
          </div>
          <div>
            <label class="stat-label">Amount (₹)</label>
            <input type="number" step="0.01" id="editKhataAmount" class="input-control" style="width: 100%; margin-top: 4px; font-weight: bold;">
          </div>
        </div>
        <div>
          <label class="stat-label">Transaction Date & Time</label>
          <input type="datetime-local" id="editKhataDate" class="input-control" style="width: 100%; margin-top: 4px;">
        </div>
        <div>
          <label class="stat-label">Description / Note</label>
          <input type="text" id="editKhataNote" class="input-control" style="width: 100%; margin-top: 4px;" placeholder="e.g. Cash payment, bill adjustment">
        </div>
        <div id="editKhataInvoiceLinkRow" style="display: none; background: #f8fafc; border: 1px solid var(--slate-200); border-radius: 8px; padding: 10px; font-size: 12px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 700; color: var(--primary);">🧾 Linked Bill: <span id="editKhataInvIdText">#000</span></span>
            <button type="button" class="btn btn-light" style="padding: 2px 8px; font-size: 11px; border: 1px solid var(--slate-300);" onclick="app.viewLinkedInvoiceFromEditModal()">View Full Bill ➔</button>
          </div>
          <div id="editKhataInvItemsText" style="color: var(--slate-600); font-size: 11px; margin-top: 4px; line-height: 1.3;"></div>
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; border-top: 1px solid var(--slate-200); padding-top: 12px;">
        <button class="btn btn-danger" onclick="app.deleteKhataEntryFromEditModal()">🗑️ Delete Entry</button>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-light" onclick="app.closeModals()">Cancel</button>
          <button class="btn btn-primary" onclick="app.saveEditedKhataEntry()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="productModal">
    <div class="modal-card">
      <h3 style="margin-bottom: 12px;" id="prodModalTitle">Product Details</h3>
      <input type="hidden" id="prodEditId">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <label class="stat-label">Product Name</label>
        <input type="text" id="prodNameInput" class="input-control">
        <label class="stat-label">Price (₹)</label>
        <input type="number" id="prodPriceInput" class="input-control">
        <label class="stat-label">Stock Quantity</label>
        <input type="number" id="prodStockInput" class="input-control">
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <button class="btn btn-light" onclick="app.closeModals()">Cancel</button>
        <button class="btn btn-primary" onclick="app.saveProduct()">Save Product</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="customerModal">
    <div class="modal-card">
      <h3 style="margin-bottom: 12px;" id="custModalTitle">Customer Profile</h3>
      <input type="hidden" id="custEditId">
      <input type="hidden" id="custReturnToPos" value="false">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <label class="stat-label">Full Name</label>
        <input type="text" id="custNameInput" class="input-control" placeholder="e.g. Rahul Sharma">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
          <div>
            <label class="stat-label">Phone Number</label>
            <input type="text" id="custPhoneInput" class="input-control" style="width: 100%;" placeholder="e.g. 9876543210">
          </div>
          <div>
            <label class="stat-label">Email Address (Optional)</label>
            <input type="email" id="custEmailInput" class="input-control" style="width: 100%;" placeholder="e.g. rahul@example.com">
          </div>
        </div>

        <label class="stat-label">Full Address</label>
        <textarea id="custAddressInput" class="input-control" rows="2" placeholder="e.g. 12 Market Street, Mumbai"></textarea>
        
        <label class="stat-label">GST / PAN (Optional)</label>
        <input type="text" id="custGstInput" class="input-control" placeholder="e.g. 27AAAAA0000A1Z5">
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 16px; border-top: 1px solid var(--slate-200); padding-top: 12px;">
        <button type="button" class="btn btn-danger" id="custModalDeleteBtn" style="display: none;" onclick="app.deleteCustomerFromModal()">🗑️ Delete Customer</button>
        <div style="display: flex; gap: 8px; margin-left: auto;">
          <button type="button" class="btn btn-light" onclick="app.closeModals()">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="app.saveCustomer()">Save Customer</button>
        </div>
      </div>
    </div>
  </div>

  <div id="printable-invoice" class="print-section" style="font-family: monospace; font-size: 12px; color: #000;">
    <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 12px;">
      <h2 id="prtStoreName" style="margin: 0; text-transform: uppercase; font-size: 16px; font-weight: bold;">Vyaparify Retail</h2>
      <p id="prtTagline" style="margin: 2px 0; font-style: italic; font-size: 11px;"></p>
      <p id="prtAddress" style="margin: 2px 0; font-size: 12px; font-weight: 500;"></p>
      <p id="prtPhoneEmail" style="margin: 2px 0; font-size: 11px;"></p>
      <p id="prtGstFssai" style="margin: 2px 0; font-size: 11px; font-weight: bold;"></p>
      <div style="border-top: 1px solid #000; margin-top: 6px; padding-top: 4px; display: flex; justify-content: space-between;">
        <span id="prtBillId" style="font-weight: bold;">Bill ID: -</span>
        <span id="prtBillDate">Date & Time: -</span>
      </div>
    </div>
    <div style="margin-bottom: 12px; line-height: 1.5; border-bottom: 1px solid #000; padding-bottom: 6px;">
      <p style="margin: 2px 0;"><strong>Customer:</strong> <span id="prtCustName">Walk-in</span></p>
      <p id="prtCustPhoneRow" style="margin: 2px 0;"><strong>Phone:</strong> <span id="prtCustPhone">-</span></p>
      <p id="prtCustEmailRow" style="margin: 2px 0;"><strong>Email:</strong> <span id="prtCustEmail">-</span></p>
      <p id="prtCustAddressRow" style="margin: 2px 0;"><strong>Address:</strong> <span id="prtCustAddress">-</span></p>
      <p style="margin: 2px 0;"><strong>Payment Mode:</strong> <span id="prtPayMode">Cash</span></p>
    </div>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
      <thead>
        <tr style="border-bottom: 2px solid #000;">
          <th style="text-align: left; padding: 4px 0;">Item</th>
          <th style="text-align: center; padding: 4px 0;">Qty</th>
          <th style="text-align: right; padding: 4px 0;">Price</th>
          <th style="text-align: right; padding: 4px 0;">Total</th>
        </tr>
      </thead>
      <tbody id="prtItemsBody"></tbody>
    </table>
    <div style="text-align: right; border-top: 2px solid #000; padding-top: 8px; font-weight: bold; font-size: 14px;">
      Grand Total: <span id="prtGrandTotal">₹0.00</span>
    </div>
    <div style="text-align: center; margin-top: 20px; border-top: 1px dashed #000; padding-top: 8px; font-size: 10px;">
      Thank You for Shopping With Us! Visit Again!
    </div>
  </div>

  <div id="printable-statement" class="print-section" style="font-family: monospace; font-size: 12px; color: #000;">
    <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 12px;">
      <h2 id="prtStmtStoreName" style="margin: 0; text-transform: uppercase; font-size: 16px; font-weight: bold;">Vyaparify Retail</h2>
      <p id="prtStmtStoreInfo" style="margin: 2px 0; font-size: 11px;"></p>
      <h3 style="margin: 8px 0 0 0; text-decoration: underline; font-size: 14px;">KHATA ACCOUNT STATEMENT</h3>
    </div>
    <div id="prtStmtCustInfo" style="margin-bottom: 12px; line-height: 1.5; border-bottom: 1px solid #000; padding-bottom: 6px;"></div>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
      <thead>
        <tr style="border-bottom: 2px solid #000;">
          <th style="text-align: left; padding: 4px 0;">Date & Time</th>
          <th style="text-align: left; padding: 4px 0;">Description / Bill #</th>
          <th style="text-align: right; padding: 4px 0;">Debit (Due)</th>
          <th style="text-align: right; padding: 4px 0;">Credit (Paid)</th>
        </tr>
      </thead>
      <tbody id="prtStmtRows"></tbody>
    </table>
    <div id="prtStmtBalanceSummary" style="text-align: right; border-top: 2px solid #000; padding-top: 8px; font-weight: bold; font-size: 14px;"></div>
  </div>

  <div id="printable-report" class="print-section" style="font-family: monospace; font-size: 12px; color: #000;">
    <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 12px;">
      <h2 id="prtRptStoreName" style="margin: 0; text-transform: uppercase; font-size: 16px; font-weight: bold;">Vyaparify Retail</h2>
      <p id="prtRptStoreInfo" style="margin: 2px 0; font-size: 11px;"></p>
      <h3 id="prtRptTitle" style="margin: 8px 0 0 0; text-decoration: underline; font-size: 14px;">BUSINESS REPORT</h3>
      <p id="prtRptPeriod" style="margin: 2px 0; font-size: 11px; color: #333;"></p>
    </div>
    <div id="prtRptKpis" style="display: flex; justify-content: space-around; border-bottom: 1px dashed #000; padding-bottom: 8px; margin-bottom: 12px; font-weight: bold; flex-wrap: wrap; gap: 8px;"></div>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
      <thead id="prtRptTableHead"></thead>
      <tbody id="prtRptTableBody"></tbody>
    </table>
  </div>

  <!-- Floating Bottom Mobile Cart Summary Pill -->
  <div id="mobileCartFloatingBar" class="mobile-cart-bar" style="display: none;" onclick="app.scrollToCartOnMobile()">
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 20px;">🛒</span>
      <div>
        <div id="mobCartCount" style="font-size: 11px; opacity: 0.9;">0 Items in Cart</div>
        <div id="mobCartTotal" style="font-size: 15px; font-weight: 800;">₹0.00</div>
      </div>
    </div>
    <span style="background: rgba(255,255,255,0.2); padding: 5px 12px; border-radius: var(--radius-full); font-size: 12px; font-weight: 700;">Proceed to Pay ➔</span>
  </div>

  <!-- Mobile Bottom Navigation Bar -->
  <nav class="mobile-bottom-nav">
    <button class="mob-nav-btn active" id="mobTabDashboard" onclick="app.switchTab('dashboard', null, true)">
      <span class="mob-icon">📊</span>
      <span>Dashboard</span>
    </button>
    <button class="mob-nav-btn" id="mobTabBilling" onclick="app.switchTab('billing', null, true)">
      <span class="mob-icon">🛒</span>
      <span>POS</span>
    </button>
    <button class="mob-nav-btn" id="mobTabInvoices" onclick="app.switchTab('invoices', null, true)">
      <span class="mob-icon">📄</span>
      <span>Invoices</span>
    </button>
    <button class="mob-nav-btn" id="mobTabLedger" onclick="app.switchTab('ledger', null, true)">
      <span class="mob-icon">📒</span>
      <span>Khata</span>
    </button>
    <button class="mob-nav-btn" onclick="app.toggleMobileMenu()">
      <span class="mob-icon">☰</span>
      <span>More</span>
    </button>
  </nav>

  <!-- Interactive Master PIN Fullscreen Lock Modal -->
  <div class="modal-backdrop" id="appLockModal" style="z-index: 999999; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); background: rgba(15, 23, 42, 0.88);">
    <div class="modal-card" style="max-width: 380px; text-align: center; border-radius: 24px; padding: 28px 24px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); background: #ffffff;">
      <div style="width: 54px; height: 54px; margin: 0 auto 12px; background: var(--primary-gradient); color: #fff; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: 0 10px 20px rgba(79, 70, 229, 0.35);">
        🔒
      </div>
      <h3 style="margin: 0; font-size: 19px; color: var(--slate-900); font-weight: 800;" id="appLockStoreTitle">Vyaparify Pro</h3>
      <p style="font-size: 13px; color: var(--slate-500); margin: 4px 0 16px;">App Screen is Locked. Enter Master PIN:</p>
      
      <!-- PIN Dots Display -->
      <div id="pinDotsContainer" class="pin-dots" style="display: flex; justify-content: center; gap: 14px; margin-bottom: 20px;">
        <span class="pin-dot"></span>
        <span class="pin-dot"></span>
        <span class="pin-dot"></span>
        <span class="pin-dot"></span>
      </div>

      <div id="lockErrorMsg" style="min-height: 20px; font-size: 12px; color: var(--red); font-weight: 600; margin-bottom: 12px;"></div>

      <!-- Numeric Touch Keypad -->
      <div class="keypad-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 290px; margin: 0 auto;">
        <button class="keypad-btn" onclick="app.pressPinKey('1')">1</button>
        <button class="keypad-btn" onclick="app.pressPinKey('2')">2</button>
        <button class="keypad-btn" onclick="app.pressPinKey('3')">3</button>
        <button class="keypad-btn" onclick="app.pressPinKey('4')">4</button>
        <button class="keypad-btn" onclick="app.pressPinKey('5')">5</button>
        <button class="keypad-btn" onclick="app.pressPinKey('6')">6</button>
        <button class="keypad-btn" onclick="app.pressPinKey('7')">7</button>
        <button class="keypad-btn" onclick="app.pressPinKey('8')">8</button>
        <button class="keypad-btn" onclick="app.pressPinKey('9')">9</button>
        <button class="keypad-btn keypad-fn" onclick="app.clearPinKey()">Clear</button>
        <button class="keypad-btn" onclick="app.pressPinKey('0')">0</button>
        <button class="keypad-btn keypad-fn" onclick="app.backspacePinKey()">⌫</button>
      </div>

      <div style="margin-top: 14px; font-size: 11px; color: var(--slate-400);">
        Physical keyboard supported (0-9, Backspace, Esc)
      </div>

      <div style="margin-top: 14px; display: flex; justify-content: center;">
        <button type="button" class="btn btn-light" style="font-size: 11.5px; padding: 5px 14px; border-radius: var(--radius-full); background: rgba(255,255,255,0.9); border: 1px solid var(--slate-300); font-weight: 600;" onclick="app.openForgotPinModal()">
          🔑 Forgot Master PIN?
        </button>
      </div>
    </div>
  </div>

  <!-- Sensitive Action PIN Authorization Prompt Modal -->
  <div class="modal-backdrop" id="pinAuthModal" style="z-index: 10000; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
    <div class="modal-card" style="max-width: 380px; text-align: center;">
      <div style="font-size: 32px; margin-bottom: 8px;">🛡️</div>
      <h3 style="margin: 0; font-size: 17px;" id="pinAuthTitle">Security Verification</h3>
      <p style="font-size: 13px; color: var(--slate-600); margin: 6px 0 16px;" id="pinAuthDesc">Enter your Master PIN to authorize this sensitive action:</p>
      
      <input type="password" id="pinAuthInput" class="input-control" maxlength="6" inputmode="numeric" style="text-align: center; font-size: 22px; letter-spacing: 8px; font-weight: 800; padding: 10px; width: 180px; margin: 0 auto 12px; display: block;" placeholder="••••" onkeydown="if(event.key==='Enter') app.verifyPinAuth()">
      <div id="pinAuthError" style="font-size: 12px; color: var(--red); font-weight: 600; min-height: 18px; margin-bottom: 12px;"></div>

      <div style="display: flex; justify-content: center; gap: 8px;">
        <button class="btn btn-light" onclick="app.closePinAuthModal()">Cancel</button>
        <button class="btn btn-primary" onclick="app.verifyPinAuth()">Authorize</button>
      </div>

      <div style="margin-top: 12px; font-size: 11.5px;">
        <a href="javascript:void(0)" onclick="app.closePinAuthModal(); app.openForgotPinModal();" style="color: var(--primary); text-decoration: underline; font-weight: 600;">Forgot Master PIN? Recover Account</a>
      </div>
    </div>
  </div>

  <!-- Master PIN Recovery Modal -->
  <div class="modal-backdrop" id="forgotPinModal" style="z-index: 1000000;">
    <div class="modal-card" style="max-width: 440px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3 style="margin: 0; display: flex; align-items: center; gap: 8px; font-size: 17px;">
          <span>🔑</span> <span>Recover Master Security PIN</span>
        </h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeForgotPinModal()">✕</button>
      </div>

      <p style="font-size: 12px; color: var(--slate-600); margin-bottom: 14px; line-height: 1.5;">
        Verify ownership using your 12-character Emergency Recovery Key or registered Store Owner phone to set a new PIN.
      </p>

      <div style="display: flex; gap: 6px; margin-bottom: 14px;">
        <button type="button" class="btn btn-primary" id="recTabKeyBtn" style="flex: 1; font-size: 11.5px; padding: 6px;" onclick="app.switchRecoveryTab('key')">Emergency Key</button>
        <button type="button" class="btn btn-light" id="recTabStoreBtn" style="flex: 1; font-size: 11.5px; padding: 6px;" onclick="app.switchRecoveryTab('store')">Store Owner Phone</button>
      </div>

      <!-- Tab 1: Emergency Recovery Key -->
      <div id="recoveryTabKey">
        <label class="stat-label">Enter 12-Character Emergency Key</label>
        <input type="text" id="recoverKeyInput" class="input-control" placeholder="e.g. VYAPAR-7K9M-3P2W" style="margin-top: 4px; font-family: monospace; font-size: 14px; text-transform: uppercase;">
        <small style="color: var(--slate-500); font-size: 11px; display: block; margin-top: 4px;">This key was displayed and saved when your PIN was first created.</small>
      </div>

      <!-- Tab 2: Store Owner Phone Verification -->
      <div id="recoveryTabStore" style="display: none;">
        <label class="stat-label">Registered Store Owner Phone Number</label>
        <input type="text" id="recoverStorePhoneInput" class="input-control" placeholder="Phone matching Shop Details profile" style="margin-top: 4px; font-size: 14px;">
        <small style="color: var(--slate-500); font-size: 11px; display: block; margin-top: 4px;">Must match the registered phone in Shop Details (<span id="recShopPhoneHint">••••</span>).</small>
      </div>

      <div style="margin-top: 14px; border-top: 1px dashed var(--slate-200); padding-top: 12px;">
        <label class="stat-label">Enter New 4 to 6-Digit Master PIN</label>
        <input type="password" id="recoverNewPin" class="input-control" maxlength="6" inputmode="numeric" placeholder="New PIN (e.g. 1234)" style="margin-top: 4px; letter-spacing: 2px;">
        <input type="password" id="recoverConfirmPin" class="input-control" maxlength="6" inputmode="numeric" placeholder="Confirm New PIN" style="margin-top: 6px; letter-spacing: 2px;">
      </div>

      <div id="recoveryErrorMsg" style="font-size: 12px; color: var(--red); font-weight: 600; min-height: 18px; margin-top: 8px;"></div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; border-top: 1px solid var(--slate-200); padding-top: 12px;">
        <button type="button" class="btn btn-light" onclick="app.closeForgotPinModal()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="app.submitPinRecovery()">Verify & Reset PIN</button>
      </div>

      <!-- Browser Console Emergency Tip -->
      <div style="margin-top: 12px; background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: 8px; padding: 8px 10px; font-size: 11px; color: var(--slate-600); line-height: 1.4;">
        💡 <strong>Owner Emergency Tip:</strong> If locked out on your own device without recovery keys, open browser DevTools (<kbd>F12</kbd> ➔ Console) and run:
        <code style="display:block; background:#fff; padding:4px; border-radius:4px; margin-top:3px; color:#b91c1c; font-weight:bold;">localStorage.removeItem('vy_security'); location.reload();</code>
        This safely clears only the screen lock without losing any invoices, customers, or stock records.
      </div>
    </div>
  </div>

  <!-- Master PIN Setup / Configure Modal -->
  <div class="modal-backdrop" id="masterPinSetupModal">
    <div class="modal-card" style="max-width: 440px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--slate-200); padding-bottom: 8px;">
        <h3 style="margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>🛡️</span> <span id="pinSetupModalTitle">Setup Master Security PIN</span>
        </h3>
        <button class="btn btn-light" style="padding: 2px 8px;" onclick="app.closeModals()">✕</button>
      </div>

      <p style="font-size: 12.5px; color: var(--slate-600); margin-bottom: 14px; line-height: 1.5;">
        Protects cash registers, bill deletions, khata records, and database resets with encrypted Master PIN authentication.
      </p>

      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div id="currentPinGroup" style="display: none;">
          <label class="stat-label">Current Master PIN</label>
          <input type="password" id="setupCurrentPin" class="input-control" maxlength="6" inputmode="numeric" placeholder="Enter current PIN" style="margin-top: 4px;">
        </div>

        <div>
          <label class="stat-label">New 4 to 6-Digit Master PIN</label>
          <input type="password" id="setupNewPin" class="input-control" maxlength="6" inputmode="numeric" placeholder="e.g. 1234 or 987654" style="margin-top: 4px; font-size: 16px; letter-spacing: 2px;">
        </div>

        <div>
          <label class="stat-label">Confirm New Master PIN</label>
          <input type="password" id="setupConfirmPin" class="input-control" maxlength="6" inputmode="numeric" placeholder="Re-enter new PIN" style="margin-top: 4px; font-size: 16px; letter-spacing: 2px;">
        </div>

        <!-- Emergency Recovery Key Card -->
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 12px; margin-top: 2px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label class="stat-label" style="color: #92400e; margin: 0; font-weight: 700;">🔑 Emergency Recovery Key</label>
            <button type="button" class="btn btn-light" style="padding: 2px 8px; font-size: 11px; background: #fff;" onclick="app.copyEmergencyKey()">📋 Copy</button>
          </div>
          <div id="setupRecoveryKeyDisplay" style="font-family: monospace; font-size: 15px; font-weight: 800; color: #78350f; letter-spacing: 1px; margin-top: 4px;">VYAPAR-XXXX-XXXX</div>
          <small style="color: #92400e; font-size: 11px; display: block; margin-top: 2px;">Save this 12-character key safely. If you ever forget your Master PIN, use this key to unlock and reset immediately.</small>
        </div>

        <div>
          <label class="stat-label">Auto-Lock Inactivity Timeout</label>
          <select id="setupAutoLockSelect" class="select-control" style="width: 100%; margin-top: 4px;">
            <option value="1">1 Minute (High Security)</option>
            <option value="5" selected>5 Minutes (Recommended)</option>
            <option value="15">15 Minutes</option>
            <option value="30">30 Minutes</option>
            <option value="0">Disabled (Lock Manually Only)</option>
          </select>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 18px; border-top: 1px solid var(--slate-200); padding-top: 14px;">
        <button type="button" class="btn btn-danger" id="disablePinBtn" style="display: none;" onclick="app.disableMasterPin()">Disable PIN</button>
        <div style="display: flex; gap: 8px; margin-left: auto;">
          <button type="button" class="btn btn-light" onclick="app.closeModals()">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="app.saveMasterPinSetup()">Save Security PIN</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    class BusinessEngine {
      constructor() {
        this.dirHandle = null;
        const nowIso = new Date().toISOString();
        
        this.shop = this.loadLocal('vy_shop', {
          name: 'My Retail Store',
          phone: '+91 9876543210',
          email: 'store@example.com',
          address: '123 Market Street, City Center',
          gst: '27AABCU9603R1ZM',
          fssai: '12345678901234',
          tagline: 'Quality Products at Best Prices'
        });
        this.emailSettings = this.loadLocal('vy_emailjs', { toEmail: '', publicKey: '', serviceId: '', templateId: '' });
        this.products = this.loadLocal('vy_products', [
          { id: '1', name: 'Basmati Rice 5kg', price: 450, stock: 25, updatedAt: nowIso },
          { id: '2', name: 'Sunflower Oil 1L', price: 140, stock: 40, updatedAt: nowIso },
          { id: '3', name: 'Wheat Flour 10kg', price: 380, stock: 15, updatedAt: nowIso }
        ]);
        this.customers = this.loadLocal('vy_customers', [
          { id: '1', name: 'Rahul Sharma', phone: '9876543210', email: 'rahul@example.com', address: '12 Market Street, Mumbai', gst: '27AAAAA0000A1Z5', createdAt: nowIso },
          { id: '2', name: 'Anita Verma', phone: '9123456789', email: 'anita@example.com', address: '45 Connaught Place, Delhi', gst: '07BBBBB1111B1Z2', createdAt: nowIso }
        ]);
        this.invoices = this.loadLocal('vy_invoices', []);
        this.ledger = this.loadLocal('vy_ledger', []);
        this.autoBackups = this.loadLocal('vy_autobackups', []);

        this.cart = [];
        this.selectedCustomer = null;
        this.sortState = { key: '', asc: true };
        this.activePreviewInvoice = null;
        this.tempEditItems = [];
        this.currentStatementCustomer = null;

        // Device identification for multi-device sync
        this.deviceId = this.loadLocal('vy_device_id', 'dev_' + Math.random().toString(36).substring(2, 10));
        this.saveLocal('vy_device_id', this.deviceId);
        this.deviceName = this.loadLocal('vy_device_name', '');
        if (!this.deviceName) {
          const devSuffix = this.deviceId.replace('dev_', '').substring(0, 3).toUpperCase();
          this.deviceName = 'Counter ' + devSuffix;
          this.saveLocal('vy_device_name', this.deviceName);
        }
        // Multi-device Deletion Tombstones Registry (prevents deleted items resurrecting)
        this.deletedIds = this.loadLocal('vy_deleted_ids', { products: {}, invoices: {}, ledger: {}, customers: {} });
        if (!this.deletedIds.products) this.deletedIds.products = {};
        if (!this.deletedIds.invoices) this.deletedIds.invoices = {};
        if (!this.deletedIds.ledger) this.deletedIds.ledger = {};
        if (!this.deletedIds.customers) this.deletedIds.customers = {};
        this.cloudSyncVersion = Number(this.loadLocal('vy_cloud_version', 0));
        this.lastCloudSyncTime = this.loadLocal('vy_cloud_last_sync', '');
        this.cloudSyncError = false;

        // Google Drive Configuration
        this.gdriveConfig = this.loadLocal('vy_gdrive_config', {
          connected: false,
          mode: 'oauth',
          clientId: '',
          email: '',
          token: '',
          tokenExpires: 0,
          fileId: null,
          scriptUrl: '',
          autoSync: true,
          autoPull: true
        });

        this.syncDebounceTimer = null;
        this.toastTimer = null;
        this.pendingWhatsAppAction = null;

        // Security & Screen Lock configuration
        this.security = this.loadLocal('vy_security', {
          enabled: false,
          pinHash: '',
          recoveryKey: '',
          autoLockMinutes: 5,
          protectSensitive: true,
          lastActive: Date.now()
        });
        if (this.security.enabled && !this.security.recoveryKey) {
          this.security.recoveryKey = this.generateRecoveryKey();
          this.saveLocal('vy_security', this.security);
        }
        this.isAppLocked = false;
        this.currentPinInput = '';
        this.pendingPinAuthAction = null;
        this.failedUnlockAttempts = 0;
        this.lockoutUntil = 0;
        this.currentRecoveryTab = 'key';

        window.addEventListener('keydown', (e) => {
          if (e.key === 'F2') { e.preventDefault(); this.startNewSale(); }
          if (e.key === 'Escape') this.closeModals();
        });

        window.onafterprint = () => { document.body.className = ''; };

        // Auto-check for remote changes from other devices on window focus
        window.addEventListener('focus', () => {
          if (this.gdriveConfig && this.gdriveConfig.connected && this.gdriveConfig.autoPull) {
            this.checkRemoteChanges();
          }
        });

        // Periodic background multi-device sync poll (every 45s)
        setInterval(() => {
          if (this.gdriveConfig && this.gdriveConfig.connected && this.gdriveConfig.autoPull) {
            this.checkRemoteChanges();
          }
        }, 45000);

        this.setupSecurityListeners();
        this.initAsync();
      }

      loadLocal(key, fallback) {
        try {
          const val = localStorage.getItem(key);
          return val ? JSON.parse(val) : fallback;
        } catch { return fallback; }
      }

      saveLocal(key, val) {
        localStorage.setItem(key, JSON.stringify(val));
      }

      trackDeletion(type, id) {
        if (!type || !id) return;
        const strId = String(id);
        if (!this.deletedIds) this.deletedIds = { products: {}, invoices: {}, ledger: {}, customers: {} };
        if (!this.deletedIds[type]) this.deletedIds[type] = {};
        this.deletedIds[type][strId] = Date.now();
        this.saveLocal('vy_deleted_ids', this.deletedIds);
      }

      async initAsync() {
        // Attempt to restore directory handle if granted previously in session storage
        try {
          const storedHandle = window.sessionStorage.getItem('vy_dir_connected');
          if (storedHandle === 'true' && window.showDirectoryPicker) {
            // Note: browsers require user activation for directory picker
          }
        } catch(e) {}

        this.syncShopHeader();
        this.syncEmailInputs();
        this.syncGdriveInputs();
        this.updateGdriveUI();
        this.updateSecurityUI();
        this.checkAutoBackup();
        this.renderDashboard();
        this.renderInventory();
        this.renderInvoices();
        this.renderLedger();
        this.renderCustomers();
        this.renderPosProducts();
        this.renderAutoBackupList();
        this.setReportPreset('today');

        // Check remote cloud updates on startup if connected
        if (this.gdriveConfig && this.gdriveConfig.connected) {
          this.checkRemoteChanges();
        }
      }

      escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      setupSecurityListeners() {
        const resetActivity = () => {
          if (this.security) this.security.lastActive = Date.now();
        };
        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(evt => {
          window.addEventListener(evt, resetActivity, { passive: true });
        });

        setInterval(() => {
          if (!this.isAppLocked && this.security && this.security.enabled && this.security.autoLockMinutes > 0) {
            const elapsedMins = (Date.now() - (this.security.lastActive || Date.now())) / 60000;
            if (elapsedMins >= this.security.autoLockMinutes) {
              this.lockApp('Inactivity Timeout');
            }
          }
        }, 10000);

        window.addEventListener('keydown', (e) => {
          const lockModal = document.getElementById('appLockModal');
          if (lockModal && lockModal.classList.contains('active')) {
            if (/^[0-9]$/.test(e.key)) {
              this.pressPinKey(e.key);
            } else if (e.key === 'Backspace') {
              this.backspacePinKey();
            } else if (e.key === 'Escape' || e.key === 'Delete') {
              this.clearPinKey();
            }
          }
        });
      }

      async hashPin(pin) {
        if (!window.crypto || !window.crypto.subtle) {
          let hash = 0;
          for (let i = 0; i < pin.length; i++) {
            hash = ((hash << 5) - hash) + pin.charCodeAt(i);
            hash |= 0;
          }
          return 'legacy_' + Math.abs(hash);
        }
        try {
          const encoder = new TextEncoder();
          const data = encoder.encode('vy_salt_2026_' + pin);
          const hashBuf = await window.crypto.subtle.digest('SHA-256', data);
          const hashArr = Array.from(new Uint8Array(hashBuf));
          return hashArr.map(b => b.toString(16).padStart(2, '0')).join('');
        } catch (e) {
          return 'fallback_' + pin;
        }
      }

      lockApp(reason = 'Manual Lock') {
        if (!this.security || !this.security.enabled) {
          this.openMasterPinSetupModal();
          this.showToast('ℹ️ Setup a Master PIN to protect your cash counter screen.', 'info');
          return;
        }
        this.isAppLocked = true;
        this.currentPinInput = '';
        this.updatePinDotsUI();
        const errEl = document.getElementById('lockErrorMsg');
        if (errEl) errEl.innerText = '';
        const titleEl = document.getElementById('appLockStoreTitle');
        if (titleEl) titleEl.innerText = this.shop.name || 'Vyaparify Pro';

        if (Date.now() < this.lockoutUntil) {
          const remSec = Math.ceil((this.lockoutUntil - Date.now()) / 1000);
          if (errEl) errEl.innerText = `Too many failed attempts. Try again in ${remSec}s.`;
        }

        document.getElementById('appLockModal').classList.add('active');
        this.showToast('🔒 Screen locked.', 'info');
      }

      pressPinKey(digit) {
        if (Date.now() < this.lockoutUntil) {
          const remSec = Math.ceil((this.lockoutUntil - Date.now()) / 1000);
          const errEl = document.getElementById('lockErrorMsg');
          if (errEl) errEl.innerText = `Too many failed attempts. Try again in ${remSec}s.`;
          return;
        }
        if (this.currentPinInput.length < 6) {
          this.currentPinInput += String(digit);
          this.updatePinDotsUI();
          if (this.currentPinInput.length >= 4) {
            this.attemptUnlock();
          }
        }
      }

      backspacePinKey() {
        if (this.currentPinInput.length > 0) {
          this.currentPinInput = this.currentPinInput.slice(0, -1);
          this.updatePinDotsUI();
          const errEl = document.getElementById('lockErrorMsg');
          if (errEl) errEl.innerText = '';
        }
      }

      clearPinKey() {
        this.currentPinInput = '';
        this.updatePinDotsUI();
        const errEl = document.getElementById('lockErrorMsg');
        if (errEl) errEl.innerText = '';
      }

      updatePinDotsUI() {
        const dots = document.querySelectorAll('#pinDotsContainer .pin-dot');
        dots.forEach((dot, idx) => {
          if (idx < this.currentPinInput.length) {
            dot.classList.add('filled');
          } else {
            dot.classList.remove('filled');
          }
        });
      }

      async attemptUnlock() {
        const enteredHash = await this.hashPin(this.currentPinInput);
        if (enteredHash === this.security.pinHash) {
          this.isAppLocked = false;
          this.currentPinInput = '';
          this.failedUnlockAttempts = 0;
          this.security.lastActive = Date.now();
          document.getElementById('appLockModal').classList.remove('active');
          this.showToast('🔓 Screen unlocked successfully!', 'success');
        } else if (this.currentPinInput.length >= 6) {
          this.failedUnlockAttempts++;
          const errEl = document.getElementById('lockErrorMsg');
          if (this.failedUnlockAttempts >= 5) {
            this.lockoutUntil = Date.now() + 30000;
            if (errEl) errEl.innerText = 'Too many failed attempts! Locked for 30 seconds.';
          } else {
            if (errEl) errEl.innerText = `Incorrect PIN (${5 - this.failedUnlockAttempts} attempts remaining)`;
          }
          this.currentPinInput = '';
          setTimeout(() => this.updatePinDotsUI(), 250);
        }
      }

      async requestSecurityAuthorization(actionDesc, onAuthorized) {
        if (!this.security || !this.security.enabled || !this.security.protectSensitive) {
          onAuthorized();
          return;
        }
        this.pendingPinAuthAction = onAuthorized;
        const descEl = document.getElementById('pinAuthDesc');
        if (descEl) descEl.innerText = `Enter Master PIN to authorize: ${actionDesc}`;
        const inputEl = document.getElementById('pinAuthInput');
        if (inputEl) inputEl.value = '';
        const errEl = document.getElementById('pinAuthError');
        if (errEl) errEl.innerText = '';
        document.getElementById('pinAuthModal').classList.add('active');
        setTimeout(() => { if (inputEl) inputEl.focus(); }, 150);
      }

      async verifyPinAuth() {
        const entered = document.getElementById('pinAuthInput').value.trim();
        if (!entered) return;
        const enteredHash = await this.hashPin(entered);
        if (enteredHash === this.security.pinHash) {
          document.getElementById('pinAuthModal').classList.remove('active');
          if (typeof this.pendingPinAuthAction === 'function') {
            const action = this.pendingPinAuthAction;
            this.pendingPinAuthAction = null;
            action();
          }
        } else {
          document.getElementById('pinAuthError').innerText = '❌ Incorrect Master PIN. Authorization denied.';
        }
      }

      closePinAuthModal() {
        this.pendingPinAuthAction = null;
        document.getElementById('pinAuthModal').classList.remove('active');
      }

      generateRecoveryKey() {
        const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
        const pick = (len) => Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join('');
        return `VYAPAR-${pick(4)}-${pick(4)}`;
      }

      openMasterPinSetupModal() {
        const isConfigured = Boolean(this.security && this.security.enabled && this.security.pinHash);
        document.getElementById('pinSetupModalTitle').innerText = isConfigured ? 'Modify Master Security PIN' : 'Setup Master Security PIN';
        document.getElementById('currentPinGroup').style.display = isConfigured ? 'block' : 'none';
        document.getElementById('disablePinBtn').style.display = isConfigured ? 'inline-block' : 'none';
        document.getElementById('setupCurrentPin').value = '';
        document.getElementById('setupNewPin').value = '';
        document.getElementById('setupConfirmPin').value = '';
        document.getElementById('setupAutoLockSelect').value = String(this.security ? this.security.autoLockMinutes : 5);

        // Display or prepare Recovery Key
        if (!this.security || !this.security.recoveryKey) {
          this.temporaryRecoveryKey = this.generateRecoveryKey();
        } else {
          this.temporaryRecoveryKey = this.security.recoveryKey;
        }
        const keyDisplay = document.getElementById('setupRecoveryKeyDisplay');
        if (keyDisplay) keyDisplay.innerText = this.temporaryRecoveryKey;

        document.getElementById('masterPinSetupModal').classList.add('active');
      }

      copyEmergencyKey() {
        const key = this.temporaryRecoveryKey || (this.security && this.security.recoveryKey) || '';
        if (!key) return;
        navigator.clipboard.writeText(key).then(() => {
          this.showToast('📋 Emergency Key copied to clipboard!', 'success');
        }).catch(() => {
          prompt('Copy Emergency Recovery Key:', key);
        });
      }

      async saveMasterPinSetup() {
        const isConfigured = Boolean(this.security && this.security.enabled && this.security.pinHash);
        const current = document.getElementById('setupCurrentPin').value.trim();
        const newPin = document.getElementById('setupNewPin').value.trim();
        const confirmPin = document.getElementById('setupConfirmPin').value.trim();
        const autoLock = Number(document.getElementById('setupAutoLockSelect').value);

        if (isConfigured) {
          const currentHash = await this.hashPin(current);
          if (currentHash !== this.security.pinHash) {
            return alert('Current Master PIN is incorrect.');
          }
        }

        if (!/^\d{4,6}$/.test(newPin)) {
          return alert('Please enter a 4 to 6 digit numeric PIN.');
        }

        if (newPin !== confirmPin) {
          return alert('New PIN and Confirm PIN do not match.');
        }

        const newHash = await this.hashPin(newPin);
        const recoveryKey = this.temporaryRecoveryKey || (this.security && this.security.recoveryKey) || this.generateRecoveryKey();
        this.security = {
          enabled: true,
          pinHash: newHash,
          recoveryKey: recoveryKey,
          autoLockMinutes: autoLock,
          protectSensitive: true,
          lastActive: Date.now()
        };
        this.saveLocal('vy_security', this.security);
        this.closeModals();
        this.updateSecurityUI();
        this.showToast('🛡️ Master Security PIN configured successfully!', 'success');
      }

      openForgotPinModal() {
        const modal = document.getElementById('forgotPinModal');
        if (!modal) return;
        document.getElementById('recoverKeyInput').value = '';
        document.getElementById('recoverStorePhoneInput').value = '';
        document.getElementById('recoverNewPin').value = '';
        document.getElementById('recoverConfirmPin').value = '';
        document.getElementById('recoveryErrorMsg').innerText = '';
        
        // Show masked phone hint
        const rawPhone = (this.shop && this.shop.phone) ? String(this.shop.phone).trim() : '';
        const phoneHint = rawPhone.length > 4 ? '••••••' + rawPhone.slice(-4) : 'registered store phone';
        const hintEl = document.getElementById('recShopPhoneHint');
        if (hintEl) hintEl.innerText = phoneHint;

        this.currentRecoveryTab = 'key';
        this.switchRecoveryTab('key');
        modal.classList.add('active');
      }

      closeForgotPinModal() {
        const modal = document.getElementById('forgotPinModal');
        if (modal) modal.classList.remove('active');
      }

      switchRecoveryTab(tab) {
        this.currentRecoveryTab = tab;
        const keyTab = document.getElementById('recoveryTabKey');
        const storeTab = document.getElementById('recoveryTabStore');
        const keyBtn = document.getElementById('recTabKeyBtn');
        const storeBtn = document.getElementById('recTabStoreBtn');

        if (tab === 'key') {
          if (keyTab) keyTab.style.display = 'block';
          if (storeTab) storeTab.style.display = 'none';
          if (keyBtn) { keyBtn.className = 'btn btn-primary'; }
          if (storeBtn) { storeBtn.className = 'btn btn-light'; }
        } else {
          if (keyTab) keyTab.style.display = 'none';
          if (storeTab) storeTab.style.display = 'block';
          if (keyBtn) { keyBtn.className = 'btn btn-light'; }
          if (storeBtn) { storeBtn.className = 'btn btn-primary'; }
        }
        const errEl = document.getElementById('recoveryErrorMsg');
        if (errEl) errEl.innerText = '';
      }

      async submitPinRecovery() {
        const errEl = document.getElementById('recoveryErrorMsg');
        const newPin = document.getElementById('recoverNewPin').value.trim();
        const confirmPin = document.getElementById('recoverConfirmPin').value.trim();

        if (!/^\d{4,6}$/.test(newPin)) {
          if (errEl) errEl.innerText = 'New PIN must be 4 to 6 numeric digits.';
          return;
        }
        if (newPin !== confirmPin) {
          if (errEl) errEl.innerText = 'New PIN and Confirm PIN do not match.';
          return;
        }

        let isVerified = false;
        if (this.currentRecoveryTab === 'key') {
          const enteredKey = document.getElementById('recoverKeyInput').value.trim().toUpperCase().replace(/[\s-]/g, '');
          const savedKey = (this.security && this.security.recoveryKey) ? this.security.recoveryKey.toUpperCase().replace(/[\s-]/g, '') : '';
          if (savedKey && enteredKey === savedKey) {
            isVerified = true;
          } else {
            if (errEl) errEl.innerText = '❌ Invalid Emergency Recovery Key. Please check the code.';
            return;
          }
        } else {
          const enteredPhone = document.getElementById('recoverStorePhoneInput').value.replace(/\D/g, '');
          const shopPhone = (this.shop && this.shop.phone) ? String(this.shop.phone).replace(/\D/g, '') : '';
          if (shopPhone && enteredPhone && (enteredPhone === shopPhone || shopPhone.endsWith(enteredPhone) || enteredPhone.endsWith(shopPhone))) {
            isVerified = true;
          } else {
            if (errEl) errEl.innerText = '❌ Phone number does not match registered Store Details.';
            return;
          }
        }

        if (isVerified) {
          const newHash = await this.hashPin(newPin);
          const newKey = this.generateRecoveryKey();
          this.security = {
            enabled: true,
            pinHash: newHash,
            recoveryKey: newKey,
            autoLockMinutes: (this.security && this.security.autoLockMinutes) || 5,
            protectSensitive: true,
            lastActive: Date.now()
          };
          this.saveLocal('vy_security', this.security);

          // Unlock app and reset attempts
          this.isAppLocked = false;
          this.failedUnlockAttempts = 0;
          this.lockoutUntil = 0;
          this.currentPinInput = '';

          document.getElementById('appLockModal')?.classList.remove('active');
          document.getElementById('pinAuthModal')?.classList.remove('active');
          this.closeForgotPinModal();
          this.updateSecurityUI();
          this.showToast(`🎉 Master PIN reset successfully! Screen unlocked. New recovery key: ${newKey}`, 'success');
        }
      }

      async disableMasterPin() {
        const current = document.getElementById('setupCurrentPin').value.trim();
        const currentHash = await this.hashPin(current);
        if (currentHash !== this.security.pinHash) {
          return alert('Enter your current Master PIN to disable protection.');
        }
        if (!confirm('Are you sure you want to disable Master PIN protection? Your screen and sensitive actions will be accessible without a PIN.')) return;

        this.security = {
          enabled: false,
          pinHash: '',
          autoLockMinutes: 0,
          protectSensitive: false,
          lastActive: Date.now()
        };
        this.saveLocal('vy_security', this.security);
        this.closeModals();
        this.updateSecurityUI();
        this.showToast('Master PIN disabled.', 'info');
      }

      updateSecurityUI() {
        const badge = document.getElementById('securityStatusBadge');
        const statusText = document.getElementById('secStatusText');
        const autoLockText = document.getElementById('secAutoLockText');
        const lockIcon = document.getElementById('headerLockIcon');

        if (this.security && this.security.enabled) {
          if (badge) {
            badge.className = 'badge badge-paid';
            badge.innerHTML = '🛡️ Protected (PIN Active)';
          }
          if (statusText) statusText.innerText = 'Master PIN Active';
          if (autoLockText) {
            autoLockText.innerText = this.security.autoLockMinutes > 0 ? `${this.security.autoLockMinutes} Min Timeout` : 'Manual Lock Only';
          }
          if (lockIcon) lockIcon.innerText = '🔒';
        } else {
          if (badge) {
            badge.className = 'badge';
            badge.style.background = 'var(--slate-200)';
            badge.style.color = 'var(--slate-700)';
            badge.innerText = 'Not Configured';
          }
          if (statusText) statusText.innerText = 'No PIN (Unprotected)';
          if (autoLockText) autoLockText.innerText = 'Disabled';
          if (lockIcon) lockIcon.innerText = '🔓';
        }
      }

      toggleInputMask(id, btn) {
        const inp = document.getElementById(id);
        if (!inp) return;
        if (inp.type === 'password') {
          inp.type = 'text';
          btn.innerText = '🔒';
        } else {
          inp.type = 'password';
          btn.innerText = '👁️';
        }
      }

      scrollToCartOnMobile() {
        const cartElem = document.getElementById('cartItemsList');
        if (cartElem) {
          cartElem.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      async connectDataDirectory() {
        if (!window.showDirectoryPicker) {
          alert('File System Access API is not fully supported in this browser. Falling back to local storage and JSON download backups.');
          return;
        }
        try {
          this.dirHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
          window.sessionStorage.setItem('vy_dir_connected', 'true');
          document.getElementById('storageModeBadge').innerText = `📁 Dir: /${this.dirHandle.name}`;
          document.getElementById('autoBackupText').innerText = `🛡️ Connected to local folder: /${this.dirHandle.name}/data`;
          
          // Try loading files from a 'data' subdirectory or root directory handle
          await this.loadAllFromDirectory();
          alert(`Successfully connected to directory handle: "${this.dirHandle.name}"! Data will now synchronize directly.`);
          this.initAsync();
        } catch (err) {
          if (err.name !== 'AbortError') {
            console.error(err);
            alert('Could not access directory: ' + err.message);
          }
        }
      }

      async getTargetDirectoryHandle() {
        if (!this.dirHandle) return null;
        try {
          // Look for or create 'data' subfolder inside selected directory as seen in screenshot
          return await this.dirHandle.getDirectoryHandle('data', { create: true });
        } catch (e) {
          return this.dirHandle;
        }
      }

      async persistAllData() {
        const timestamp = new Date().toLocaleTimeString();
        document.getElementById('lastSavedLabel').innerText = 'Last updated: ' + timestamp;

        // Always save locally first as fallback cache
        this.saveLocal('vy_shop', this.shop);
        this.saveLocal('vy_emailjs', this.emailSettings);
        this.saveLocal('vy_products', this.products);
        this.saveLocal('vy_customers', this.customers);
        this.saveLocal('vy_invoices', this.invoices);
        this.saveLocal('vy_ledger', this.ledger);
        this.saveLocal('vy_deleted_ids', this.deletedIds);
        this.saveLocal('vy_autobackups', this.autoBackups);

        // If directory handle is linked, write JSON files directly into the /data folder
        if (this.dirHandle) {
          try {
            const dataDir = await this.getTargetDirectoryHandle();
            const payloadFiles = {
              'shop.json': this.shop,
              'products.json': this.products,
              'customers.json': this.customers,
              'invoices.json': this.invoices,
              'ledger.json': this.ledger,
              'deleted.json': this.deletedIds,
              'emailsettings.json': this.emailSettings
            };

            for (const [filename, content] of Object.entries(payloadFiles)) {
              const fileHandle = await dataDir.getFileHandle(filename, { create: true });
              const writable = await fileHandle.createWritable();
              await writable.write(JSON.stringify(content, null, 2));
              await writable.close();
            }
            document.getElementById('storageModeBadge').innerText = `🟢 /data Synced`;
          } catch (err) {
            console.error('Error writing to local directory:', err);
            document.getElementById('storageModeBadge').innerText = `⚠️ Sync Error`;
          }
        }

        // Auto-sync to Google Drive if connected and enabled
        if (this.gdriveConfig && this.gdriveConfig.connected && this.gdriveConfig.autoSync) {
          this.scheduleAutoSyncToGoogleDrive();
        }
      }

      async loadAllFromDirectory() {
        if (!this.dirHandle) return;
        try {
          const dataDir = await this.getTargetDirectoryHandle();
          const filesToRead = [
            { key: 'shop', name: 'shop.json', fallback: this.shop },
            { key: 'products', name: 'products.json', fallback: this.products },
            { key: 'customers', name: 'customers.json', fallback: this.customers },
            { key: 'invoices', name: 'invoices.json', fallback: this.invoices },
            { key: 'ledger', name: 'ledger.json', fallback: this.ledger },
            { key: 'emailSettings', name: 'emailsettings.json', fallback: this.emailSettings }
          ];

          for (const f of filesToRead) {
            try {
              const fh = await dataDir.getFileHandle(f.name);
              const file = await fh.getFile();
              const text = await file.text();
              this[f.key] = JSON.parse(text);
              this.saveLocal(`vy_${f.key}`, this[f.key]);
            } catch (e) {
              // File might not exist yet, will be created on next persist
            }
          }
        } catch (err) {
          console.error('Error reading from directory:', err);
        }
      }

      formatDateTime(isoStr) {
        if (!isoStr) return '-';
        try {
          const d = new Date(isoStr);
          if (isNaN(d.getTime())) return String(isoStr);
          return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        } catch { return String(isoStr); }
      }

      toggleMobileMenu() {
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('mobile-open');
        overlay.classList.toggle('active');
      }

      syncShopHeader() {
        document.getElementById('sideBrandName').innerText = this.shop.name || 'Vyaparify Pro';
        document.getElementById('shopNameInput').value = this.shop.name || '';
        document.getElementById('shopPhoneInput').value = this.shop.phone || '';
        document.getElementById('shopEmailInput').value = this.shop.email || '';
        document.getElementById('shopGstInput').value = this.shop.gst || '';
        document.getElementById('shopFssaiInput').value = this.shop.fssai || '';
        document.getElementById('shopTaglineInput').value = this.shop.tagline || '';
        document.getElementById('shopAddressInput').value = this.shop.address || '';
      }

      async saveShopSettings() {
        this.shop = {
          name: document.getElementById('shopNameInput').value.trim() || 'My Retail Store',
          phone: document.getElementById('shopPhoneInput').value.trim(),
          email: document.getElementById('shopEmailInput').value.trim(),
          gst: document.getElementById('shopGstInput').value.trim(),
          fssai: document.getElementById('shopFssaiInput').value.trim(),
          tagline: document.getElementById('shopTaglineInput').value.trim(),
          address: document.getElementById('shopAddressInput').value.trim()
        };
        await this.persistAllData();
        this.syncShopHeader();
        alert('Shop details saved to directory /data folder successfully!');
      }

      syncEmailInputs() {
        document.getElementById('emailjsTo').value = this.emailSettings.toEmail || '';
        document.getElementById('emailjsKey').value = this.emailSettings.publicKey || '';
        document.getElementById('emailjsService').value = this.emailSettings.serviceId || '';
        document.getElementById('emailjsTemplate').value = this.emailSettings.templateId || '';
      }

      async saveEmailSettings() {
        this.emailSettings = {
          toEmail: document.getElementById('emailjsTo').value.trim(),
          publicKey: document.getElementById('emailjsKey').value.trim(),
          serviceId: document.getElementById('emailjsService').value.trim(),
          templateId: document.getElementById('emailjsTemplate').value.trim()
        };
        await this.persistAllData();
        alert('Email configuration saved!');
      }

      async sendEmailBackup() {
        if (!navigator.onLine) {
          alert('No internet connection detected.');
          return;
        }
        const { toEmail, publicKey, serviceId, templateId } = this.emailSettings;
        if (!toEmail || !publicKey || !serviceId || !templateId) {
          alert('Please fill in and save all EmailJS configuration fields.');
          return;
        }

        const payload = {
          shop: this.shop,
          products: this.products,
          customers: this.customers,
          invoices: this.invoices,
          ledger: this.ledger,
          exportedAt: new Date().toISOString()
        };

        try {
          const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              service_id: serviceId,
              template_id: templateId,
              user_id: publicKey,
              template_params: {
                to_email: toEmail,
                business_name: this.shop.name || 'My Store',
                backup_date: this.formatDateTime(new Date().toISOString()),
                backup_data: JSON.stringify(payload, null, 2)
              }
            })
          });

          if (res.ok) alert(`✅ Complete backup successfully emailed to ${toEmail}`);
          else alert('EmailJS error: ' + await res.text());
        } catch (err) {
          alert('Failed to send email.');
        }
      }

      generateInvoiceId(dateObj = new Date()) {
        const dd = String(dateObj.getDate()).padStart(2, '0');
        const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
        const yy = String(dateObj.getFullYear()).slice(-2);
        const prefix = `${dd}${mm}${yy}`;

        let maxNum = 0;
        this.invoices.forEach(inv => {
          if (inv && inv.id) {
            const strId = String(inv.id);
            if (strId.startsWith(prefix + '-')) {
              const parts = strId.split('-');
              const num = parseInt(parts[1], 10);
              if (!isNaN(num) && num > maxNum) maxNum = num;
            }
          }
        });
        return `${prefix}-${maxNum + 1}`;
      }

      async checkAutoBackup() {
        const now = new Date();
        const dateStr = now.toISOString().split('T')[0];
        const slot = now.getHours() < 14 ? 'Morning' : 'Evening';
        const snapshotId = `${dateStr}-${slot}`;

        if (!this.autoBackups.some(b => b.id === snapshotId)) {
          const backupData = {
            id: snapshotId,
            timestamp: now.toISOString(),
            slot: slot,
            data: { shop: this.shop, products: this.products, customers: this.customers, invoices: this.invoices, ledger: this.ledger }
          };
          this.autoBackups.unshift(backupData);
          if (this.autoBackups.length > 14) this.autoBackups.pop();
          await this.persistAllData();
        }
      }

      switchTab(tabId, btn, isMobile = false) {
        document.querySelectorAll('main > section').forEach(s => s.style.display = 'none');
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.mob-nav-btn').forEach(b => b.classList.remove('active'));
        const targetSection = document.getElementById(`tab-${tabId}`);
        if (targetSection) targetSection.style.display = 'block';
        if (btn) btn.classList.add('active');

        // Sync active state on mobile bottom nav
        const mobBtnMap = { dashboard: 'mobTabDashboard', billing: 'mobTabBilling', invoices: 'mobTabInvoices', ledger: 'mobTabLedger' };
        if (mobBtnMap[tabId]) {
          const mBtn = document.getElementById(mobBtnMap[tabId]);
          if (mBtn) mBtn.classList.add('active');
        }

        const headings = {
          dashboard: 'Dashboard',
          billing: 'POS Billing',
          inventory: 'Inventory & Stock',
          invoices: 'Invoice Records',
          ledger: 'Khata Accounts',
          customers: 'Customer Directory',
          reports: 'Reports & Analytics',
          shop: 'Shop Details',
          backup: 'Cloud & Security'
        };
        document.getElementById('currentTabHeading').innerText = headings[tabId] || tabId;

        // Toggle floating mobile cart bar
        const mobCartBar = document.getElementById('mobileCartFloatingBar');
        if (mobCartBar) {
          mobCartBar.style.display = (tabId === 'billing' && this.cart.length > 0 && window.innerWidth <= 768) ? 'flex' : 'none';
        }

        if (window.innerWidth <= 768) {
          document.getElementById('appSidebar').classList.remove('mobile-open');
          document.getElementById('sidebarOverlay').classList.remove('active');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        if (tabId === 'reports') this.renderReport();
        if (tabId === 'billing') this.renderPosProducts();
        if (tabId === 'backup') this.updateSecurityUI();
      }

      setReportPreset(preset) {
        const now = new Date();
        const toYMD = (d) => d.toISOString().split('T')[0];
        const startInput = document.getElementById('rptStartDate');
        const endInput = document.getElementById('rptEndDate');

        document.querySelectorAll('.time-chip').forEach(c => c.classList.remove('active'));
        const chip = document.getElementById(`chip-${preset}`);
        if (chip) chip.classList.add('active');

        if (preset === 'today') {
          startInput.value = toYMD(now); endInput.value = toYMD(now);
        } else if (preset === 'yesterday') {
          const y = new Date(); y.setDate(now.getDate() - 1);
          startInput.value = toYMD(y); endInput.value = toYMD(y);
        } else if (preset === 'week') {
          const w = new Date(); w.setDate(now.getDate() - 7);
          startInput.value = toYMD(w); endInput.value = toYMD(now);
        } else if (preset === 'month') {
          const m = new Date(now.getFullYear(), now.getMonth(), 1);
          startInput.value = toYMD(m); endInput.value = toYMD(now);
        } else if (preset === 'all') {
          startInput.value = ''; endInput.value = '';
        }
        this.renderReport();
      }

      clearPresetChips() { document.querySelectorAll('.time-chip').forEach(c => c.classList.remove('active')); }

      getReportData() {
        const rptType = document.getElementById('rptTypeSelect').value;
        const startDateStr = document.getElementById('rptStartDate').value;
        const endDateStr = document.getElementById('rptEndDate').value;
        const mode = document.getElementById('rptModeSelect').value;
        const sort = document.getElementById('rptSortSelect').value;

        const start = startDateStr ? new Date(startDateStr + 'T00:00:00') : null;
        const end = endDateStr ? new Date(endDateStr + 'T23:59:59') : null;

        let data = [];
        if (rptType === 'sales') {
          data = this.invoices.filter(inv => {
            const d = new Date(inv.date);
            if (start && d < start) return false;
            if (end && d > end) return false;
            if (mode !== 'all' && inv.mode !== mode) return false;
            return true;
          });
          data.sort((a, b) => {
            if (sort === 'date-desc') return new Date(b.date) - new Date(a.date);
            if (sort === 'date-asc') return new Date(a.date) - new Date(b.date);
            if (sort === 'amount-desc') return (Number(b.total) || 0) - (Number(a.total) || 0);
            if (sort === 'amount-asc') return (Number(a.total) || 0) - (Number(b.total) || 0);
            return 0;
          });
        } else if (rptType === 'khata') {
          data = this.ledger.filter(l => {
            const d = new Date(l.date);
            if (start && d < start) return false;
            if (end && d > end) return false;
            return true;
          });
          data.sort((a, b) => {
            if (sort === 'date-desc') return new Date(b.date) - new Date(a.date);
            if (sort === 'date-asc') return new Date(a.date) - new Date(b.date);
            if (sort === 'amount-desc') return (Number(b.amount) || 0) - (Number(a.amount) || 0);
            if (sort === 'amount-asc') return (Number(a.amount) || 0) - (Number(b.amount) || 0);
            return 0;
          });
        } else if (rptType === 'inventory') {
          data = [...this.products];
        } else if (rptType === 'customers') {
          data = [...this.customers];
        }
        return { rptType, data };
      }

      renderReport() {
        const { rptType, data } = this.getReportData();
        const thead = document.getElementById('rptTableHead');
        const tbody = document.getElementById('rptTableBody');
        const kpiContainer = document.getElementById('rptKpiContainer');

        thead.innerHTML = ''; tbody.innerHTML = '';

        if (rptType === 'sales') {
          kpiContainer.style.display = 'grid';
          let totalRev = 0, cashUpi = 0, creditVal = 0;
          data.forEach(inv => {
            const tot = Number(inv.total) || 0;
            totalRev += tot;
            if (inv.mode === 'Credit') creditVal += tot; else cashUpi += tot;
          });
          document.getElementById('rptKpiRevenue').innerText = `₹${totalRev.toFixed(2)}`;
          document.getElementById('rptKpiCount').innerText = data.length;
          document.getElementById('rptKpiCashUpi').innerText = `₹${cashUpi.toFixed(2)}`;
          document.getElementById('rptKpiCredit').innerText = `₹${creditVal.toFixed(2)}`;

          thead.innerHTML = `<tr><th>Bill ID</th><th>Date & Time</th><th>Device</th><th>Customer</th><th>Items</th><th>Mode</th><th style="text-align: right;">Total</th></tr>`;
          if (!data.length) tbody.innerHTML = `<tr><td colspan="7" align="center" style="color:var(--slate-400); padding:20px;">No sales records found.</td></tr>`;
          data.forEach(inv => {
            const itemsCount = (inv.items || []).reduce((acc, i) => acc + (Number(i.qty) || 0), 0);
            const custName = inv.customer && inv.customer.name ? this.escapeHtml(inv.customer.name) : 'Walk-in';
            tbody.innerHTML += `<tr><td><strong>${this.escapeHtml(inv.id)}</strong></td><td style="color:var(--slate-600); font-size:12px;">${this.formatDateTime(inv.date)}</td><td><span class="badge" style="background:#eff6ff; color:#1e40af; font-size:10.5px; padding:2px 7px;">💻 ${this.escapeHtml(inv.device || 'Counter 1')}</span></td><td>${custName}</td><td>${itemsCount.toFixed(2)} qty</td><td><span class="badge ${inv.mode === 'Credit' ? 'badge-due' : 'badge-paid'}">${this.escapeHtml(inv.mode)}</span></td><td align="right" style="font-weight:bold;">₹${Number(inv.total || 0).toFixed(2)}</td></tr>`;
          });
        } else if (rptType === 'khata') {
          kpiContainer.style.display = 'none';
          thead.innerHTML = `<tr><th>Date & Time</th><th>Device</th><th>Customer Name</th><th>Type</th><th>Description</th><th style="text-align: right;">Amount</th></tr>`;
          if (!data.length) tbody.innerHTML = `<tr><td colspan="6" align="center" style="color:var(--slate-400); padding:20px;">No Khata entries found.</td></tr>`;
          data.forEach(l => {
            const isDebit = l.type === 'debit';
            let desc = l.note || '-';
            if (l.invoiceId) {
              const inv = this.invoices.find(i => String(i.id) === String(l.invoiceId));
              if (inv && inv.items) {
                desc = `Bill #${inv.id}: ${inv.items.map(i => `${i.name} (x${Number(i.qty).toFixed(1)})`).join(', ')}`;
              }
            }
            tbody.innerHTML += `<tr><td style="color:var(--slate-600); font-size:12px;">${this.formatDateTime(l.date)}</td><td><span class="badge" style="background:#eff6ff; color:#1e40af; font-size:10.5px; padding:2px 7px;">💻 ${this.escapeHtml(l.device || 'Counter 1')}</span></td><td><strong>${this.escapeHtml(l.customerName || 'Customer')}</strong></td><td><span class="badge ${isDebit ? 'badge-due' : 'badge-paid'}">${isDebit ? 'Debit' : 'Credit'}</span></td><td>${this.escapeHtml(desc)}</td><td align="right" style="font-weight:bold; color:${isDebit ? 'var(--amber)' : 'var(--emerald)'};">₹${Number(l.amount || 0).toFixed(2)}</td></tr>`;
          });
        } else if (rptType === 'inventory') {
          kpiContainer.style.display = 'none';
          thead.innerHTML = `<tr><th>Product</th><th>Price</th><th>Stock</th><th>Valuation</th><th style="text-align: right;">Updated</th></tr>`;
          data.forEach(p => {
            const val = (Number(p.price) || 0) * (Number(p.stock) || 0);
            tbody.innerHTML += `<tr><td><strong>${this.escapeHtml(p.name)}</strong></td><td>₹${Number(p.price || 0).toFixed(2)}</td><td>${Number(p.stock || 0).toFixed(2)}</td><td style="font-weight:bold; color:var(--primary);">₹${val.toFixed(2)}</td><td align="right" style="color:var(--slate-600); font-size:12px;">${this.formatDateTime(p.updatedAt)}</td></tr>`;
          });
        } else if (rptType === 'customers') {
          kpiContainer.style.display = 'none';
          thead.innerHTML = `<tr><th>Name</th><th>Phone</th><th>Email</th><th>Address</th><th style="text-align: right;">Outstanding Due</th></tr>`;
          data.forEach(c => {
            const due = this.getCustomerDue(c.id);
            tbody.innerHTML += `<tr><td><strong>${this.escapeHtml(c.name)}</strong></td><td>${c.phone ? this.escapeHtml(c.phone) : '-'}</td><td>${c.email ? this.escapeHtml(c.email) : '-'}</td><td>${c.address ? this.escapeHtml(c.address) : '-'}</td><td align="right" style="font-weight:bold; color:${due > 0 ? 'var(--amber)' : 'var(--emerald)'};">₹${due.toFixed(2)}</td></tr>`;
          });
        }
      }

      exportReportCSV() {
        const { rptType, data } = this.getReportData();
        if (!data.length) return alert('No records to export.');
        let csv = '';
        const filename = `${rptType}_report_${new Date().toISOString().split('T')[0]}.csv`;
        if (rptType === 'sales') {
          csv += 'Invoice ID,Date,Device,Customer,Mode,Total\n';
          data.forEach(inv => { csv += `"${inv.id}","${this.formatDateTime(inv.date)}","${inv.device || 'Counter 1'}","${inv.customer ? inv.customer.name : 'Walk-in'}","${inv.mode}","${inv.total}"\n`; });
        } else if (rptType === 'khata') {
          csv += 'Date,Device,Customer,Type,Description,Amount\n';
          data.forEach(l => { csv += `"${this.formatDateTime(l.date)}","${l.device || 'Counter 1'}","${l.customerName || 'Customer'}","${l.type}","${(l.note || '').replace(/"/g, '""')}","${l.amount}"\n`; });
        } else {
          csv += 'Name,Details\n';
          data.forEach(i => { csv += `"${i.name || i.id}","${i.total || i.amount || i.price || ''}"\n`; });
        }
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename; a.click();
      }

      printReport() {
        const { rptType, data } = this.getReportData();
        const startInput = document.getElementById('rptStartDate').value;
        const endInput = document.getElementById('rptEndDate').value;
        
        let periodStr = 'All Time';
        if (startInput && endInput) {
          periodStr = `${startInput} to ${endInput}`;
        } else if (startInput) {
          periodStr = `From ${startInput}`;
        } else if (endInput) {
          periodStr = `Up to ${endInput}`;
        }

        const typeLabels = {
          sales: 'Sales & Invoices Report',
          khata: 'Khata Accounts Ledger Report',
          inventory: 'Inventory & Stock Valuation Report',
          customers: 'Customer Accounts & Due Balances'
        };

        const storeNameEl = document.getElementById('prtRptStoreName');
        if (storeNameEl) storeNameEl.innerText = this.shop.name || 'Vyaparify Retail';
        const storeInfoEl = document.getElementById('prtRptStoreInfo');
        if (storeInfoEl) storeInfoEl.innerText = `${this.shop.address || ''} • Tel: ${this.shop.phone || ''} • GST: ${this.shop.gst || ''}`;
        const titleEl = document.getElementById('prtRptTitle');
        if (titleEl) titleEl.innerText = (typeLabels[rptType] || 'BUSINESS REPORT').toUpperCase();
        const periodEl = document.getElementById('prtRptPeriod');
        if (periodEl) periodEl.innerText = `Generated on: ${this.formatDateTime(new Date().toISOString())} | Period: ${periodStr}`;

        const kpisEl = document.getElementById('prtRptKpis');
        if (kpisEl) {
          kpisEl.innerHTML = '';
          if (rptType === 'sales') {
            let totalRev = 0, cashUpi = 0, creditVal = 0;
            data.forEach(inv => {
              const tot = Number(inv.total) || 0;
              totalRev += tot;
              if (inv.mode === 'Credit') creditVal += tot; else cashUpi += tot;
            });
            kpisEl.style.display = 'flex';
            kpisEl.innerHTML = `
              <div>Total Revenue: <strong>₹${totalRev.toFixed(2)}</strong></div>
              <div>Bills Count: <strong>${data.length}</strong></div>
              <div>Cash/UPI: <strong>₹${cashUpi.toFixed(2)}</strong></div>
              <div>Credit Sales: <strong>₹${creditVal.toFixed(2)}</strong></div>
            `;
          } else {
            kpisEl.style.display = 'none';
          }
        }

        const thead = document.getElementById('prtRptTableHead');
        const tbody = document.getElementById('prtRptTableBody');
        if (thead && tbody) {
          thead.innerHTML = '';
          tbody.innerHTML = '';

          if (rptType === 'sales') {
            thead.innerHTML = `<tr style="border-bottom: 2px solid #000;"><th style="text-align:left; padding:4px 0;">Bill ID</th><th style="text-align:left; padding:4px 0;">Date</th><th style="text-align:left; padding:4px 0;">Device</th><th style="text-align:left; padding:4px 0;">Customer</th><th style="text-align:center; padding:4px 0;">Items</th><th style="text-align:center; padding:4px 0;">Mode</th><th style="text-align:right; padding:4px 0;">Total</th></tr>`;
            if (!data.length) tbody.innerHTML = `<tr><td colspan="7" align="center" style="padding:16px;">No sales records found.</td></tr>`;
            data.forEach(inv => {
              const itemsCount = (inv.items || []).reduce((acc, i) => acc + (Number(i.qty) || 0), 0);
              tbody.innerHTML += `
                <tr style="border-bottom: 1px solid #ddd;">
                  <td style="padding:4px 0;"><strong>${this.escapeHtml(inv.id)}</strong></td>
                  <td style="padding:4px 0; font-size:11px;">${this.formatDateTime(inv.date)}</td>
                  <td style="padding:4px 0; font-size:11px;">💻 ${this.escapeHtml(inv.device || 'Counter 1')}</td>
                  <td style="padding:4px 0;">${inv.customer && inv.customer.name ? this.escapeHtml(inv.customer.name) : 'Walk-in'}</td>
                  <td style="padding:4px 0; text-align:center;">${itemsCount.toFixed(2)}</td>
                  <td style="padding:4px 0; text-align:center;">${this.escapeHtml(inv.mode)}</td>
                  <td style="padding:4px 0; text-align:right; font-weight:bold;">₹${Number(inv.total || 0).toFixed(2)}</td>
                </tr>
              `;
            });
          } else if (rptType === 'khata') {
            thead.innerHTML = `<tr style="border-bottom: 2px solid #000;"><th style="text-align:left; padding:4px 0;">Date</th><th style="text-align:left; padding:4px 0;">Device</th><th style="text-align:left; padding:4px 0;">Customer</th><th style="text-align:center; padding:4px 0;">Type</th><th style="text-align:left; padding:4px 0;">Note</th><th style="text-align:right; padding:4px 0;">Amount</th></tr>`;
            if (!data.length) tbody.innerHTML = `<tr><td colspan="6" align="center" style="padding:16px;">No Khata entries found.</td></tr>`;
            data.forEach(l => {
              const isDebit = l.type === 'debit';
              let desc = l.note || '-';
              if (l.invoiceId) {
                const inv = this.invoices.find(i => String(i.id) === String(l.invoiceId));
                if (inv && inv.items) {
                  desc = `Bill #${inv.id}: ${inv.items.map(i => `${i.name} (x${Number(i.qty).toFixed(1)})`).join(', ')}`;
                }
              }
              tbody.innerHTML += `
                <tr style="border-bottom: 1px solid #ddd;">
                  <td style="padding:4px 0; font-size:11px;">${this.formatDateTime(l.date)}</td>
                  <td style="padding:4px 0; font-size:11px;">💻 ${this.escapeHtml(l.device || 'Counter 1')}</td>
                  <td style="padding:4px 0;"><strong>${this.escapeHtml(l.customerName || 'Customer')}</strong></td>
                  <td style="padding:4px 0; text-align:center;">${isDebit ? 'Debit (Due)' : 'Credit (Paid)'}</td>
                  <td style="padding:4px 0;">${this.escapeHtml(desc)}</td>
                  <td style="padding:4px 0; text-align:right; font-weight:bold;">₹${Number(l.amount || 0).toFixed(2)}</td>
                </tr>
              `;
            });
          } else if (rptType === 'inventory') {
            thead.innerHTML = `<tr style="border-bottom: 2px solid #000;"><th style="text-align:left; padding:4px 0;">Product</th><th style="text-align:right; padding:4px 0;">Price</th><th style="text-align:center; padding:4px 0;">Stock</th><th style="text-align:right; padding:4px 0;">Valuation</th><th style="text-align:right; padding:4px 0;">Last Updated</th></tr>`;
            data.forEach(p => {
              const val = (Number(p.price) || 0) * (Number(p.stock) || 0);
              tbody.innerHTML += `
                <tr style="border-bottom: 1px solid #ddd;">
                  <td style="padding:4px 0;"><strong>${this.escapeHtml(p.name)}</strong></td>
                  <td style="padding:4px 0; text-align:right;">₹${Number(p.price || 0).toFixed(2)}</td>
                  <td style="padding:4px 0; text-align:center;">${Number(p.stock || 0).toFixed(2)}</td>
                  <td style="padding:4px 0; text-align:right; font-weight:bold;">₹${val.toFixed(2)}</td>
                  <td style="padding:4px 0; text-align:right; font-size:11px;">${this.formatDateTime(p.updatedAt)}</td>
                </tr>
              `;
            });
          } else if (rptType === 'customers') {
            thead.innerHTML = `<tr style="border-bottom: 2px solid #000;"><th style="text-align:left; padding:4px 0;">Customer Name</th><th style="text-align:left; padding:4px 0;">Phone</th><th style="text-align:left; padding:4px 0;">Email</th><th style="text-align:left; padding:4px 0;">Address</th><th style="text-align:right; padding:4px 0;">Outstanding Due</th></tr>`;
            data.forEach(c => {
              const due = this.getCustomerDue(c.id);
              tbody.innerHTML += `
                <tr style="border-bottom: 1px solid #ddd;">
                  <td style="padding:4px 0;"><strong>${this.escapeHtml(c.name)}</strong></td>
                  <td style="padding:4px 0;">${c.phone ? this.escapeHtml(c.phone) : '-'}</td>
                  <td style="padding:4px 0;">${c.email ? this.escapeHtml(c.email) : '-'}</td>
                  <td style="padding:4px 0;">${c.address ? this.escapeHtml(c.address) : '-'}</td>
                  <td style="padding:4px 0; text-align:right; font-weight:bold;">₹${due.toFixed(2)}</td>
                </tr>
              `;
            });
          }
        }

        document.body.className = 'print-rpt';
        window.onafterprint = () => { document.body.className = ''; };
        window.print();
        setTimeout(() => { document.body.className = ''; }, 1500);
      }

      startNewSale() {
        this.cart = []; this.selectedCustomer = null;
        document.getElementById('posCustomerLabel').innerText = 'Walk-in';
        this.renderCart();
        this.switchTab('billing', document.querySelectorAll('.nav-btn')[1]);
      }

      renderPosProducts(query = '') {
        const grid = document.getElementById('posProductGrid');
        grid.innerHTML = '';
        const items = this.products.filter(p => (p.name || '').toLowerCase().includes(query.toLowerCase()));
        if (!items.length) {
          grid.innerHTML = `<div style="grid-column: 1 / -1; text-align:center; padding: 40px 20px; color: var(--slate-400);">No products found matching "${this.escapeHtml(query)}"</div>`;
          return;
        }
        items.forEach(p => {
          const tile = document.createElement('div');
          tile.className = 'product-tile';
          const stockNum = Number(p.stock || 0);
          let stockBadge = '';
          if (stockNum <= 0) {
            stockBadge = `<span class="badge" style="background:#fee2e2; color:#b91c1c; font-size:10px; padding:2px 6px;">Out of Stock</span>`;
          } else if (stockNum <= 5) {
            stockBadge = `<span class="badge badge-due" style="font-size:10px; padding:2px 6px;">Low: ${stockNum.toFixed(2)}</span>`;
          } else {
            stockBadge = `<span class="badge badge-paid" style="font-size:10px; padding:2px 6px;">Stock: ${stockNum.toFixed(2)}</span>`;
          }
          tile.innerHTML = `
            <div style="display:flex; flex-direction:column; gap:4px;">
              <strong style="font-size: 13.5px; line-height: 1.3;">${this.escapeHtml(p.name)}</strong>
              <div>${stockBadge}</div>
            </div>
            <div style="font-size: 15px; font-weight:700; color:var(--primary); font-family: var(--font-heading); margin-top: 6px;">₹${Number(p.price || 0).toFixed(2)}</div>
          `;
          tile.onclick = () => this.addToCart(p);
          grid.appendChild(tile);
        });
      }

      searchProductsPos(q) { this.renderPosProducts(q); }

      addToCart(prod) {
        if (Number(prod.stock || 0) <= 0) return alert('Out of stock!');
        const item = this.cart.find(i => String(i.id) === String(prod.id));
        if (item) {
          if (item.qty >= Number(prod.stock || 0)) return alert('Stock limit reached');
          item.qty = Number((item.qty + 1).toFixed(2));
        } else {
          this.cart.push({ id: prod.id, name: prod.name, price: Number(prod.price || 0), qty: 1.00 });
        }
        this.renderCart();
      }

      renderCart() {
        const list = document.getElementById('cartItemsList');
        list.innerHTML = '';
        let total = 0;
        let totalQty = 0;
        if (this.cart.length === 0) {
          list.innerHTML = `<div style="text-align:center; color:var(--slate-400); padding:30px 0; font-size:13px;">🛒 Cart is empty. Click products to add items.</div>`;
        }
        this.cart.forEach((i, idx) => {
          const itemTotal = (Number(i.price) || 0) * (Number(i.qty) || 0);
          total += itemTotal;
          totalQty += (Number(i.qty) || 0);
          const row = document.createElement('div');
          row.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:10px; background:var(--slate-50); border:1px solid var(--slate-200); border-radius:10px; gap:6px; flex-wrap:wrap; transition: all 0.2s ease;';
          row.innerHTML = `
            <div style="flex:1; min-width: 120px;">
              <strong style="font-size:13px; color:var(--slate-800);">${this.escapeHtml(i.name)}</strong><br>
              <small style="color:var(--slate-500);">₹${Number(i.price).toFixed(2)} each</small>
            </div>
            <div style="display:flex; align-items:center; gap:4px;">
              <button class="btn btn-light" style="padding:4px 8px; font-weight:bold;" onclick="app.adjustCartQty(${idx}, -0.25)">-</button>
              <input type="text" value="${Number(i.qty).toFixed(2)}" class="input-control" style="width:70px; text-align:center; font-weight:bold; padding:6px; font-size:13px;" oninput="app.updateCartQty(${idx}, this.value)">
              <button class="btn btn-light" style="padding:4px 8px; font-weight:bold;" onclick="app.adjustCartQty(${idx}, 0.25)">+</button>
              <button class="btn btn-danger" style="padding:6px 8px;" onclick="app.removeFromCart(${idx})" title="Remove item">🗑️</button>
            </div>
          `;
          list.appendChild(row);
        });
        document.getElementById('posTotalLabel').innerText = `₹${total.toFixed(2)}`;

        // Sync mobile floating cart bar
        const mobCartBar = document.getElementById('mobileCartFloatingBar');
        const mobCount = document.getElementById('mobCartCount');
        const mobTot = document.getElementById('mobCartTotal');
        if (mobCount) mobCount.innerText = `${this.cart.length} items (${totalQty.toFixed(1)} qty)`;
        if (mobTot) mobTot.innerText = `₹${total.toFixed(2)}`;
        if (mobCartBar) {
          const isBillingTab = document.getElementById('tab-billing')?.style.display !== 'none';
          mobCartBar.style.display = (isBillingTab && this.cart.length > 0 && window.innerWidth <= 768) ? 'flex' : 'none';
        }
      }

      adjustCartQty(idx, delta) {
        let q = (Number(this.cart[idx].qty) || 0) + delta;
        if (q < 0.01) q = 0.01;
        this.cart[idx].qty = Number(q.toFixed(2));
        this.renderCart();
      }

      updateCartQty(idx, val) {
        let q = parseFloat(val);
        if (isNaN(q) || q <= 0) q = 0.01;
        this.cart[idx].qty = Number(q.toFixed(2));
      }

      removeFromCart(idx) { this.cart.splice(idx, 1); this.renderCart(); }
      clearCart() { this.cart = []; this.renderCart(); }

      async completeSale() {
        if (!this.cart.length) return alert('Cart is empty!');
        const mode = document.getElementById('posPaymentMode').value;
        if (mode === 'Credit' && !this.selectedCustomer) {
          alert('Khata credit billing requires a registered customer selection.');
          this.openCustomerSelectionModal();
          return;
        }

        let total = this.cart.reduce((s, i) => s + ((Number(i.price) || 0) * (Number(i.qty) || 0)), 0);
        const billId = this.generateInvoiceId();
        const nowIso = new Date().toISOString();

        let appliedAdvance = 0;
        if (this.selectedCustomer) {
          const currentDue = this.getCustomerDue(this.selectedCustomer.id);
          if (currentDue < 0) {
            const availableAdvance = Math.abs(currentDue);
            if (availableAdvance >= total) { appliedAdvance = total; total = 0; }
            else { appliedAdvance = availableAdvance; total -= availableAdvance; }
          }
        }

        const curDevice = this.deviceName || 'Counter 1';
        const newInv = {
          id: billId, date: nowIso,
          customer: this.selectedCustomer ? { ...this.selectedCustomer } : null,
          items: JSON.parse(JSON.stringify(this.cart)),
          total: Number(total.toFixed(2)),
          appliedAdvance: Number(appliedAdvance.toFixed(2)),
          mode: mode,
          device: curDevice
        };

        this.cart.forEach(cItem => {
          const p = this.products.find(prod => String(prod.id) === String(cItem.id));
          if (p) { p.stock = Number(Math.max(0, (Number(p.stock) || 0) - Number(cItem.qty)).toFixed(2)); p.updatedAt = nowIso; }
        });

        this.invoices.unshift(newInv);
        if (this.deletedIds && this.deletedIds.invoices) delete this.deletedIds.invoices[String(billId)];

        if (appliedAdvance > 0) {
          this.ledger.push({
            id: Date.now().toString() + '_adv', customerId: this.selectedCustomer.id,
            customerName: this.selectedCustomer.name, type: 'repay', amount: Number(appliedAdvance.toFixed(2)),
            note: `Auto-applied advance payment for Bill #${billId}`, date: nowIso,
            device: curDevice
          });
        }

        if (mode === 'Credit' && this.selectedCustomer && total > 0) {
          const itemSummary = this.cart.map(i => `${i.name} (x${Number(i.qty).toFixed(1)})`).join(', ');
          this.ledger.push({
            id: Date.now().toString(),
            customerId: this.selectedCustomer.id,
            customerName: this.selectedCustomer.name,
            type: 'debit',
            amount: Number(total.toFixed(2)),
            invoiceId: billId,
            note: `Bill #${billId}: ${itemSummary}`,
            date: nowIso,
            device: curDevice
          });
        }

        await this.persistAllData();
        this.cart = []; this.selectedCustomer = null;
        document.getElementById('posCustomerLabel').innerText = 'Walk-in';
        this.renderCart();
        this.initAsync();
        this.openInvoiceActionModal(newInv);
      }

      openInvoiceActionModal(inv) {
        if (!inv) return;
        this.activePreviewInvoice = inv;
        const container = document.getElementById('invoiceActionPreview');
        const custName = inv.customer ? inv.customer.name : 'Walk-in';

        let itemsHtml = (inv.items || []).map(i => `<div style="display:flex; justify-content:space-between; margin-bottom:4px;"><span>${i.name} (x${Number(i.qty || 0).toFixed(2)})</span><span>₹${((Number(i.price) || 0) * (Number(i.qty) || 0)).toFixed(2)}</span></div>`).join('');

        container.innerHTML = `
          <div style="text-align:center; border-bottom:1px dashed var(--slate-300); padding-bottom:6px; margin-bottom:8px;">
            <strong style="font-size:14px; text-transform:uppercase;">${this.shop.name || 'Vyaparify Retail'}</strong><br>
            <small>Bill ID #${inv.id} • ${this.formatDateTime(inv.date)} • 💻 ${this.escapeHtml(inv.device || 'Counter 1')}</small>
          </div>
          <div><strong>Customer:</strong> ${custName}</div>
          <div style="border-top:1px solid var(--slate-200); border-bottom:1px solid var(--slate-200); padding:6px 0; margin:8px 0;">${itemsHtml}</div>
          <div style="display:flex; justify-content:space-between; font-weight:bold;"><span>Grand Total:</span><span style="color:var(--primary);">₹${Number(inv.total || 0).toFixed(2)}</span></div>
        `;
        document.getElementById('invoiceActionModal').classList.add('active');
      }

      openInvoiceActionModalById(id) {
        const inv = this.invoices.find(i => String(i.id) === String(id));
        if (inv) this.openInvoiceActionModal(inv);
      }

      triggerDirectPrint() { if (this.activePreviewInvoice) this.printBill(this.activePreviewInvoice); }
      editCurrentInvoiceFromPreview() { if (this.activePreviewInvoice) { const inv = this.activePreviewInvoice; this.closeModals(); this.openEditInvoiceModal(inv); } }

      openEditInvoiceModal(inv) {
        this.activePreviewInvoice = inv;
        this.tempEditItems = JSON.parse(JSON.stringify(inv.items || []));
        document.getElementById('editModalHeading').innerText = `Edit Invoice #${inv.id}`;
        document.getElementById('editInvModeSelect').value = inv.mode || 'Cash';
        
        // Date
        const dateInput = document.getElementById('editInvDateInput');
        if (dateInput) {
          try {
            dateInput.value = inv.date ? new Date(inv.date).toISOString().slice(0, 16) : '';
          } catch(e) { dateInput.value = ''; }
        }

        // Customer selection
        const custSelect = document.getElementById('editInvCustomerSelect');
        if (custSelect) {
          custSelect.innerHTML = '<option value="">Walk-in Customer</option>';
          this.customers.forEach(c => {
            const isSel = inv.customer && String(inv.customer.id) === String(c.id);
            custSelect.innerHTML += `<option value="${c.id}" ${isSel ? 'selected' : ''}>${c.name} (${c.phone || 'No phone'})</option>`;
          });
        }

        const prodSelect = document.getElementById('editInvAddProductSelect');
        if (prodSelect) {
          prodSelect.innerHTML = '';
          this.products.forEach(p => { prodSelect.innerHTML += `<option value="${p.id}">${p.name} - ₹${p.price}</option>`; });
        }

        this.renderEditInvoiceItems();
        document.getElementById('editInvoiceModal').classList.add('active');
      }

      openEditInvoiceModalById(id) { const inv = this.invoices.find(i => String(i.id) === String(id)); if (inv) this.openEditInvoiceModal(inv); }

      addItemToEditInvoice() {
        const prodId = document.getElementById('editInvAddProductSelect').value;
        const prod = this.products.find(p => String(p.id) === String(prodId));
        if (!prod) return;
        const existing = this.tempEditItems.find(i => String(i.id) === String(prod.id));
        if (existing) existing.qty = Number((Number(existing.qty || 0) + 1).toFixed(2));
        else this.tempEditItems.push({ id: prod.id, name: prod.name, price: Number(prod.price || 0), qty: 1.00 });
        this.renderEditInvoiceItems();
      }

      adjustEditInvoiceItemQty(idx, delta) {
        if (!this.tempEditItems[idx]) return;
        let q = (Number(this.tempEditItems[idx].qty) || 0) + delta;
        if (q < 0.01) q = 0.01;
        this.tempEditItems[idx].qty = Number(q.toFixed(2));
        this.renderEditInvoiceItems();
      }

      updateEditInvoiceItemQty(idx, val) {
        if (!this.tempEditItems[idx]) return;
        let q = parseFloat(val);
        if (isNaN(q) || q <= 0) q = 0.01;
        this.tempEditItems[idx].qty = Number(q.toFixed(2));
        this.renderEditInvoiceItems();
      }

      updateEditInvoiceItemPrice(idx, val) {
        if (!this.tempEditItems[idx]) return;
        let p = parseFloat(val);
        if (isNaN(p) || p < 0) p = 0;
        this.tempEditItems[idx].price = Number(p.toFixed(2));
        this.renderEditInvoiceItems();
      }

      removeEditInvoiceItem(idx) {
        this.tempEditItems.splice(idx, 1);
        this.renderEditInvoiceItems();
      }

      renderEditInvoiceItems() {
        const list = document.getElementById('editInvItemsList');
        list.innerHTML = '';
        let total = 0;
        if (!this.tempEditItems.length) {
          list.innerHTML = '<div style="text-align:center; color:var(--slate-400); padding:16px; font-size:12px;">No items in bill. Select product and click "+ Add".</div>';
        }
        this.tempEditItems.forEach((item, idx) => {
          const itemSubtotal = (Number(item.price) || 0) * (Number(item.qty) || 0);
          total += itemSubtotal;
          list.innerHTML += `
            <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 8px; background:var(--slate-50); border:1px solid var(--slate-200); border-radius:6px; gap:8px; flex-wrap:wrap;">
              <div style="flex:1; min-width:130px;">
                <strong style="font-size:12px;">${item.name}</strong>
                <div style="display:flex; align-items:center; gap:4px; margin-top:2px;">
                  <span style="font-size:11px; color:var(--slate-500);">Price: ₹</span>
                  <input type="number" step="0.01" value="${item.price}" style="width:70px; padding:2px 4px; font-size:11px;" class="input-control" onchange="app.updateEditInvoiceItemPrice(${idx}, this.value)">
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:4px;">
                <button class="btn btn-light" style="padding:2px 6px; font-size:11px;" onclick="app.adjustEditInvoiceItemQty(${idx}, -1)">-</button>
                <input type="number" step="0.01" value="${Number(item.qty).toFixed(2)}" style="width:55px; text-align:center; font-weight:bold; padding:2px 4px; font-size:11px;" class="input-control" onchange="app.updateEditInvoiceItemQty(${idx}, this.value)">
                <button class="btn btn-light" style="padding:2px 6px; font-size:11px;" onclick="app.adjustEditInvoiceItemQty(${idx}, 1)">+</button>
                <span style="font-weight:700; min-width:65px; text-align:right; font-size:12px;">₹${itemSubtotal.toFixed(2)}</span>
                <button class="btn btn-danger" style="padding:4px 6px; font-size:11px;" onclick="app.removeEditInvoiceItem(${idx})" title="Remove item">🗑️</button>
              </div>
            </div>
          `;
        });
        document.getElementById('editInvTotalLabel').innerText = `₹${total.toFixed(2)}`;
      }

      async saveEditedInvoice() {
        if (!this.activePreviewInvoice) return;
        const invIndex = this.invoices.findIndex(i => String(i.id) === String(this.activePreviewInvoice.id));
        if (invIndex === -1) return;

        if (!this.tempEditItems.length) return alert('Invoice must contain at least one item.');

        const oldInv = this.invoices[invIndex];
        const newTotal = Number(this.tempEditItems.reduce((s, i) => s + ((Number(i.price) || 0) * (Number(i.qty) || 0)), 0).toFixed(2));
        const newMode = document.getElementById('editInvModeSelect').value;
        const dateVal = document.getElementById('editInvDateInput')?.value;
        const newDate = dateVal ? new Date(dateVal).toISOString() : oldInv.date;
        const custId = document.getElementById('editInvCustomerSelect')?.value;
        const newCust = custId ? this.customers.find(c => String(c.id) === String(custId)) : null;

        if (newMode === 'Credit' && !newCust) {
          return alert('Credit billing requires an assigned customer.');
        }

        // Adjust product stock differences
        (oldInv.items || []).forEach(oldItem => {
          const p = this.products.find(prod => String(prod.id) === String(oldItem.id));
          if (p) p.stock = Number(((Number(p.stock) || 0) + (Number(oldItem.qty) || 0)).toFixed(2));
        });
        this.tempEditItems.forEach(newItem => {
          const p = this.products.find(prod => String(prod.id) === String(newItem.id));
          if (p) p.stock = Number(Math.max(0, (Number(p.stock) || 0) - (Number(newItem.qty) || 0)).toFixed(2));
        });

        // Update or adjust ledger entry if mode was/is Credit
        const oldLedgerIdx = this.ledger.findIndex(l => String(l.invoiceId) === String(oldInv.id));
        const itemSummary = this.tempEditItems.map(i => `${i.name} (x${Number(i.qty).toFixed(1)})`).join(', ');
        const editNote = `Bill #${oldInv.id}: ${itemSummary}`;
        if (newMode === 'Credit') {
          if (oldLedgerIdx > -1) {
            this.ledger[oldLedgerIdx].amount = newTotal;
            this.ledger[oldLedgerIdx].customerId = newCust ? newCust.id : oldInv.customer?.id;
            this.ledger[oldLedgerIdx].customerName = newCust ? newCust.name : oldInv.customer?.name;
            this.ledger[oldLedgerIdx].date = newDate;
            this.ledger[oldLedgerIdx].note = editNote;
          } else if (newCust) {
            this.ledger.push({
              id: Date.now().toString(),
              customerId: newCust.id,
              customerName: newCust.name,
              type: 'debit',
              amount: newTotal,
              invoiceId: oldInv.id,
              note: editNote,
              date: newDate
            });
          }
        } else if (oldLedgerIdx > -1) {
          this.ledger.splice(oldLedgerIdx, 1);
        }

        // Update invoice object
        this.invoices[invIndex] = {
          ...oldInv,
          customer: newCust ? { ...newCust } : null,
          items: JSON.parse(JSON.stringify(this.tempEditItems)),
          total: newTotal,
          mode: newMode,
          date: newDate
        };

        await this.persistAllData();
        this.closeModals();
        this.initAsync();
        this.showToast(`✅ Invoice #${oldInv.id} updated successfully!`, 'success');
      }

      async deleteInvoice(id) {
        if (!id) return;
        const inv = this.invoices.find(i => String(i.id) === String(id));
        if (!inv) return;

        this.requestSecurityAuthorization(`Delete Invoice #${inv.id}`, async () => {
          const confirmMsg = `Are you sure you want to delete Invoice #${inv.id} (₹${inv.total})?\n\n` +
            `• All items (${inv.items?.length || 0}) will be returned to inventory stock.\n` +
            `• Any related Khata credit transaction will be removed.`;

          if (!confirm(confirmMsg)) return;

          // Track deletion tombstone
          this.trackDeletion('invoices', inv.id);

          // Restore inventory stock
          (inv.items || []).forEach(item => {
            const p = this.products.find(prod => String(prod.id) === String(item.id));
            if (p) {
              p.stock = Number(((Number(p.stock) || 0) + (Number(item.qty) || 0)).toFixed(2));
              p.updatedAt = new Date().toISOString();
            }
          });

          // Remove linked ledger entries and track their tombstones
          const linkedTxs = this.ledger.filter(l => String(l.invoiceId) === String(inv.id) || (l.note && l.note.includes(`Bill #${inv.id}`)));
          linkedTxs.forEach(l => this.trackDeletion('ledger', l.id));
          this.ledger = this.ledger.filter(l => String(l.invoiceId) !== String(inv.id) && !(l.note && l.note.includes(`Bill #${inv.id}`)));

          // Remove invoice
          this.invoices = this.invoices.filter(i => String(i.id) !== String(inv.id));

          await this.persistAllData();
          this.closeModals();
          this.initAsync();
          this.showToast(`🗑️ Invoice #${inv.id} deleted & inventory restored.`, 'success');
        });
      }

      deleteInvoiceFromPreview() {
        if (this.activePreviewInvoice) this.deleteInvoice(this.activePreviewInvoice.id);
      }

      deleteInvoiceFromEditModal() {
        if (this.activePreviewInvoice) this.deleteInvoice(this.activePreviewInvoice.id);
      }

      printBill(inv) {
        document.getElementById('prtStoreName').innerText = this.shop.name || 'Vyaparify Retail';
        document.getElementById('prtTagline').innerText = this.shop.tagline || '';
        document.getElementById('prtAddress').innerText = this.shop.address || '';
        document.getElementById('prtPhoneEmail').innerText = `Phone: ${this.shop.phone || '-'} | Email: ${this.shop.email || '-'}`;
        document.getElementById('prtGstFssai').innerText = `GST: ${this.shop.gst || '-'} | FSSAI: ${this.shop.fssai || '-'}`;
        document.getElementById('prtBillId').innerText = 'Bill ID: ' + inv.id;
        document.getElementById('prtBillDate').innerText = 'Date: ' + this.formatDateTime(inv.date) + ' | Terminal: ' + (inv.device || this.deviceName || 'Counter 1');
        
        const cust = inv.customer || {};
        document.getElementById('prtCustName').innerText = cust.name || 'Walk-in';
        document.getElementById('prtCustPhone').innerText = cust.phone || '-';
        document.getElementById('prtCustEmail').innerText = cust.email || '-';
        document.getElementById('prtCustAddress').innerText = cust.address || '-';
        document.getElementById('prtPayMode').innerText = inv.mode || 'Cash';
        document.getElementById('prtGrandTotal').innerText = `₹${Number(inv.total || 0).toFixed(2)}`;
        
        const tbody = document.getElementById('prtItemsBody');
        tbody.innerHTML = '';
        (inv.items || []).forEach(i => {
          tbody.innerHTML += `<tr><td>${this.escapeHtml(i.name)}</td><td align="center">${Number(i.qty || 0).toFixed(2)}</td><td align="right">₹${Number(i.price).toFixed(2)}</td><td align="right">₹${(Number(i.price) * Number(i.qty)).toFixed(2)}</td></tr>`;
        });
        document.body.className = 'print-inv';
        window.onafterprint = () => { document.body.className = ''; };
        window.print();
        setTimeout(() => { document.body.className = ''; }, 1500);
      }

      openCustomerSelectionModal() {
        document.getElementById('custModalSearch').value = '';
        this.renderCustomerSelectList();
        document.getElementById('selectCustomerModal').classList.add('active');
      }

      renderCustomerSelectList(query = '') {
        const container = document.getElementById('customerSelectListContainer');
        container.innerHTML = `<div class="cust-select-item" onclick="app.selectCustomer(null)"><div><strong>Walk-in Customer</strong></div><button class="btn btn-light" style="font-size:11px;">Select</button></div>`;
        this.customers.filter(c => (c.name || '').toLowerCase().includes(query.toLowerCase())).forEach(cust => {
          container.innerHTML += `<div class="cust-select-item" onclick='app.selectCustomer(${JSON.stringify(cust)})'><div><strong>${cust.name}</strong><br><small>${cust.phone || ''}</small></div><button class="btn btn-light" style="font-size:11px;">Select</button></div>`;
        });
      }

      selectCustomer(cust) {
        this.selectedCustomer = cust;
        document.getElementById('posCustomerLabel').innerText = cust ? cust.name : 'Walk-in';
        this.closeModals();
      }

      openManualKhataModal() {
        const select = document.getElementById('manualKhataCustSelect');
        select.innerHTML = '';
        this.customers.forEach(c => { select.innerHTML += `<option value="${c.id}">${c.name}</option>`; });
        document.getElementById('manualKhataModal').classList.add('active');
      }

      async saveManualKhataEntry() {
        const customerId = document.getElementById('manualKhataCustSelect').value;
        const type = document.getElementById('manualKhataType').value;
        const amount = Number(document.getElementById('manualKhataAmount').value) || 0;
        const note = document.getElementById('manualKhataNote').value.trim() || 'Manual Entry';
        if (!customerId || amount <= 0) return alert('Enter valid customer and amount.');

        const cust = this.customers.find(c => String(c.id) === String(customerId));
        this.ledger.push({ id: Date.now().toString(), customerId, customerName: cust ? cust.name : '', type, amount, note, date: new Date().toISOString(), device: this.deviceName || 'Counter 1' });
        await this.persistAllData();
        this.closeModals();
        this.initAsync();
      }

      openCustomerStatement(cId) {
        const cust = this.customers.find(c => String(c.id) === String(cId));
        if (!cust) return;
        this.currentStatementCustomer = cust;
        const txs = this.ledger.filter(l => String(l.customerId) === String(cId));
        const due = this.getCustomerDue(cId);

        let html = `
          <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: 8px; padding: 12px; margin-bottom: 12px;">
            <div style="font-size: 15px; font-weight: 800; color: var(--slate-800);">${cust.name}</div>
            <div style="font-size: 12px; color: var(--slate-600); margin-top: 2px;">
              📞 ${cust.phone || 'No phone'} • ✉️ ${cust.email || 'No email'} • 📍 ${cust.address || 'No address'}
            </div>
            <div style="margin-top: 8px; font-size: 14px; font-weight: 800;">
              Net Status: <span style="color: ${due > 0 ? 'var(--amber)' : 'var(--emerald)'};">
                ${due > 0 ? `Pending Due: ₹${due.toFixed(2)}` : due < 0 ? `Advance Balance: ₹${Math.abs(due).toFixed(2)}` : 'All Cleared (₹0.00)'}
              </span>
            </div>
          </div>
          <div style="max-height: 260px; overflow-y: auto; border: 1px solid var(--slate-200); border-radius: 8px; padding: 6px;">
        `;

        if (!txs.length) {
          html += `<div style="text-align: center; color: var(--slate-400); padding: 20px; font-size: 12px;">No transactions recorded for this customer yet.</div>`;
        } else {
          txs.forEach(t => {
            const isDebit = t.type === 'debit';
            let linkedInv = null;
            if (t.invoiceId) {
              linkedInv = this.invoices.find(i => String(i.id) === String(t.invoiceId));
            } else if (t.note) {
              const match = t.note.match(/Bill #([A-Za-z0-9\-]+)/i);
              if (match) linkedInv = this.invoices.find(i => String(i.id) === String(match[1]));
            }

            let invoiceBreakdownHtml = '';
            if (linkedInv && linkedInv.items && linkedInv.items.length) {
              const itemsPills = linkedInv.items.map(i => `
                <span style="display:inline-flex; align-items:center; background:#ffffff; border:1px solid var(--slate-200); border-radius:4px; padding:2px 6px; margin:2px 4px 2px 0; font-size:11px;">
                  <strong style="color:var(--slate-800);">${this.escapeHtml(i.name)}</strong>&nbsp;×${Number(i.qty).toFixed(1)}&nbsp;<span style="color:var(--slate-500);">(₹${(Number(i.price) * Number(i.qty)).toFixed(2)})</span>
                </span>
              `).join('');

              invoiceBreakdownHtml = `
                <div style="margin-top:6px; background:var(--slate-50); border:1px solid var(--slate-200); border-radius:6px; padding:6px 8px;">
                  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                    <span style="font-weight:700; color:var(--primary); font-size:11.5px;">🧾 Bill #${this.escapeHtml(linkedInv.id)} (${linkedInv.items.length} items)</span>
                    <button class="btn btn-light" style="padding:2px 7px; font-size:10.5px; border:1px solid var(--slate-300);" onclick="app.openInvoiceActionModalById('${linkedInv.id}')">View Bill ➔</button>
                  </div>
                  <div style="line-height:1.4;">${itemsPills}</div>
                </div>
              `;
            } else if (t.note) {
              invoiceBreakdownHtml = `<div style="margin-top:4px; font-size:11px; color:var(--slate-600); font-style:italic;">📝 ${this.escapeHtml(t.note)}</div>`;
            }

            html += `
              <div style="padding: 10px; border-bottom: 1px solid var(--slate-100); font-size: 12px; transition: background 0.2s;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                  <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                    <span class="badge ${isDebit ? 'badge-due' : 'badge-paid'}" style="font-size: 10.5px; padding: 2px 7px;">
                      ${isDebit ? 'You Gave (Udhar)' : 'Payment Received'}
                    </span>
                    <span class="badge" style="background:#eff6ff; color:#1e40af; font-size:10px; padding:1px 6px;">💻 ${this.escapeHtml(t.device || 'Counter 1')}</span>
                    <small style="color: var(--slate-500);">${this.formatDateTime(t.date)}</small>
                  </div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-weight: 800; font-size: 14px; color: ${isDebit ? 'var(--amber)' : 'var(--emerald)'}; white-space: nowrap;">
                      ${isDebit ? '+' : '-'}₹${Number(t.amount || 0).toFixed(2)}
                    </span>
                    <button class="btn btn-light" style="padding: 3px 6px; font-size: 11px;" title="Edit Transaction" onclick="app.openEditKhataModal('${t.id}')">✏️</button>
                    <button class="btn btn-danger" style="padding: 3px 6px; font-size: 11px;" title="Delete Transaction" onclick="app.deleteKhataEntry('${t.id}')">🗑️</button>
                  </div>
                </div>
                ${invoiceBreakdownHtml}
              </div>
            `;
          });
        }
        html += `</div>`;
        document.getElementById('statementContent').innerHTML = html;

        // Wire statement modal action buttons
        document.getElementById('statementRepayBtn').onclick = () => {
          this.closeModals();
          this.openManualKhataModalWithCust(cust.id, 'repay');
        };
        document.getElementById('statementAdvanceBtn').onclick = () => {
          this.closeModals();
          this.openManualKhataModalWithCust(cust.id, 'debit');
        };

        // Populate printable statement container for high quality printing
        document.getElementById('prtStmtStoreName').innerText = this.shop.name || 'Vyaparify Retail';
        document.getElementById('prtStmtStoreInfo').innerText = `${this.shop.address || ''} • Phone: ${this.shop.phone || ''} • GST: ${this.shop.gst || ''}`;
        document.getElementById('prtStmtCustInfo').innerHTML = `
          <strong>Customer:</strong> ${cust.name}<br>
          <strong>Phone:</strong> ${cust.phone || '-'} | <strong>Email:</strong> ${cust.email || '-'}<br>
          <strong>Address:</strong> ${cust.address || '-'}<br>
          <strong>Statement Date:</strong> ${this.formatDateTime(new Date().toISOString())}
        `;
        const prtStmtRows = document.getElementById('prtStmtRows');
        prtStmtRows.innerHTML = '';
        txs.forEach(t => {
          const isDebit = t.type === 'debit';
          let descText = t.note || (isDebit ? 'Credit Bill' : 'Payment Received');
          let linkedInv = null;
          if (t.invoiceId) {
            linkedInv = this.invoices.find(i => String(i.id) === String(t.invoiceId));
          } else if (t.note) {
            const match = t.note.match(/Bill #([A-Za-z0-9\-]+)/i);
            if (match) linkedInv = this.invoices.find(i => String(i.id) === String(match[1]));
          }
          if (linkedInv && linkedInv.items && linkedInv.items.length) {
            const itemsStr = linkedInv.items.map(i => `${i.name} x${Number(i.qty).toFixed(1)} (@₹${Number(i.price).toFixed(2)})`).join(', ');
            descText = `Bill #${linkedInv.id}: ${itemsStr}`;
          }
          prtStmtRows.innerHTML += `
            <tr style="border-bottom: 1px solid #ccc;">
              <td style="padding: 4px 0; vertical-align: top;">
                ${this.formatDateTime(t.date)}
                <div style="font-size: 10px; color: #555;">💻 ${this.escapeHtml(t.device || 'Counter 1')}</div>
              </td>
              <td style="padding: 4px 0; vertical-align: top;"><strong>${this.escapeHtml(descText)}</strong></td>
              <td style="padding: 4px 0; text-align: right; vertical-align: top;">${isDebit ? '₹' + Number(t.amount).toFixed(2) : '-'}</td>
              <td style="padding: 4px 0; text-align: right; vertical-align: top;">${!isDebit ? '₹' + Number(t.amount).toFixed(2) : '-'}</td>
            </tr>
          `;
        });
        document.getElementById('prtStmtBalanceSummary').innerText = `Net Balance: ₹${due.toFixed(2)} (${due > 0 ? 'Due to Store' : due < 0 ? 'Advance' : 'Cleared'})`;

        document.getElementById('statementModal').classList.add('active');
      }

      openManualKhataModalWithCust(custId, type = 'repay') {
        this.openManualKhataModal();
        const custSelect = document.getElementById('manualKhataCustSelect');
        if (custSelect) custSelect.value = custId;
        const typeSelect = document.getElementById('manualKhataType');
        if (typeSelect) typeSelect.value = type;
        const amtInput = document.getElementById('manualKhataAmount');
        if (amtInput) { amtInput.value = ''; amtInput.focus(); }
      }

      printCurrentStatement() {
        document.body.className = 'print-stmt';
        window.onafterprint = () => { document.body.className = ''; };
        window.print();
        setTimeout(() => { document.body.className = ''; }, 1500);
      }

      openEditKhataModal(id) {
        const tx = this.ledger.find(t => String(t.id) === String(id));
        if (!tx) return alert('Khata transaction not found.');
        this.currentEditingKhataTx = tx;
        document.getElementById('editKhataId').value = tx.id;
        document.getElementById('editKhataCustName').value = tx.customerName || (this.customers.find(c => String(c.id) === String(tx.customerId))?.name || 'Customer');
        document.getElementById('editKhataType').value = tx.type || 'debit';
        document.getElementById('editKhataAmount').value = tx.amount || 0;
        document.getElementById('editKhataDate').value = tx.date ? tx.date.slice(0, 16) : new Date().toISOString().slice(0, 16);
        document.getElementById('editKhataNote').value = tx.note || '';

        const invRow = document.getElementById('editKhataInvoiceLinkRow');
        const invIdText = document.getElementById('editKhataInvIdText');
        const invItemsText = document.getElementById('editKhataInvItemsText');
        
        let linkedInv = null;
        if (tx.invoiceId) {
          linkedInv = this.invoices.find(i => String(i.id) === String(tx.invoiceId));
        } else if (tx.note) {
          const match = tx.note.match(/Bill #([A-Za-z0-9\-]+)/i);
          if (match) linkedInv = this.invoices.find(i => String(i.id) === String(match[1]));
        }

        if (linkedInv) {
          if (invRow) invRow.style.display = 'block';
          if (invIdText) invIdText.innerText = '#' + linkedInv.id;
          if (invItemsText && linkedInv.items) {
            invItemsText.innerText = linkedInv.items.map(i => `${i.name} × ${Number(i.qty).toFixed(1)} (@₹${Number(i.price).toFixed(2)})`).join(', ');
          }
        } else {
          if (invRow) invRow.style.display = 'none';
        }

        document.getElementById('editKhataEntryModal').classList.add('active');
      }

      viewLinkedInvoiceFromEditModal() {
        if (this.currentEditingKhataTx) {
          let invId = this.currentEditingKhataTx.invoiceId;
          if (!invId && this.currentEditingKhataTx.note) {
            const match = this.currentEditingKhataTx.note.match(/Bill #([A-Za-z0-9\-]+)/i);
            if (match) invId = match[1];
          }
          if (invId) {
            this.closeModals();
            this.openInvoiceActionModalById(invId);
          }
        }
      }

      async saveEditedKhataEntry() {
        const id = document.getElementById('editKhataId').value;
        const tx = this.ledger.find(t => String(t.id) === String(id));
        if (!tx) return;
        const newType = document.getElementById('editKhataType').value;
        const newAmount = Number(document.getElementById('editKhataAmount').value) || 0;
        const newDate = document.getElementById('editKhataDate').value ? new Date(document.getElementById('editKhataDate').value).toISOString() : tx.date;
        const newNote = document.getElementById('editKhataNote').value.trim();

        if (newAmount <= 0) return alert('Please enter a valid amount greater than 0.');

        tx.type = newType;
        tx.amount = newAmount;
        tx.date = newDate;
        tx.note = newNote;
        tx.updatedAt = new Date().toISOString();

        await this.persistAllData();
        document.getElementById('editKhataEntryModal').classList.remove('active');
        this.renderLedger();
        if (tx.customerId) {
          this.openCustomerStatement(tx.customerId);
        }
        this.showToast('✅ Khata transaction updated successfully!', 'success');
      }

      async deleteKhataEntry(id) {
        const tx = this.ledger.find(t => String(t.id) === String(id));
        if (!tx) return;
        if (!confirm(`Are you sure you want to delete this ${tx.type === 'debit' ? 'debit' : 'payment'} entry of ₹${tx.amount}?`)) return;
        const custId = tx.customerId;
        this.trackDeletion('ledger', id);
        this.ledger = this.ledger.filter(t => String(t.id) !== String(id));
        await this.persistAllData();
        this.renderLedger();
        if (document.getElementById('editKhataEntryModal').classList.contains('active')) {
          document.getElementById('editKhataEntryModal').classList.remove('active');
        }
        if (custId) {
          this.openCustomerStatement(custId);
        }
        this.showToast('🗑️ Khata transaction deleted.', 'info');
      }

      deleteKhataEntryFromEditModal() {
        const id = document.getElementById('editKhataId').value;
        if (id) this.deleteKhataEntry(id);
      }

      async triggerClearDataFlow() {
        this.requestSecurityAuthorization('Complete Factory Reset', async () => {
          if (prompt("Type RESET to wipe all data:") !== "RESET") return;
          localStorage.clear();
          alert('All local storage cleared.');
          window.location.reload();
        });
      }

      sortData(entity, field) {
        this.sortState.asc = this.sortState.key === field ? !this.sortState.asc : true;
        this.sortState.key = field;
        if (entity === 'products') this.renderInventory();
        else if (entity === 'invoices') this.renderInvoices();
        else if (entity === 'customers') this.renderCustomers();
      }

      renderInventory(items = this.products) {
        const tb = document.getElementById('inventoryTableBody');
        tb.innerHTML = '';
        if (!items.length) {
          tb.innerHTML = `<tr><td colspan="5" align="center" style="color:var(--slate-400); padding:24px;">No inventory items found.</td></tr>`;
          return;
        }
        items.forEach(p => {
          const stockNum = Number(p.stock || 0);
          const stockBadge = stockNum <= 0 
            ? `<span class="badge" style="background:#fee2e2; color:#b91c1c;">Out of Stock</span>`
            : stockNum <= 5
              ? `<span class="badge badge-due">${stockNum.toFixed(2)} (Low)</span>`
              : `<span class="badge badge-paid">${stockNum.toFixed(2)}</span>`;
          tb.innerHTML += `<tr>
            <td><strong>${this.escapeHtml(p.name)}</strong></td>
            <td><strong>₹${Number(p.price || 0).toFixed(2)}</strong></td>
            <td>${stockBadge}</td>
            <td style="color:var(--slate-600); font-size:12px;">${this.formatDateTime(p.updatedAt)}</td>
            <td align="right">
              <button class="btn btn-light" style="padding:4px 8px; font-size:12px;" onclick="app.editProduct('${p.id}')">Edit</button> 
              <button class="btn btn-danger" style="padding:4px 8px; font-size:12px; margin-left:4px;" onclick="app.deleteProduct('${p.id}')">Delete</button>
            </td>
          </tr>`;
        });
      }

      filterInventory(q) { this.renderInventory(this.products.filter(p => (p.name || '').toLowerCase().includes(q.toLowerCase()))); }
      filterInventoryStock(type) {
        if (type === 'low') this.renderInventory(this.products.filter(p => Number(p.stock || 0) <= 5));
        else if (type === 'out') this.renderInventory(this.products.filter(p => Number(p.stock || 0) <= 0));
        else this.renderInventory(this.products);
      }

      openProductModal() {
        document.getElementById('prodEditId').value = '';
        document.getElementById('prodNameInput').value = '';
        document.getElementById('prodPriceInput').value = '';
        document.getElementById('prodStockInput').value = '';
        document.getElementById('productModal').classList.add('active');
      }

      async saveProduct() {
        const id = document.getElementById('prodEditId').value || Date.now().toString();
        const name = document.getElementById('prodNameInput').value.trim();
        const price = Number(document.getElementById('prodPriceInput').value) || 0;
        const stock = Number(document.getElementById('prodStockInput').value) || 0;
        if (!name) return alert('Name required');
        if (this.deletedIds && this.deletedIds.products) delete this.deletedIds.products[String(id)];
        const idx = this.products.findIndex(p => String(p.id) === String(id));
        if (idx > -1) this.products[idx] = { id, name, price, stock, updatedAt: new Date().toISOString() };
        else this.products.push({ id, name, price, stock, updatedAt: new Date().toISOString() });
        await this.persistAllData();
        this.closeModals();
        this.initAsync();
      }

      editProduct(id) {
        const p = this.products.find(prod => String(prod.id) === String(id));
        if (!p) return;
        document.getElementById('prodEditId').value = p.id;
        document.getElementById('prodNameInput').value = p.name;
        document.getElementById('prodPriceInput').value = p.price;
        document.getElementById('prodStockInput').value = p.stock;
        document.getElementById('productModal').classList.add('active');
      }

      async deleteProduct(id) {
        if (confirm('Delete product?')) {
          this.trackDeletion('products', id);
          this.products = this.products.filter(p => String(p.id) !== String(id));
          await this.persistAllData();
          this.initAsync();
          this.showToast('🗑️ Product deleted.', 'info');
        }
      }

      renderInvoices(items = this.invoices) {
        const tb = document.getElementById('invoicesTableBody');
        tb.innerHTML = '';
        if (!items.length) {
          tb.innerHTML = `<tr><td colspan="6" align="center" style="color:var(--slate-400); padding:24px;">No invoice records found.</td></tr>`;
          return;
        }
        items.forEach(inv => {
          const custName = inv.customer && inv.customer.name ? this.escapeHtml(inv.customer.name) : 'Walk-in';
          tb.innerHTML += `
            <tr>
              <td>
                <strong>${this.escapeHtml(inv.id)}</strong>
                <div style="margin-top: 2px;"><span class="badge" style="background:#eff6ff; color:#1e40af; font-size:10px; padding:1px 6px;">💻 ${this.escapeHtml(inv.device || 'Counter 1')}</span></div>
              </td>
              <td style="color:var(--slate-600); font-size:12px;">${this.formatDateTime(inv.date)}</td>
              <td>${custName}</td>
              <td><span class="badge ${inv.mode === 'Credit' ? 'badge-due' : 'badge-paid'}">${this.escapeHtml(inv.mode)}</span></td>
              <td><strong style="color:var(--primary);">₹${Number(inv.total || 0).toFixed(2)}</strong></td>
              <td align="right" style="white-space: nowrap;">
                <button class="btn" style="background: #25D366; color: #fff; font-size: 11px; padding: 4px 8px; margin-right: 4px;" onclick="app.shareInvoiceWhatsAppById('${inv.id}')" title="Send Bill on WhatsApp">📱 WhatsApp</button>
                <button class="btn btn-light" style="font-size: 11px; padding: 4px 8px;" onclick="app.openEditInvoiceModalById('${inv.id}')">Edit</button>
                <button class="btn btn-primary" style="font-size: 11px; padding: 4px 8px; margin-left: 2px;" onclick="app.openInvoiceActionModalById('${inv.id}')">View</button>
                <button class="btn btn-danger" style="font-size: 11px; padding: 4px 8px; margin-left: 4px;" onclick="app.deleteInvoice('${inv.id}')" title="Delete Invoice">Delete</button>
              </td>
            </tr>
          `;
        });
      }

      filterInvoices(q) { this.renderInvoices(this.invoices.filter(i => String(i.id).toLowerCase().includes(q.toLowerCase()))); }
      filterInvoicesMode(m) { this.renderInvoices(m === 'all' ? this.invoices : this.invoices.filter(i => i.mode === m)); }

      getCustomerDue(id) {
        const txs = this.ledger.filter(l => String(l.customerId) === String(id));
        return Number(txs.reduce((acc, t) => t.type === 'debit' ? acc + (Number(t.amount) || 0) : acc - (Number(t.amount) || 0), 0).toFixed(2));
      }

      renderLedger() {
        const tb = document.getElementById('ledgerTableBody');
        tb.innerHTML = '';
        let totalOutStanding = 0;
        if (!this.customers.length) {
          tb.innerHTML = `<tr><td colspan="5" align="center" style="color:var(--slate-400); padding:24px;">No khata accounts found.</td></tr>`;
          document.getElementById('khataTotalBadge').innerText = `Total Market Due: ₹0.00`;
          return;
        }
        this.customers.forEach(c => {
          const due = this.getCustomerDue(c.id);
          totalOutStanding += Math.max(0, due);
          const contactInfo = [c.phone, c.address].filter(Boolean).map(x => this.escapeHtml(x)).join(' • ');
          tb.innerHTML += `
            <tr>
              <td><strong>${this.escapeHtml(c.name)}</strong></td>
              <td style="color:var(--slate-600); font-size:12.5px;">${contactInfo || 'N/A'}</td>
              <td style="color:${due > 0 ? 'var(--amber)' : 'var(--emerald)'}; font-weight:bold;">₹${due.toFixed(2)}</td>
              <td style="color:var(--slate-500); font-size:12px;">${this.formatDateTime(c.updatedAt || c.createdAt)}</td>
              <td align="right">
                <button class="btn" style="background: #25D366; color: #fff; font-size: 11px; padding: 4px 8px; margin-right: 4px;" onclick="app.shareCustomerKhataWhatsApp('${c.id}')" title="Send WhatsApp Statement / Reminder">📱 WhatsApp</button>
                <button class="btn btn-light" style="font-size: 11px; padding: 4px 8px;" onclick="app.openCustomerStatement('${c.id}')">Statement</button>
              </td>
            </tr>
          `;
        });
        document.getElementById('khataTotalBadge').innerText = `Total Market Due: ₹${totalOutStanding.toFixed(2)}`;
      }

      renderCustomers(items = this.customers) {
        const tb = document.getElementById('customersTableBody');
        tb.innerHTML = '';
        if (!items.length) {
          tb.innerHTML = `<tr><td colspan="7" align="center" style="color:var(--slate-400); padding:24px;">No customer records found.</td></tr>`;
          return;
        }
        items.forEach(c => {
          tb.innerHTML += `
            <tr>
              <td><strong>${this.escapeHtml(c.name)}</strong></td>
              <td>${c.phone ? this.escapeHtml(c.phone) : '-'}</td>
              <td>${c.email ? this.escapeHtml(c.email) : '-'}</td>
              <td>${c.address ? this.escapeHtml(c.address) : '-'}</td>
              <td>${c.gst ? this.escapeHtml(c.gst) : '-'}</td>
              <td style="font-size:12px; color:var(--slate-600);">${this.formatDateTime(c.createdAt)}</td>
              <td align="right">
                <button class="btn" style="background: #25D366; color: #fff; font-size: 11px; padding: 4px 8px; margin-right: 4px;" onclick="app.shareCustomerKhataWhatsApp('${c.id}')" title="Send WhatsApp Message">📱 WhatsApp</button>
                <button class="btn btn-light" style="font-size: 11px; padding: 4px 8px;" onclick="app.editCustomer('${c.id}')">Edit</button>
                <button class="btn btn-danger" style="font-size: 11px; padding: 4px 8px; margin-left: 4px;" onclick="app.deleteCustomer('${c.id}')" title="Delete Customer">Delete</button>
              </td>
            </tr>
          `;
        });
      }

      filterCustomers(q) { this.renderCustomers(this.customers.filter(c => (c.name || '').toLowerCase().includes(q.toLowerCase()))); }

      openCustomerModal(returnToPos = false) {
        const title = document.getElementById('custModalTitle');
        if (title) title.innerText = 'Add Customer Profile';
        const delBtn = document.getElementById('custModalDeleteBtn');
        if (delBtn) delBtn.style.display = 'none';
        document.getElementById('custEditId').value = '';
        document.getElementById('custReturnToPos').value = returnToPos ? 'true' : 'false';
        document.getElementById('custNameInput').value = '';
        document.getElementById('custPhoneInput').value = '';
        document.getElementById('custEmailInput').value = '';
        document.getElementById('custAddressInput').value = '';
        document.getElementById('custGstInput').value = '';
        document.getElementById('customerModal').classList.add('active');
      }

      editCustomer(id) {
        const cust = this.customers.find(c => String(c.id) === String(id));
        if (!cust) return;
        const title = document.getElementById('custModalTitle');
        if (title) title.innerText = 'Edit Customer Profile';
        const delBtn = document.getElementById('custModalDeleteBtn');
        if (delBtn) delBtn.style.display = 'inline-block';
        document.getElementById('custEditId').value = cust.id;
        document.getElementById('custReturnToPos').value = 'false';
        document.getElementById('custNameInput').value = cust.name || '';
        document.getElementById('custPhoneInput').value = cust.phone || '';
        document.getElementById('custEmailInput').value = cust.email || '';
        document.getElementById('custAddressInput').value = cust.address || '';
        document.getElementById('custGstInput').value = cust.gst || '';
        document.getElementById('customerModal').classList.add('active');
      }

      async saveCustomer() {
        const id = document.getElementById('custEditId').value || Date.now().toString();
        const returnToPos = document.getElementById('custReturnToPos').value === 'true';
        const name = document.getElementById('custNameInput').value.trim();
        const phone = document.getElementById('custPhoneInput').value.trim();
        const email = document.getElementById('custEmailInput').value.trim();
        const address = document.getElementById('custAddressInput').value.trim();
        const gst = document.getElementById('custGstInput').value.trim();
        if (!name) return alert('Name required');
        if (this.deletedIds && this.deletedIds.customers) delete this.deletedIds.customers[String(id)];

        const nowIso = new Date().toISOString();
        const idx = this.customers.findIndex(c => String(c.id) === String(id));
        let savedCustomer = null;
        if (idx > -1) {
          this.customers[idx] = { ...this.customers[idx], name, phone, email, address, gst, updatedAt: nowIso };
          savedCustomer = this.customers[idx];
        } else {
          savedCustomer = { id, name, phone, email, address, gst, createdAt: nowIso, updatedAt: nowIso };
          this.customers.push(savedCustomer);
        }

        await this.persistAllData();
        this.closeModals();
        this.initAsync();

        if (returnToPos && savedCustomer) {
          this.selectCustomer(savedCustomer);
        }
      }

      async deleteCustomer(id) {
        const cust = this.customers.find(c => String(c.id) === String(id));
        if (!cust) return;

        this.requestSecurityAuthorization(`Delete Customer "${cust.name}"`, async () => {
          const due = this.getCustomerDue(id);
          let msg = `Are you sure you want to delete customer "${cust.name}"?`;
          if (due !== 0) {
            msg = `WARNING: Customer "${cust.name}" has an outstanding balance of ₹${due.toFixed(2)}!\nDeleting this customer will permanently delete their account record.\n\nAre you sure you want to proceed?`;
          }
          if (!confirm(msg)) return;

          this.trackDeletion('customers', id);
          this.customers = this.customers.filter(c => String(c.id) !== String(id));
          await this.persistAllData();
          this.closeModals();
          this.initAsync();
          this.showToast(`🗑️ Customer "${cust.name}" deleted.`, 'info');
        });
      }

      deleteCustomerFromModal() {
        const id = document.getElementById('custEditId').value;
        if (id) this.deleteCustomer(id);
      }

      // ==========================================================
      // 01. WHATSAPP INTEGRATION (INVOICES & KHATA)
      // ==========================================================

      sanitizePhone(phone) {
        if (!phone) return '';
        const digits = String(phone).replace(/\D/g, '');
        if (digits.length === 10) return '91' + digits; // Auto-prefix Indian 10-digit mobile
        return digits;
      }

      openWhatsApp(phone, text) {
        const cleanPhone = this.sanitizePhone(phone);
        const encodedText = encodeURIComponent(text);
        const url = cleanPhone ? `https://wa.me/${cleanPhone}?text=${encodedText}` : `https://wa.me/?text=${encodedText}`;
        window.open(url, '_blank');
      }

      promptWhatsAppPhone(title, desc, defaultPhone, callback) {
        this.pendingWhatsAppAction = callback;
        document.getElementById('waPromptModalTitle').innerHTML = `<span style="color: #25D366;">📱</span> ${title}`;
        document.getElementById('waPromptModalDesc').innerText = desc || 'Enter customer WhatsApp phone number:';
        const rawDigits = String(defaultPhone || '').replace(/\D/g, '');
        const tenDigits = rawDigits.length === 12 && rawDigits.startsWith('91') ? rawDigits.slice(2) : rawDigits;
        document.getElementById('waPromptInputPhone').value = tenDigits;
        document.getElementById('whatsappPromptModal').classList.add('active');
        document.getElementById('waPromptInputPhone').focus();
      }

      submitWhatsAppPrompt(useInputNumber) {
        if (typeof this.pendingWhatsAppAction === 'function') {
          const phone = useInputNumber ? document.getElementById('waPromptInputPhone').value.trim() : '';
          const action = this.pendingWhatsAppAction;
          this.pendingWhatsAppAction = null;
          this.closeModals();
          action(phone);
        } else {
          this.closeModals();
        }
      }

      formatInvoiceWhatsAppText(inv) {
        const shopName = this.shop.name || 'Vyaparify Retail';
        const shopPhone = this.shop.phone ? `\n📞 *Contact:* ${this.shop.phone}` : '';
        const shopAddress = this.shop.address ? `\n📍 *Address:* ${this.shop.address}` : '';
        const custName = inv.customer ? inv.customer.name : 'Walk-in Customer';
        const dateStr = this.formatDateTime(inv.date);

        let itemLines = (inv.items || []).map((i, idx) => {
          const qty = Number(i.qty || 0).toFixed(2);
          const price = Number(i.price || 0).toFixed(2);
          const subtotal = ((Number(i.price) || 0) * (Number(i.qty) || 0)).toFixed(2);
          return `${idx + 1}. *${i.name}*\n   ${qty} × ₹${price} = ₹${subtotal}`;
        }).join('\n');

        let text = `🧾 *INVOICE / CASH BILL*\n`;
        text += `🏬 *${shopName}*${shopPhone}${shopAddress}\n`;
        text += `──────────────────\n`;
        text += `📋 *Bill ID:* #${inv.id}\n`;
        text += `📅 *Date & Time:* ${dateStr}\n`;
        text += `👤 *Customer:* ${custName}\n`;
        text += `💳 *Payment Mode:* ${inv.mode}\n`;
        text += `──────────────────\n`;
        text += `*ITEMS BILLED:*\n${itemLines}\n`;
        text += `──────────────────\n`;
        if (inv.appliedAdvance > 0) {
          text += `💰 *Advance Adjusted:* ₹${Number(inv.appliedAdvance).toFixed(2)}\n`;
        }
        text += `💵 *Grand Total:* *₹${Number(inv.total || 0).toFixed(2)}*\n`;
        text += `──────────────────\n`;
        text += `Thank you for shopping with us! Visit again! 🙏\n_Generated via Vyaparify Pro_`;
        return text;
      }

      shareInvoiceWhatsApp(inv, targetPhone = null) {
        if (!inv) return;
        const custPhone = targetPhone || (inv.customer ? inv.customer.phone : '');
        const messageText = this.formatInvoiceWhatsAppText(inv);

        if (custPhone) {
          this.openWhatsApp(custPhone, messageText);
        } else {
          this.promptWhatsAppPhone(
            `Share Invoice #${inv.id}`,
            `Sending bill for ${inv.customer ? inv.customer.name : 'Walk-in'}. Enter WhatsApp phone number:`,
            '',
            (phone) => { this.openWhatsApp(phone, messageText); }
          );
        }
      }

      shareInvoiceWhatsAppById(id) {
        const inv = this.invoices.find(i => String(i.id) === String(id));
        if (inv) this.shareInvoiceWhatsApp(inv);
      }

      formatKhataWhatsAppText(cust) {
        const shopName = this.shop.name || 'Vyaparify Retail';
        const shopPhone = this.shop.phone ? `\n📞 *Contact / UPI:* ${this.shop.phone}` : '';
        const due = this.getCustomerDue(cust.id);
        const txs = this.ledger.filter(l => String(l.customerId) === String(cust.id));
        const recentTxs = txs.slice(-5).reverse();

        let txLines = '';
        if (recentTxs.length > 0) {
          txLines = recentTxs.map(t => {
            const isDebit = t.type === 'debit';
            const label = isDebit ? 'You Gave (+)' : 'Payment Received (-)';
            let detail = t.note || '';
            let linkedInv = null;
            if (t.invoiceId) {
              linkedInv = this.invoices.find(i => String(i.id) === String(t.invoiceId));
            } else if (t.note) {
              const match = t.note.match(/Bill #([A-Za-z0-9\-]+)/i);
              if (match) linkedInv = this.invoices.find(i => String(i.id) === String(match[1]));
            }
            if (linkedInv && linkedInv.items && linkedInv.items.length) {
              const itemSummary = linkedInv.items.map(i => `${i.name} x${Number(i.qty).toFixed(1)}`).join(', ');
              detail = `Bill #${linkedInv.id}: ${itemSummary}`;
            }
            return `• ${this.formatDateTime(t.date).split(' ')[0]}: ${label} *₹${Number(t.amount || 0).toFixed(2)}*${detail ? `\n   ↳ _${detail}_` : ''}`;
          }).join('\n');
        } else {
          txLines = 'No past transactions.';
        }

        let statusText = due > 0 ? `⚠️ *Outstanding Balance Due:* *₹${due.toFixed(2)}*` : (due < 0 ? `🟢 *Advance Balance Credit:* *₹${Math.abs(due).toFixed(2)}*` : `✅ *Account Net Balance:* *₹0.00* (All Cleared)`);

        let text = `📒 *KHATA ACCOUNT STATEMENT*\n`;
        text += `🏬 *${shopName}*${shopPhone}\n`;
        text += `──────────────────\n`;
        text += `👤 *Customer Name:* ${cust.name}\n`;
        text += `📊 *Account Status:*\n${statusText}\n`;
        text += `──────────────────\n`;
        text += `*RECENT TRANSACTIONS:*\n${txLines}\n`;
        text += `──────────────────\n`;
        if (due > 0) {
          text += `🙏 *Friendly Reminder:* Kindly settle the outstanding balance of *₹${due.toFixed(2)}* at your earliest convenience.\n`;
          if (this.shop.phone) {
            text += `📲 For payment via UPI / GPay / PhonePe, contact: ${this.shop.phone}\n`;
          }
        } else {
          text += `Thank you for your prompt payments and relationship! 🙏\n`;
        }
        text += `_Generated via Vyaparify Pro_`;
        return text;
      }

      shareCustomerKhataWhatsApp(custId, targetPhone = null) {
        const cust = this.customers.find(c => String(c.id) === String(custId));
        if (!cust) return;
        const custPhone = targetPhone || cust.phone;
        const messageText = this.formatKhataWhatsAppText(cust);

        if (custPhone) {
          this.openWhatsApp(custPhone, messageText);
        } else {
          this.promptWhatsAppPhone(
            `Khata Statement for ${cust.name}`,
            `Customer does not have a phone number on record. Enter WhatsApp number:`,
            '',
            (phone) => {
              if (phone) {
                // Save customer phone for future
                cust.phone = phone;
                this.persistAllData();
              }
              this.openWhatsApp(phone, messageText);
            }
          );
        }
      }

      // ==========================================================
      // 02 & 03. GOOGLE DRIVE MULTI-DEVICE CLOUD SYNC & AUTO-BACKUP
      // ==========================================================

      syncGdriveInputs() {
        const clientIdInput = document.getElementById('gdriveClientIdInput');
        if (clientIdInput && document.activeElement !== clientIdInput) clientIdInput.value = this.gdriveConfig.clientId || '';
        const scriptUrlInput = document.getElementById('gdriveScriptUrlInput');
        if (scriptUrlInput && document.activeElement !== scriptUrlInput) scriptUrlInput.value = this.gdriveConfig.scriptUrl || '';
        const devNameInput = document.getElementById('gdriveDeviceNameInput');
        if (devNameInput && document.activeElement !== devNameInput) {
          devNameInput.value = this.deviceName || '';
        }
        const autoSyncCheck = document.getElementById('gdriveAutoSyncCheck');
        if (autoSyncCheck) autoSyncCheck.checked = this.gdriveConfig.autoSync !== false;
        const autoPullCheck = document.getElementById('gdriveAutoPullCheck');
        if (autoPullCheck) autoPullCheck.checked = this.gdriveConfig.autoPull !== false;
      }

      updateGdriveUI() {
        const isConnected = !!this.gdriveConfig.connected;
        const emailLabel = document.getElementById('gdriveEmailLabel');
        const badge = document.getElementById('gdriveStatusBadge');
        const lastSyncLabel = document.getElementById('gdriveLastSyncLabel');
        const headerDot = document.getElementById('cloudSyncStatusDot');
        const headerText = document.getElementById('cloudSyncHeaderText');
        const headerBadge = document.getElementById('cloudSyncHeaderBadge');
        const topDisconnectBtn = document.getElementById('gdriveTopDisconnectBtn');

        const email = this.gdriveConfig.email || (this.gdriveConfig.mode === 'webhook' ? 'Apps Script Connected' : 'Signed In');

        if (emailLabel) emailLabel.innerText = isConnected ? email : 'Not Signed In';
        if (topDisconnectBtn) topDisconnectBtn.style.display = isConnected ? 'inline-flex' : 'none';

        if (badge) {
          if (!isConnected) {
            badge.innerText = 'Not Connected';
            badge.style.background = '#dbeafe';
            badge.style.color = '#1d4ed8';
          } else if (this.cloudSyncError) {
            badge.innerText = '⚠️ Script Offline / Deleted';
            badge.style.background = '#fee2e2';
            badge.style.color = '#dc2626';
          } else {
            badge.innerText = `🟢 Synced (${this.gdriveConfig.mode.toUpperCase()})`;
            badge.style.background = 'var(--emerald-light)';
            badge.style.color = 'var(--emerald)';
          }
        }
        if (lastSyncLabel) {
          lastSyncLabel.innerText = this.lastCloudSyncTime ? `${this.formatDateTime(this.lastCloudSyncTime)} (v${this.cloudSyncVersion})` : 'Never';
          if (this.cloudSyncError) {
            lastSyncLabel.innerHTML += ' <span style="color:#dc2626; font-weight:700;">(Sync Failing)</span>';
          }
        }
        if (headerDot && headerText && headerBadge) {
          if (!isConnected) {
            headerDot.style.background = 'var(--slate-400)';
            headerText.innerText = 'Drive: Offline';
            headerBadge.style.borderColor = 'var(--slate-200)';
            headerBadge.style.background = 'var(--slate-100)';
            headerBadge.style.color = 'var(--slate-600)';
          } else if (this.cloudSyncError) {
            headerDot.style.background = '#dc2626';
            headerText.innerText = 'Drive: Script Error';
            headerBadge.style.borderColor = '#fca5a5';
            headerBadge.style.background = '#fef2f2';
            headerBadge.style.color = '#dc2626';
          } else {
            headerDot.style.background = 'var(--emerald)';
            headerText.innerText = `Drive: Synced (${this.deviceName})`;
            headerBadge.style.borderColor = 'var(--emerald)';
            headerBadge.style.background = 'var(--emerald-light)';
            headerBadge.style.color = 'var(--emerald)';
          }
        }
      }

      switchGdriveMode(mode) {
        this.gdriveConfig.mode = mode;
        this.saveLocal('vy_gdrive_config', this.gdriveConfig);
        const oauthSec = document.getElementById('gdriveOauthSection');
        const webSec = document.getElementById('gdriveWebhookSection');
        const btnO = document.getElementById('btnModeOauth');
        const btnW = document.getElementById('btnModeWebhook');

        if (mode === 'oauth') {
          if (oauthSec) oauthSec.style.display = 'block';
          if (webSec) webSec.style.display = 'none';
          if (btnO) { btnO.classList.add('btn-primary'); btnO.classList.remove('btn-light'); }
          if (btnW) { btnW.classList.remove('btn-primary'); btnW.classList.add('btn-light'); }
        } else {
          if (oauthSec) oauthSec.style.display = 'none';
          if (webSec) webSec.style.display = 'block';
          if (btnW) { btnW.classList.add('btn-primary'); btnW.classList.remove('btn-light'); }
          if (btnO) { btnO.classList.remove('btn-primary'); btnO.classList.add('btn-light'); }
        }
      }

      saveGdriveSettings() {
        const clientId = document.getElementById('gdriveClientIdInput')?.value.trim() || '';
        const autoSync = document.getElementById('gdriveAutoSyncCheck')?.checked ?? true;
        const autoPull = document.getElementById('gdriveAutoPullCheck')?.checked ?? true;

        this.gdriveConfig.clientId = clientId;
        this.gdriveConfig.autoSync = autoSync;
        this.gdriveConfig.autoPull = autoPull;
        this.saveLocal('vy_gdrive_config', this.gdriveConfig);
        this.showToast('✅ Google Drive settings saved.', 'success');
      }

      promptEditDeviceName() {
        const current = this.deviceName || 'Counter 1 (Web)';
        const newName = prompt('Enter a name for this device (e.g. Counter 1 (PC), Billing Laptop, Cash Register):', current);
        if (newName !== null) {
          const trimmed = newName.trim();
          if (!trimmed) {
            this.showToast('⚠️ Device name cannot be blank.', 'warning');
            return;
          }
          this.deviceName = trimmed;
          this.saveLocal('vy_device_name', this.deviceName);
          const devNameInput = document.getElementById('gdriveDeviceNameInput');
          if (devNameInput) devNameInput.value = this.deviceName;
          this.updateGdriveUI();
          this.showToast(`✅ Device name set to: "${this.deviceName}"`, 'success');
          if (this.gdriveConfig && this.gdriveConfig.connected && this.gdriveConfig.autoSync) {
            this.scheduleAutoSyncToGoogleDrive();
          }
        }
      }

      saveDeviceName() {
        const input = document.getElementById('gdriveDeviceNameInput');
        const name = input?.value.trim();
        if (!name) {
          if (input) input.value = this.deviceName;
          this.showToast('⚠️ Please enter a valid device name.', 'warning');
          return;
        }
        this.deviceName = name;
        this.saveLocal('vy_device_name', this.deviceName);
        this.updateGdriveUI();
        this.showToast(`✅ Device name set to: "${this.deviceName}"`, 'success');
        if (this.gdriveConfig && this.gdriveConfig.connected && this.gdriveConfig.autoSync) {
          this.scheduleAutoSyncToGoogleDrive();
        }
      }

      async saveAndTestWebhook() {
        const url = document.getElementById('gdriveScriptUrlInput')?.value.trim();
        if (!url || !url.startsWith('https://')) return alert('Please enter a valid https:// script.google.com URL.');

        this.showToast('Testing Google Apps Script Webhook...', 'info');

        try {
          const sep = url.includes('?') ? '&' : '?';
          const testRes = await fetch(`${url}${sep}action=load&t=${Date.now()}`);
          if (!testRes.ok) {
            throw new Error(`Apps Script responded with HTTP ${testRes.status}. Make sure the script is deployed with "Who has access: Anyone".`);
          }
          const text = await testRes.text();
          if (text && text.trim().startsWith('<')) {
            throw new Error('Script returned HTML login/error page. Ensure "Who has access" is set to "Anyone" in Web App deployment.');
          }

          this.gdriveConfig.scriptUrl = url;
          this.gdriveConfig.mode = 'webhook';
          this.gdriveConfig.connected = true;
          this.gdriveConfig.email = 'Google Apps Script (Cloud)';
          this.cloudSyncError = false;
          this.saveLocal('vy_gdrive_config', this.gdriveConfig);

          await this.pullFromGoogleDrive(false);
          await this.pushToGoogleDrive(false);
          this.updateGdriveUI();
          alert('✅ Successfully connected to Google Drive Apps Script! Multi-device synchronization is now active.');
        } catch (err) {
          console.error(err);
          this.cloudSyncError = true;
          this.gdriveConfig.connected = false;
          this.saveLocal('vy_gdrive_config', this.gdriveConfig);
          this.updateGdriveUI();
          alert('❌ Connection failed!\n\n' + (err.message || err) + '\n\nPlease verify:\n1. The script has not been deleted.\n2. In script.google.com, Deploy -> Web App -> "Who has access: Anyone".\n3. Copy the full /exec Web App URL.');
        }
      }

      copyAppsScriptTemplate() {
        const scriptCode = `// Google Apps Script for Vyaparify Cloud Sync
function doGet(e) {
  var action = (e && e.parameter && e.parameter.action) || 'load';
  var files = DriveApp.getFilesByName('vyaparify_cloud_database.json');
  var content = files.hasNext() ? files.next().getBlob().getDataAsString() : '{}';
  return ContentService.createTextOutput(content).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  var data = JSON.parse(e.postData.contents);
  var files = DriveApp.getFilesByName('vyaparify_cloud_database.json');
  var file = files.hasNext() ? files.next() : DriveApp.createFile('vyaparify_cloud_database.json', '{}');
  if (data.action === 'save') {
    file.setContent(JSON.stringify(data.payload));
    return ContentService.createTextOutput(JSON.stringify({ status: 'success', version: data.payload.syncVersion })).setMimeType(ContentService.MimeType.JSON);
  }
  return ContentService.createTextOutput(file.getBlob().getDataAsString()).setMimeType(ContentService.MimeType.JSON);
}`;
        navigator.clipboard.writeText(scriptCode).then(() => {
          alert('📋 Script code copied to clipboard!\n\nPaste this in https://script.google.com and deploy as a Web App.');
        }).catch(() => {
          prompt('Copy script code:', scriptCode);
        });
      }

      disconnectGoogleAccount() {
        if (!confirm('Disconnect Google Drive sync on this device?')) return;
        this.gdriveConfig.connected = false;
        this.gdriveConfig.scriptUrl = '';
        this.gdriveConfig.token = '';
        this.gdriveConfig.tokenExpires = 0;
        this.gdriveConfig.fileId = null;
        this.gdriveConfig.email = '';
        this.lastCloudSyncTime = '';
        this.cloudSyncError = false;
        this.saveLocal('vy_gdrive_config', this.gdriveConfig);
        const scriptInput = document.getElementById('gdriveScriptUrlInput');
        if (scriptInput) scriptInput.value = '';
        this.updateGdriveUI();
        this.showToast('Google Drive disconnected.', 'info');
      }

      initGoogleAuth() {
        if (!window.google || !window.google.accounts || !window.google.accounts.oauth2) {
          alert('Google Identity Services script is still loading or unavailable offline. Please check your internet connection.');
          return;
        }
        const clientId = (this.gdriveConfig.clientId || '').trim();
        if (!clientId) {
          alert('Please enter your Google OAuth Client ID first. See instructions in the panel, or use Method B (Apps Script Webhook) which requires no client ID.');
          return;
        }

        try {
          const tokenClient = google.accounts.oauth2.initTokenClient({
            client_id: clientId,
            scope: 'https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email',
            callback: async (resp) => {
              if (resp.error) {
                console.error(resp);
                alert('Google Sign-In failed: ' + resp.error);
                return;
              }
              this.gdriveConfig.token = resp.access_token;
              this.gdriveConfig.tokenExpires = Date.now() + (Number(resp.expires_in) || 3600) * 1000;
              this.gdriveConfig.connected = true;
              this.gdriveConfig.mode = 'oauth';
              this.saveLocal('vy_gdrive_config', this.gdriveConfig);

              this.showToast('Fetching Google Profile & Drive files...', 'info');
              await this.fetchGoogleUserInfo();
              await this.findOrCreateDriveFile();
              await this.pullFromGoogleDrive(false);
              this.updateGdriveUI();
              this.showToast('✅ Google Drive connected: ' + this.gdriveConfig.email, 'success');
            }
          });
          tokenClient.requestAccessToken({ prompt: '' });
        } catch (err) {
          console.error(err);
          alert('Could not start Google Sign-In: ' + err.message);
        }
      }

      async fetchGoogleUserInfo() {
        if (!this.gdriveConfig.token) return;
        try {
          const res = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
            headers: { Authorization: `Bearer ${this.gdriveConfig.token}` }
          });
          if (res.ok) {
            const data = await res.json();
            if (data.email) {
              this.gdriveConfig.email = data.email;
              this.saveLocal('vy_gdrive_config', this.gdriveConfig);
            }
          }
        } catch (e) {
          console.error('Error fetching user info:', e);
        }
      }

      async findOrCreateDriveFile() {
        if (!this.gdriveConfig.token) return;
        try {
          const searchRes = await fetch("https://www.googleapis.com/drive/v3/files?q=name='vyaparify_cloud_database.json' and trashed=false&fields=files(id,name,modifiedTime)", {
            headers: { Authorization: `Bearer ${this.gdriveConfig.token}` }
          });
          const data = await searchRes.json();
          if (data.files && data.files.length > 0) {
            this.gdriveConfig.fileId = data.files[0].id;
            this.saveLocal('vy_gdrive_config', this.gdriveConfig);
          } else {
            // Create the file in Google Drive
            const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
              method: 'POST',
              headers: {
                Authorization: `Bearer ${this.gdriveConfig.token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                name: 'vyaparify_cloud_database.json',
                mimeType: 'application/json',
                description: 'Vyaparify Pro Cloud Multi-Device Database'
              })
            });
            const file = await createRes.json();
            if (file.id) {
              this.gdriveConfig.fileId = file.id;
              this.saveLocal('vy_gdrive_config', this.gdriveConfig);
              await this.pushToGoogleDrive(false);
            }
          }
        } catch (err) {
          console.error('Error finding/creating drive file:', err);
        }
      }

      scheduleAutoSyncToGoogleDrive() {
        clearTimeout(this.syncDebounceTimer);
        this.syncDebounceTimer = setTimeout(() => {
          this.pushToGoogleDrive(false);
        }, 1200);
      }

      async pushToGoogleDrive(isManual = false) {
        if (!this.gdriveConfig || !this.gdriveConfig.connected) {
          if (isManual) alert('Google Drive is not connected. Sign in or connect webhook first.');
          return;
        }

        const newVersion = (this.cloudSyncVersion || 0) + 1;
        const nowIso = new Date().toISOString();

        const payload = {
          schemaVersion: 2,
          syncVersion: newVersion,
          lastUpdated: nowIso,
          lastDeviceId: this.deviceId,
          lastDeviceName: this.deviceName,
          shop: this.shop,
          products: this.products,
          customers: this.customers,
          invoices: this.invoices,
          ledger: this.ledger,
          deletedIds: this.deletedIds,
          autoBackups: this.autoBackups.slice(0, 10)
        };

        const pushBtn = document.getElementById('gdrivePushBtn');
        if (pushBtn) pushBtn.innerText = '☁️ Syncing...';

        try {
          if (this.gdriveConfig.mode === 'oauth') {
            if (!this.gdriveConfig.fileId) await this.findOrCreateDriveFile();
            const url = `https://www.googleapis.com/upload/drive/v3/files/${this.gdriveConfig.fileId}?uploadType=media`;
            const res = await fetch(url, {
              method: 'PATCH',
              headers: {
                Authorization: `Bearer ${this.gdriveConfig.token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            });
            if (!res.ok) throw new Error('Drive upload failed: ' + res.status);
          } else if (this.gdriveConfig.mode === 'webhook') {
            if (this.cloudSyncError) {
              throw new Error('Apps Script is unreachable or deleted. Reconnect or click Disconnect.');
            }
            await fetch(this.gdriveConfig.scriptUrl, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'save', payload })
            });
          }

          this.cloudSyncError = false;
          this.cloudSyncVersion = newVersion;
          this.lastCloudSyncTime = nowIso;
          this.saveLocal('vy_cloud_version', this.cloudSyncVersion);
          this.saveLocal('vy_cloud_last_sync', this.lastCloudSyncTime);
          this.updateGdriveUI();
          this.showToast(`☁️ Google Drive synced (v${newVersion}) by ${this.deviceName}`, 'success');
          if (isManual) alert('✅ Successfully pushed all local data to Google Drive!');
        } catch (err) {
          console.error('Push to drive error:', err);
          this.cloudSyncError = true;
          this.updateGdriveUI();
          this.showToast('⚠️ Cloud push failed: ' + err.message, 'warning');
          if (isManual) alert('Failed to push to Google Drive: ' + err.message + '\n\nIf the script was deleted, click Disconnect in Cloud Sync.');
        } finally {
          if (pushBtn) pushBtn.innerText = '☁️ Push to Drive';
        }
      }

      async pullFromGoogleDrive(isManual = false) {
        if (!this.gdriveConfig || !this.gdriveConfig.connected) {
          if (isManual) alert('Google Drive is not connected. Sign in or connect webhook first.');
          return;
        }

        const pullBtn = document.getElementById('gdrivePullBtn');
        if (pullBtn) pullBtn.innerText = '📥 Pulling...';

        try {
          let remoteData = null;
          if (this.gdriveConfig.mode === 'oauth') {
            if (!this.gdriveConfig.fileId) await this.findOrCreateDriveFile();
            const res = await fetch(`https://www.googleapis.com/drive/v3/files/${this.gdriveConfig.fileId}?alt=media`, {
              headers: { Authorization: `Bearer ${this.gdriveConfig.token}` }
            });
            if (res.ok) {
              const text = await res.text();
              remoteData = text ? JSON.parse(text) : null;
            }
          } else if (this.gdriveConfig.mode === 'webhook') {
            const sep = this.gdriveConfig.scriptUrl.includes('?') ? '&' : '?';
            const res = await fetch(`${this.gdriveConfig.scriptUrl}${sep}action=load&t=${Date.now()}`);
            if (!res.ok) {
              throw new Error(`Apps Script responded with HTTP ${res.status}. Script may be deleted, un-deployed, or permissions changed.`);
            }
            const text = await res.text();
            if (text && text.trim().startsWith('<')) {
              throw new Error('Apps Script returned HTML error page. Script was likely deleted or requires login.');
            }
            try {
              remoteData = text ? JSON.parse(text) : null;
            } catch (pErr) {
              throw new Error('Apps Script returned invalid response.');
            }
          }

          this.cloudSyncError = false;
          this.updateGdriveUI();

          if (remoteData && (remoteData.products || remoteData.invoices)) {
            if (!isManual && remoteData.lastUpdated && remoteData.lastUpdated === this.lastCloudSyncTime) {
              return { newInvoices: 0, newLedger: 0 };
            }
            const mergedCount = this.mergeCloudData(remoteData);
            if (isManual) {
              alert(`✅ Pull complete! Multi-device records merged successfully (${mergedCount.newInvoices} new invoices, ${mergedCount.newLedger} new khata entries).`);
            }
          } else if (isManual) {
            alert('Cloud database is currently empty or initializing.');
          }
        } catch (err) {
          console.error('Pull from drive error:', err);
          this.cloudSyncError = true;
          this.updateGdriveUI();
          if (isManual) alert('Could not pull from Google Drive:\n' + err.message + '\n\nIf you deleted your script or project in Google Drive, click "Disconnect" in the Cloud Sync tab.');
        } finally {
          if (pullBtn) pullBtn.innerText = '📥 Pull from Drive';
        }
      }

      mergeCloudData(remoteData) {
        if (!remoteData || typeof remoteData !== 'object') return { newInvoices: 0, newLedger: 0 };

        // Safety backup of current state before cloud merge
        this.saveLocal('vy_pre_merge_backup', {
          shop: this.shop, products: this.products, customers: this.customers, invoices: this.invoices, ledger: this.ledger
        });

        // 0. Merge Deletion Registries (Tombstones) from both devices
        if (remoteData.deletedIds && typeof remoteData.deletedIds === 'object') {
          ['products', 'invoices', 'ledger', 'customers'].forEach(type => {
            if (remoteData.deletedIds[type]) {
              this.deletedIds[type] = Object.assign({}, this.deletedIds[type] || {}, remoteData.deletedIds[type]);
            }
          });
          this.saveLocal('vy_deleted_ids', this.deletedIds);
        }

        let newInvoices = 0;
        let newLedger = 0;

        // 1. Merge Invoices (Unique by id, filtering out deleted ones)
        const invoiceMap = new Map();
        (this.invoices || []).forEach(inv => {
          if (!this.deletedIds.invoices || !this.deletedIds.invoices[String(inv.id)]) {
            invoiceMap.set(String(inv.id), inv);
          }
        });
        (remoteData.invoices || []).forEach(inv => {
          const strId = String(inv.id);
          if (!this.deletedIds.invoices || !this.deletedIds.invoices[strId]) {
            if (!invoiceMap.has(strId)) {
              invoiceMap.set(strId, inv);
              newInvoices++;
            }
          }
        });
        this.invoices = Array.from(invoiceMap.values()).sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));

        // 2. Merge Ledger / Khata entries (Unique by id, filtering out deleted ones)
        const ledgerMap = new Map();
        (this.ledger || []).forEach(l => {
          if (!this.deletedIds.ledger || !this.deletedIds.ledger[String(l.id)]) {
            ledgerMap.set(String(l.id), l);
          }
        });
        (remoteData.ledger || []).forEach(l => {
          const strId = String(l.id);
          if (!this.deletedIds.ledger || !this.deletedIds.ledger[strId]) {
            if (!ledgerMap.has(strId)) {
              ledgerMap.set(strId, l);
              newLedger++;
            }
          }
        });
        this.ledger = Array.from(ledgerMap.values()).sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));

        // 3. Merge Customers (Unique by id, latest updatedAt/createdAt wins, filtering out deleted ones)
        const customerMap = new Map();
        (remoteData.customers || []).forEach(c => {
          if (!this.deletedIds.customers || !this.deletedIds.customers[String(c.id)]) {
            customerMap.set(String(c.id), c);
          }
        });
        (this.customers || []).forEach(c => {
          const strId = String(c.id);
          if (!this.deletedIds.customers || !this.deletedIds.customers[strId]) {
            const existing = customerMap.get(strId);
            if (!existing) {
              customerMap.set(strId, c);
            } else {
              const localTime = new Date(c.updatedAt || c.createdAt || 0).getTime();
              const remoteTime = new Date(existing.updatedAt || existing.createdAt || 0).getTime();
              if (localTime >= remoteTime) customerMap.set(strId, c);
            }
          }
        });
        this.customers = Array.from(customerMap.values());

        // 4. Merge Products (Unique by id, latest updatedAt wins, filtering out deleted ones)
        const productMap = new Map();
        (remoteData.products || []).forEach(p => {
          if (!this.deletedIds.products || !this.deletedIds.products[String(p.id)]) {
            productMap.set(String(p.id), p);
          }
        });
        (this.products || []).forEach(p => {
          const strId = String(p.id);
          if (!this.deletedIds.products || !this.deletedIds.products[strId]) {
            const existing = productMap.get(strId);
            if (!existing) {
              productMap.set(strId, p);
            } else {
              const localTime = new Date(p.updatedAt || 0).getTime();
              const remoteTime = new Date(existing.updatedAt || 0).getTime();
              if (localTime >= remoteTime) productMap.set(strId, p);
            }
          }
        });
        this.products = Array.from(productMap.values());

        // 5. Update Shop if remote was updated more recently
        if (remoteData.shop && remoteData.lastUpdated) {
          const remoteTime = new Date(remoteData.lastUpdated).getTime();
          const localTime = new Date(this.lastCloudSyncTime || 0).getTime();
          if (remoteTime > localTime) {
            this.shop = remoteData.shop;
          }
        }

        // Update version and timestamps
        if (remoteData.syncVersion) {
          this.cloudSyncVersion = Math.max(this.cloudSyncVersion || 0, Number(remoteData.syncVersion) || 0);
          this.saveLocal('vy_cloud_version', this.cloudSyncVersion);
        }
        if (remoteData.lastUpdated) {
          this.lastCloudSyncTime = remoteData.lastUpdated;
          this.saveLocal('vy_cloud_last_sync', this.lastCloudSyncTime);
        }

        // Persist locally
        this.saveLocal('vy_shop', this.shop);
        this.saveLocal('vy_products', this.products);
        this.saveLocal('vy_customers', this.customers);
        this.saveLocal('vy_invoices', this.invoices);
        this.saveLocal('vy_ledger', this.ledger);
        this.saveLocal('vy_deleted_ids', this.deletedIds);

        // Refresh UI components without re-triggering initAsync / checkRemoteChanges
        this.syncShopHeader();
        this.renderDashboard();
        this.renderInventory();
        this.renderInvoices();
        this.renderLedger();
        this.renderCustomers();
        this.renderPosProducts();
        this.updateGdriveUI();
        this.updateSecurityUI();

        // Only display toast if new updates were received from another device
        if ((newInvoices > 0 || newLedger > 0) && remoteData.lastDeviceName && remoteData.lastDeviceId !== this.deviceId) {
          const detail = [];
          if (newInvoices > 0) detail.push(`${newInvoices} invoice${newInvoices > 1 ? 's' : ''}`);
          if (newLedger > 0) detail.push(`${newLedger} khata entr${newLedger > 1 ? 'ies' : 'y'}`);
          this.showToast(`☁️ Cloud Sync: Received ${detail.join(' & ')} from ${remoteData.lastDeviceName}!`, 'info');
        }

        return { newInvoices, newLedger };
      }

      async checkRemoteChanges() {
        if (!this.gdriveConfig || !this.gdriveConfig.connected || this.isCheckingRemote) return;
        this.isCheckingRemote = true;
        try {
          if (this.gdriveConfig.mode === 'oauth') {
            if (!this.gdriveConfig.fileId) return;
            const res = await fetch(`https://www.googleapis.com/drive/v3/files/${this.gdriveConfig.fileId}?fields=modifiedTime,version`, {
              headers: { Authorization: `Bearer ${this.gdriveConfig.token}` }
            });
            if (res.ok) {
              const meta = await res.json();
              if (meta.modifiedTime && meta.modifiedTime !== this.lastCloudSyncTime) {
                await this.pullFromGoogleDrive(false);
              }
            }
          } else if (this.gdriveConfig.mode === 'webhook') {
            await this.pullFromGoogleDrive(false);
          }
        } catch (e) {
          // Silent background check failure
        } finally {
          this.isCheckingRemote = false;
        }
      }

      // ==========================================================
      // 04. MANUAL BACKUP & AUTO BACKUP SYSTEM
      // ==========================================================

      async downloadBackup() {
        this.requestSecurityAuthorization('Export Database Backup', async () => {
          const coreData = {
            shop: this.shop,
            products: this.products,
            customers: this.customers,
            invoices: this.invoices,
            ledger: this.ledger,
            deletedIds: this.deletedIds,
            emailSettings: this.emailSettings,
            autoBackups: this.autoBackups
          };
          const checksum = await this.hashPin(JSON.stringify(coreData));
          const payload = {
            appName: 'Vyaparify Pro',
            version: '2.5.0',
            exportedAt: new Date().toISOString(),
            exportedByDevice: this.deviceName,
            integrityChecksum: checksum,
            ...coreData
          };
          const dateStr = new Date().toISOString().split('T')[0];
          const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = `Vyaparify_Secure_Backup_${dateStr}.json`;
          a.click();
          this.showToast('🛡️ Secure backup downloaded with integrity checksum!', 'success');
        });
      }

      handleBackupFileUpload(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = async (e) => {
          try {
            const data = JSON.parse(e.target.result);
            if (!data || typeof data !== 'object') throw new Error('File does not contain valid JSON.');

            // Verify integrity checksum if present
            if (data.integrityChecksum) {
              const coreData = {
                shop: data.shop || {},
                products: data.products || [],
                customers: data.customers || [],
                invoices: data.invoices || [],
                ledger: data.ledger || [],
                emailSettings: data.emailSettings || {},
                autoBackups: data.autoBackups || []
              };
              const calcChecksum = await this.hashPin(JSON.stringify(coreData));
              if (calcChecksum !== data.integrityChecksum) {
                if (!confirm('⚠️ WARNING: Backup integrity checksum verification failed!\nThe file content may have been tampered with or corrupted.\n\nDo you still want to proceed with restore?')) {
                  event.target.value = '';
                  return;
                }
              }
            }

            const prodCount = (data.products || []).length;
            const invCount = (data.invoices || []).length;
            const custCount = (data.customers || []).length;
            const ledCount = (data.ledger || []).length;

            const confirmMsg = `Restore Backup File:\n\n` +
              `• Products: ${prodCount}\n` +
              `• Invoices: ${invCount}\n` +
              `• Customers: ${custCount}\n` +
              `• Khata Entries: ${ledCount}\n` +
              `${data.integrityChecksum ? '• Integrity Checksum: ✅ Verified Valid\n' : ''}\n` +
              `A safety auto-snapshot of your current data will be saved before restoring.\n` +
              `Do you want to proceed and restore this backup?`;

            if (confirm(confirmMsg)) {
              await this.takeAutoBackupSnapshot('Pre-File-Restore');

              if (data.shop) this.shop = data.shop;
              if (Array.isArray(data.products)) this.products = data.products;
              if (Array.isArray(data.customers)) this.customers = data.customers;
              if (Array.isArray(data.invoices)) this.invoices = data.invoices;
              if (Array.isArray(data.ledger)) this.ledger = data.ledger;
              if (data.deletedIds) this.deletedIds = data.deletedIds;
              if (data.emailSettings) this.emailSettings = data.emailSettings;

              await this.persistAllData();
              this.initAsync();
              this.showToast('✅ Backup restored with integrity verified!', 'success');
              alert('✅ Backup file restored successfully!');
            }
          } catch (err) {
            alert('Error parsing backup file: ' + err.message);
          }
          event.target.value = '';
        };
        reader.readAsText(file);
      }

      async takeAutoBackupSnapshot(customSlot = null) {
        const now = new Date();
        const dateStr = now.toISOString().split('T')[0];
        const slot = customSlot || (now.getHours() < 14 ? 'Morning' : 'Evening');
        const snapshotId = `${dateStr}-${slot}-${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }).replace(/:/g, '')}`;

        const snapshotData = {
          id: snapshotId,
          timestamp: now.toISOString(),
          slot: slot,
          data: {
            shop: JSON.parse(JSON.stringify(this.shop)),
            products: JSON.parse(JSON.stringify(this.products)),
            customers: JSON.parse(JSON.stringify(this.customers)),
            invoices: JSON.parse(JSON.stringify(this.invoices)),
            ledger: JSON.parse(JSON.stringify(this.ledger))
          }
        };

        this.autoBackups.unshift(snapshotData);
        if (this.autoBackups.length > 20) this.autoBackups.pop();
        await this.persistAllData();
        this.renderAutoBackupList();
        return snapshotId;
      }

      async takeManualSnapshotNow() {
        const id = await this.takeAutoBackupSnapshot('Manual-Snapshot');
        this.showToast(`📸 Snapshot "${id}" saved successfully!`, 'success');
      }

      async restoreSnapshotById(snapshotId) {
        const snap = this.autoBackups.find(b => b.id === snapshotId);
        if (!snap || !snap.data) return alert('Snapshot data not found.');

        if (!confirm(`Restore snapshot "${snapshotId}" (${this.formatDateTime(snap.timestamp)})?\nCurrent data will be replaced.`)) return;

        await this.takeAutoBackupSnapshot('Pre-Snapshot-Restore');
        const d = snap.data;
        if (d.shop) this.shop = d.shop;
        if (Array.isArray(d.products)) this.products = d.products;
        if (Array.isArray(d.customers)) this.customers = d.customers;
        if (Array.isArray(d.invoices)) this.invoices = d.invoices;
        if (Array.isArray(d.ledger)) this.ledger = d.ledger;

        await this.persistAllData();
        this.initAsync();
        alert(`✅ Restored snapshot ${snapshotId}!`);
      }

      downloadSnapshotById(snapshotId) {
        const snap = this.autoBackups.find(b => b.id === snapshotId);
        if (!snap || !snap.data) return;
        const blob = new Blob([JSON.stringify(snap.data, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `Snapshot_${snapshotId}.json`;
        a.click();
      }

      renderAutoBackupList() {
        const container = document.getElementById('autoBackupList');
        if (!container) return;
        container.innerHTML = '';

        if (!this.autoBackups.length) {
          container.innerHTML = `<div style="text-align:center; color:var(--slate-400); padding:16px; font-size:12px;">No auto snapshots recorded yet.</div>`;
          return;
        }

        this.autoBackups.forEach(b => {
          const countInfo = b.data ? `${(b.data.invoices || []).length} inv • ${(b.data.products || []).length} prod` : '';
          container.innerHTML += `
            <div style="display:flex; justify-content:space-between; align-items:center; background:var(--slate-50); padding:8px 10px; font-size:12px; border:1px solid var(--slate-200); border-radius:8px; gap:8px; flex-wrap:wrap;">
              <div>
                <strong style="color:var(--slate-800);">${b.id}</strong>
                <span style="font-size:11px; color:var(--slate-500); margin-left:6px;">(${countInfo})</span>
                <br><small style="color:var(--slate-500);">${this.formatDateTime(b.timestamp)}</small>
              </div>
              <div style="display:flex; gap:6px;">
                <button class="btn btn-light" style="padding:4px 8px; font-size:11px;" onclick="app.downloadSnapshotById('${b.id}')" title="Download JSON">📥</button>
                <button class="btn btn-primary" style="padding:4px 8px; font-size:11px;" onclick="app.restoreSnapshotById('${b.id}')">🔄 Restore</button>
              </div>
            </div>
          `;
        });
      }

      showToast(message, type = 'info') {
        let toast = document.getElementById('appToast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'appToast';
          document.body.appendChild(toast);
        }
        const colors = {
          info: 'linear-gradient(135deg, #4f46e5, #4338ca)',
          success: 'linear-gradient(135deg, #059669, #047857)',
          warning: 'linear-gradient(135deg, #d97706, #b45309)',
          danger: 'linear-gradient(135deg, #dc2626, #b91c1c)'
        };
        toast.style.background = colors[type] || colors.info;
        toast.innerHTML = `
          <div class="toast-content">${message}</div>
          <button type="button" class="toast-close-btn" onclick="app.hideToast(event)" title="Dismiss">✕</button>
        `;
        toast.classList.add('toast-visible');

        clearTimeout(this.toastTimer);
        this.toastTimer = setTimeout(() => {
          this.hideToast();
        }, 4500);
      }

      hideToast(event) {
        if (event && event.stopPropagation) event.stopPropagation();
        clearTimeout(this.toastTimer);
        const toast = document.getElementById('appToast');
        if (toast) {
          toast.classList.remove('toast-visible');
        }
      }

      renderDashboard() {
        const todayStr = new Date().toISOString().split('T')[0];
        const todaySales = this.invoices.filter(i => (i.date || '').startsWith(todayStr)).reduce((s, i) => s + (Number(i.total) || 0), 0);
        document.getElementById('dashTodaySales').innerText = `₹${todaySales.toFixed(2)}`;
        document.getElementById('dashTotalDue').innerText = `₹${this.customers.reduce((s, c) => s + Math.max(0, this.getCustomerDue(c.id)), 0).toFixed(2)}`;
        document.getElementById('dashLowStock').innerText = this.products.filter(p => Number(p.stock || 0) <= 5).length;
        document.getElementById('dashTotalInvoices').innerText = this.invoices.length;
      }

      closeModals() { document.querySelectorAll('.modal-backdrop').forEach(m => m.classList.remove('active')); }
    }

    const app = new BusinessEngine();
  </script>
</body>
</html>